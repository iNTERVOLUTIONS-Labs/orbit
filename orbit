cat <<EOF
  usage: orbit new [options]       ${D}(with no options, it asks one by one)${R}

    --repo <url>         Git repository (https or git@)
    --name <name>        Short name for the app
    --domain <domain>    Main domain, without https://
    --branch <branch>    Branch to deploy
    --aliases "<a b>"    Extra domains, space separated
    --email <address>    Address for Let's Encrypt notices

  ${B}These override the automatic detection${R}
    --type static|next|node|go|bun|deno|php|laravel|python
    --build <command>    Build command ("" for none)
    --start <command>    Start command
    --outdir <folder>    Folder with the already-built files
    --appdir <folder>    Subfolder inside a monorepo
    --spa yes|no         Serve index.html on any route
    --php yes|no         Run any .php inside (detected on its own)
    --docroot <folder>   Docroot of a PHP app

    --db                 Create its PostgreSQL database too
