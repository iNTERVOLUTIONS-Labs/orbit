# ═══════════════════════════════════════════════════════ router ═══════════
main() {
  # Las banderas globales van delante del comando y en cualquier orden.
  #
  #   --json  salida legible por máquina. Rechazarlo en los comandos que no lo
  #           hablan es deliberado: ignorarlo en silencio le haría creer a un
  #           cliente que la salida que va a leer es JSON.
  #   --eva   modo EVA (Extra-Vehicular Activity): salir de la nave sin
  #           asideros. Orbit a secas decide por ti y pregunta lo justo; con
  #           --eva no decide nada solo y te deja escribir el comando que
  #           quieras en cada paso. '--jedimaster' hace lo mismo, porque así se
  #           pidió y la memoria muscular manda.
  #   --lang  el idioma, sólo para esta orden.
  #
  # Una bandera mal escrita no se puede contar todavía: el catálogo se carga
  # unas líneas más abajo y el aviso saldría en el idioma que no es. Se apunta
  # y se cuenta después, que es cuando ya hay palabras.
  local lang_bad=""
  while true; do
    case "${1:-}" in
      --json) JSON="yes"; shift ;;
      --eva|--jedimaster|--jedi) EVA="yes"; shift ;;
      --lang|--idioma)
        [[ -n "${2-}" ]] || LANG_MISSING="yes"
        ORBIT_LANG_FLAG="${2-}"; shift; shift || true ;;
      --lang=*|--idioma=*) ORBIT_LANG_FLAG="${1#*=}"; shift ;;
      *) break ;;
    esac
  done
  local cmd="${1:-menu}"; shift || true
  # --lang también detrás del comando, como --json, y por el mismo motivo:
  # nadie recuerda que una bandera sólo vale en una posición. En 'exec' no se
  # toca, porque ahí los argumentos son la orden de otro y un --lang es suyo.
  case "$cmd" in
    exec|run) : ;;
    *) _lang_strip "$@"; set -- "${LANG_ARGS[@]}" ;;
  esac
  # Ya se sabe todo lo que puede decidir el idioma: se decide y se carga el
  # catálogo. A partir de aquí cualquier mensaje sale traducido, incluido el
  # que va a protestar por un --lang que no existe.
  if [[ -n "$ORBIT_LANG_FLAG" ]] && ! _lang_supported "$(_lang_norm "$ORBIT_LANG_FLAG")"; then
    lang_bad="$ORBIT_LANG_FLAG"
  fi
  _lang_resolve
  _i18n_load
  [[ "$LANG_MISSING" == "yes" ]] && die "«--lang» necesita un idioma detrás. Son: %s." "$ORBIT_LANGS"
  [[ -z "$lang_bad" ]] || die "No hablo «%s». Los idiomas de Orbit son: %s." "$lang_bad" "$ORBIT_LANGS"
  if _json_capable "$cmd"; then
    _json_strip "$@"; set -- "${JSON_ARGS[@]}"
  elif [[ "$JSON" == "yes" ]]; then
    die "'orbit %s' no tiene salida JSON. La tienen: %s." "$cmd" "$(_json_cmds_help)"
  fi
  # A partir de aquí ya se sabe si la salida es para una persona o para una
  # máquina, así que se decide de una vez por dónde sale lo primero y no en
  # cada printf. Ver UI_FD.
  _ui_route
  case "$cmd" in
    menu|"")        menu ;;
    new|create)     cmd_new "$@" ;;
    deploy|up)
      if [[ "${1:-}" == --all || "${1:-}" == --todas ]]; then
        # '--all' tiene su propio contrato porque tiene su propia forma: de cada
        # app sale uno de seis finales, no uno. Estuvo rechazado a propósito
        # mientras no existía —prometer un objeto que no iba a llegar era peor
        # que negarse— y ahora existe. Ver el bloque de _dall_json.
        shift; cmd_deploy_all "$@"
      else
        cmd_deploy "$@"
      fi ;;
    autodeploy)     cmd_autodeploy "$@" ;;
    queue|cola|colas) cmd_queue "$@" ;;
    maintenance|mant) cmd_maintenance "$@" ;;
    clone|copy)     cmd_clone "$@" ;;
    rollback)       cmd_rollback "$@" ;;
    list|ls)        cmd_list ;;
    info|show)      cmd_info "$@" ;;
    top)            cmd_top "$@" ;;
    metrics|metricas|métricas) cmd_metrics "$@" ;;
    traffic|trafico|tráfico) cmd_traffic "$@" ;;
    logs|log)       cmd_logs "$@" ;;
    restart)        cmd_service restart "$@" ;;
    start)          cmd_service start "$@" ;;
    stop)           cmd_service stop "$@" ;;
    env)            cmd_env "$@" ;;
    exec|run)       cmd_exec "$@" ;;
    migrate)        cmd_migrate "$@" ;;
    redirect|redir) cmd_redirect "$@" ;;
    watch)          cmd_watch "$@" ;;
    notify)         cmd_notify "$@" ;;
    port)           cmd_port "$@" ;;
    isolate|aislar) cmd_isolate "$@" ;;
    init)           cmd_init "$@" ;;
    domain|domains) cmd_domain "$@" ;;
    remove|rm|del)  cmd_remove "$@" ;;
    ssl|cert)       cmd_ssl "$@" ;;
    db|database)    cmd_db "$@" ;;
    backup|copia)   cmd_backup "$@" ;;
    restore)        cmd_restore "$@" ;;
    lang|idioma)    cmd_lang "$@" ;;
    github|gh)      cmd_github ;;
    cf-token)       cmd_cf_token ;;
    cf-update)      cmd_cf_update ;;
    firewall|fw)    cmd_firewall "$@" ;;
    nginx-rebuild)  cmd_self_update ;;
    status)         cmd_status ;;
    doctor|check)   cmd_doctor "$@" ;;
    version|-v|--version) cmd_version ;;
    help|-h|--help) usage ;;
    *) err "Comando desconocido: %s" "$cmd"; usage; exit 1 ;;
  esac
}

main "$@"
