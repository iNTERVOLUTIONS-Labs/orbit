cat <<EOF
  uso: orbit new [opciones]        ${D}(sin opciones, pregunta una a una)${R}

    --repo <url>         Repositorio git (https o git@)
    --name <nombre>      Nombre corto de la app
    --domain <dominio>   Dominio principal, sin https://
    --branch <rama>      Rama a desplegar
    --aliases "<a b>"    Dominios extra, separados por espacios
    --email <correo>     Email para los avisos de Let's Encrypt

  ${B}Anulan la detección automática${R}
    --type static|next|node|go|bun|deno|php|laravel|python
    --build <comando>    Comando de compilación ("" para ninguno)
    --start <comando>    Comando de arranque
