# El asistente y los argumentos son el mismo camino: cada bandera es el valor
# por defecto de su pregunta y --yes acepta los valores por defecto sin
# preguntar. Así no hay una rama «no interactiva» aparte que se quede sin
# probar y sin mantener, que es como estas cosas acaban divergiendo.
# ═════════════════════════════════════════════ orbit init ═════════════════
#
# Escribe un orbit.json en el repositorio con lo que la detección ha
# encontrado, para que la configuración viaje con el código en vez de vivir
# sólo en el servidor. Es el reverso exacto de _read_descriptor: si algún día
# se añade una clave allí, aquí es donde hay que ofrecerla.
#
# No necesita root ni que Orbit esté instalado (ver la auto-elevación, arriba):
# se ejecuta dentro de un proyecto, que es justo donde puede no haber ninguna
# de las dos cosas.
cmd_init() { # orbit init [directorio] [--force]
  local dir="" force="no" a
  for a in "$@"; do
    case "$a" in
      -f|--force|--sobrescribir) force="yes" ;;
      -h|--help|help|ayuda)
        printf '%b' "$(t "  uso: orbit init [directorio] [--force]\n\
       Escribe un orbit.json con lo que detecte del proyecto, para que su\n\
       configuración de despliegue viaje con el código.\n\
       --force   reescribe el que ya haya\n")"
        return 0 ;;
      -*) die "orbit init: no entiendo «%s»." "$a" ;;
      *)  [[ -n "$dir" ]] && die "orbit init: sobra «%s»." "$a"; dir="$a" ;;
    esac
  done
  dir="${dir:-.}"
  [[ -d "$dir" ]] || die "«%s» no es un directorio." "$dir"
  local f="$dir/orbit.json"
  # No se pisa nada sin permiso: dentro puede haber un bloque 'env' escrito a
  # mano que la detección no sabe reproducir, y perderlo en silencio sería
  # mucho peor que no escribir el fichero.
  [[ -e "$f" && "$force" != "yes" ]] \
    && die "Ya hay un orbit.json en «%s». Si quieres reescribirlo:  orbit init %s --force" "$dir" "$dir"

  # La detección de siempre, la misma que usa 'orbit new'. Las variables A_*
  # se vacían antes: esta orden puede correr sobre un shell que ya tenga otra
  # app cargada, y un valor heredado acabaría escrito en el repositorio ajeno.
  local k
  for k in "${ORBIT_APP_FIELDS[@]}"; do printf -v "$k" '%s' ""; done
  # Con --force, el descriptor que se va a reescribir no participa en su propia
  # regeneración: ver DETECT_IGNORA_DESC. Se apaga en cuanto termina la
  # detección para no dejar la decisión colgando sobre lo que venga después.
  [[ "$force" == "yes" ]] && DETECT_IGNORA_DESC="$dir"
  detect_stack "$dir"
  DETECT_IGNORA_DESC=""
  [[ -n "$A_TYPE" ]] || die "No he reconocido el proyecto. Dime el tipo a mano en el orbit.json."
  # La rama de repuesto de detect_stack deja 'static' con la raíz como carpeta
  # web. Para un sitio que es HTML eso es correcto —y por eso se escribe—, pero
  # para cualquier otra cosa significa publicar el código fuente. Escribirlo
  # aquí sería **peor** que dejarlo pasar en un despliegue: el descriptor pisa
  # a la detección, así que el aviso de esa rama no volvería a salir nunca y la
  # decisión quedaría congelada en el repositorio sin que nadie la tomara.
  if [[ "$A_TYPE" == "static" && "$A_OUTDIR" == "." && ! -f "$dir/index.html" ]]; then
    err "No he reconocido este proyecto, y no hay un index.html en la raíz."
    info "Escribirlo como estático dejaría el código fuente publicado, y además"
    info "congelaría esa decisión: el orbit.json manda sobre la detección."
    die "Dile qué es, escribiendo el 'type' a mano en el orbit.json."
  fi

  local out="" sep=""
  _ik() { # _ik <clave> <valor>  — sólo lo que tiene valor, y como cadena JSON
    [[ -n "$2" ]] || return 0
    out+="$sep  $(_j_str "$1"): $(_j_str "$2")"; sep=",\n"
  }
  _ib() { # _ib <clave> <si|no> — los booleanos van como booleanos
    [[ "$2" == "yes" ]] || return 0
    out+="$sep  $(_j_str "$1"): true"; sep=",\n"
  }
  _ik type    "$A_TYPE"
  [[ "$A_APPDIR" != "." ]] && _ik appdir "$A_APPDIR"
  _ik build   "$A_BUILD"
  _ik start   "$A_START"
  _ik outdir  "$A_OUTDIR"
  _ib spa     "$A_SPA"
  _ik docroot "$A_DOCROOT"
  _ib php     "$A_PHP"
  unset -f _ik _ib
  printf '{\n%b\n}\n' "$out" > "$f" || die "No he podido escribir en «%s»." "$f"
  chmod 0644 "$f" 2>/dev/null || true

  ok "Escrito %s" "$f"
  info "Tipo detectado: %s" "$A_TYPE"
  # Las dos claves que la detección no puede adivinar, dichas una vez y con
  # nombre: 'shared' es lo que la app escribe en marcha y no puede vivir en una
  # release, y 'env' es lo que hace falta para arrancar. Ver ARCHITECTURE §22.
  info "Puedes añadirle a mano 'shared' (lo que la app escribe) y 'env' (sus variables)."
  info "Revísalo, súbelo al repositorio, y el despliegue lo leerá."
  return 0
}

cmd_new() {
  need_root new

  local repo="" name="" branch="" domain="" aliases="" aliases_set="no" email=""
  local o_type="" o_build="" o_build_set="no" o_start="" o_outdir="" o_appdir=""
  local o_spa="" o_docroot="" o_php="" want_db="n" want_ssl="y"
  # Copia local: --yes vale para esta invocación y para lo que ella llame
  # —deploy, ssl—, y no para el resto de la sesión si se entró por el menú.
  local ASSUME_YES="$ASSUME_YES"
  local a v
  while (( $# )); do
    a="$1"; v="${2-}"
    case "$a" in
      --repo|--name|--domain|--branch|--aliases|--email|--type|--build|--start|--outdir|--appdir|--spa|--docroot|--php)
        [[ $# -ge 2 ]] || die "orbit new: «%s» necesita un valor. Mira 'orbit new --help'." "$a"
        case "$a" in
          --repo)    repo="$v" ;;
          --name)    name="$v" ;;
          --domain)  domain="$v" ;;
          --branch)  branch="$v" ;;
          --aliases) aliases="$v"; aliases_set="yes" ;;
          --email)   email="$v" ;;
          --type)    o_type="$v" ;;
          --build)   o_build="$v"; o_build_set="yes" ;;
          --start)   o_start="$v" ;;
          --outdir)  o_outdir="$v" ;;
          --appdir)  o_appdir="$v" ;;
          --spa)     o_spa="$v" ;;
          --docroot) o_docroot="$v" ;;
          --php)     o_php="$v" ;;
        esac
        shift 2 ;;
      --db)          want_db="y"; shift ;;
      --no-ssl)      want_ssl="n"; shift ;;
      -y|--yes|--si) ASSUME_YES="yes"; shift ;;
      -h|--help|help|ayuda) _new_usage; return 0 ;;
      *) die "orbit new: no entiendo «%s». Mira 'orbit new --help'." "$a" ;;
    esac
  done

  # Se valida antes de clonar: descubrir que el tipo no existe después de
  # bajarse el repositorio y compilarlo es tarde y además deja basura.
  # 'redirect' no está: esas apps las crea 'orbit redirect add', que además
  # rellena el destino. Una aquí nacería sin destino y con un vhost inservible.
  # Esta lista y la de la ayuda tienen que decir lo mismo. Se quedó atrás al
  # añadir los tipos nuevos: '--type laravel' —que es justo lo que teclea quien
  # corrige una detección equivocada— moría con «no es un tipo».
  case "$o_type" in
    ""|static|next|node|go|bun|deno|php|laravel|python) ;;
    *) die "orbit new: «%s» no es un tipo. Son: static, next, node, go, bun, deno, php, laravel, python." "$o_type" ;;
  esac
  case "$o_spa" in
    ""|yes|no) ;;
    *) die "orbit new: --spa admite 'yes' o 'no', no «%s»." "$o_spa" ;;
  esac
  case "$o_php" in
    ""|yes|no) ;;
    *) die "orbit new: --php admite 'yes' o 'no', no «%s»." "$o_php" ;;
  esac
  [[ -n "$name" ]] && { _app_name_ok "$name" || die "'%s' no vale como nombre: minúsculas, números, '.', '-' y '_', empezando por letra o número." "$name"; }
  [[ -n "$name" ]] && app_exists "$name" && die "Ya existe una app llamada '%s'" "$name"
  [[ -n "$email" ]] && _conf_set LETSENCRYPT_EMAIL "$email"

  title "Nueva aplicación"

  # --- origen del código
  local default_branch="${branch:-main}"
  if [[ -z "$repo" ]] && _gh_ok; then
    local op_gh op_url src
    op_gh="$(t "Elegir un repo de mi GitHub")"; op_url="$(t "Escribir la URL a mano")"
    src="$(choose "Origen del código" "$op_gh" "$op_url")"
    if [[ "$src" == "$op_gh" ]]; then
      printf "  ${D}%s${R}\n" "$(t "Cargando tus repositorios…")"
      local -a repos
      # La misma lista que devuelve 'orbit github repos'. Una sola función para
      # las dos: cuando se separan, el selector y el contrato acaban contando
      # cosas distintas y nadie lo nota hasta que un cliente enseña un
      # repositorio que este servidor no tiene.
      mapfile -t repos < <(_gh_repos)
      if (( ${#repos[@]} )); then
        local sel; sel="$(choose 'Repositorio' "${repos[@]}")"
        [[ -n "$sel" ]] && repo="https://github.com/$sel.git"
      else
        warn "No pude listar repos, introduce la URL"
      fi
    fi
  else
    warn "GitHub no está conectado (ejecuta 'orbit github' para repos privados)"
  fi
  [[ -z "$repo" ]] && ask repo "URL del repositorio (https o git@)" ""
  [[ -z "$repo" ]] && die "Sin repositorio no hay despliegue. Pásalo con --repo <url>."

  local guess; guess="$(basename "${repo%.git}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' | sed 's/-\+/-/g; s/^-//; s/-$//')"
  ask name "Nombre corto de la app" "${name:-$guess}"
  _app_name_ok "$name" || die "'%s' no vale como nombre: minúsculas, números, '.', '-' y '_', empezando por letra o número." "$name"
  app_exists "$name" && die "Ya existe una app llamada '%s'" "$name"

  # La rama se elige de la lista del remoto en vez de escribirla de memoria.
  # Escribir 'master' en un repo cuya rama es 'main' no da un error claro: da
  # un clon que falla con un mensaje de git que no habla de eso.
  if [[ -z "$branch" && "$ASSUME_YES" != "yes" ]]; then
    local -a ramas=(); mapfile -t ramas < <(_remote_branches "$repo")
    if (( ${#ramas[@]} > 1 )); then
      branch="$(choose "Rama" "${ramas[@]}")"
    elif (( ${#ramas[@]} == 1 )); then
      branch="${ramas[0]}"; info "Rama {b}%s{r} {d}(la única del repositorio){r}" "$branch"
    fi
  fi
  # Sólo se pregunta si el selector no ha dado nada: preguntar después de haber
  # elegido de la lista obliga a confirmar dos veces lo mismo.
  [[ -n "$branch" ]] || ask branch "Rama" "$default_branch"
  ask domain "Dominio principal (sin https://)" "$domain"
  [[ -z "$domain" ]] && die "Necesito un dominio. Pásalo con --domain <dominio>."
  # A un subdominio no se le propone www: nadie escribe www.blog.midominio.com,
  # y pedirle a Let's Encrypt un certificado para un nombre que no está en el
  # DNS puede hacer fallar la emisión de todos los del lote.
  local aliases_def; aliases_def="$(default_alias "$domain")"
  # --aliases '' es una respuesta: significa «ninguno», y no es lo mismo que no
  # haberlo dicho, que es cuando se propone el www.
  [[ "$aliases_set" == "yes" ]] || ask aliases "Dominios extra (separados por espacio)" "$aliases_def"

  # --- clonar para detectar
  local base cache; base="$APPS_DIR/$name"; cache="$base/cache"
  install -d -o "$DEPLOY_USER" -g "$DEPLOY_USER" "$base"
  install -d -o "$(app_user)" -g "$(app_user)" "$base/releases" "$base/shared"
  spin "Clonando el repositorio" \
    sudo -u "$DEPLOY_USER" -H git clone --depth 50 -b "$branch" "$repo" "$cache" \
    || { rm -rf "$base"; die "No pude clonar. Si es privado ejecuta 'orbit github'."; }

  A_NAME="$name"
  # '--appdir' no es un campo más que se pisa al final: dice **dónde está la
  # app**, así que la detección entera se hace ahí dentro. Es lo que hace que un
  # monorepo con dos apps se pueda desplegar como dos apps de Orbit — la segunda
  # con 'orbit new otra --appdir frontend'—, y también lo que permite corregir a
  # mano una subcarpeta mal elegida. Aplicarlo después, como una bandera más,
  # dejaba A_BUILD y A_START apuntando a la raíz del repositorio: la app no
  # compilaba, o peor, compilaba lo que no era.
  if [[ -n "$o_appdir" && "$o_appdir" != "." ]]; then
    _safe_relpath "$o_appdir" \
      || { rm -rf "$base"; die "--appdir: «%s» no es una ruta dentro del repositorio." "$o_appdir"; }
    [[ -d "$cache/$o_appdir" ]] \
      || { rm -rf "$base"; die "--appdir: el repositorio no tiene ninguna carpeta '%s'." "$o_appdir"; }
    detect_stack "$cache" "$o_appdir"
  else
    detect_stack "$cache"
  fi
  # El descriptor ya lo ha leído detect_stack, donde toca: en la carpeta que de
  # verdad se está detectando. Aquí sólo se cuenta, y se dice **dónde** estaba,
  # porque en un monorepo «el repo se declara» sin más deja a alguien buscando
  # un fichero en la raíz que está dos carpetas más abajo.
  if [[ -n "${DESCRIPTOR_EN:-}" ]]; then
    local ddir="${DESCRIPTOR_EN#"$cache"}"; ddir="${ddir#/}"
    if [[ -n "$ddir" ]]; then
      printf "\n  %s\n" "$(t "{cya}{b}%s/orbit.json{r} — la app declara su despliegue; no se infiere nada." "$ddir")"
    else
      printf "\n  %s\n" "$(t "{cya}{b}orbit.json{r} — el repo declara su despliegue; no se infiere nada.")"
    fi
  fi

  # Las banderas mandan sobre lo detectado, y se aplican aquí —antes del
  # resumen— para que lo que se enseña sea lo que se va a guardar. Ponerlas
  # después sería enseñar una cosa y escribir otra.
  [[ -n "$o_type"    ]] && A_TYPE="$o_type"
  [[ "$o_build_set" == "yes" ]] && A_BUILD="$o_build"
  [[ -n "$o_start"   ]] && A_START="$o_start"
  [[ -n "$o_outdir"  ]] && A_OUTDIR="$o_outdir"
  # A_APPDIR no se pisa aquí: '--appdir' ya ha dirigido la detección más arriba.
  # Volver a asignarlo perdería la parte de dentro cuando la subcarpeta lleva a
  # su vez un monorepo de npm — '--appdir sub' sobre un repo con 'sub/apps/web'
  # deja A_APPDIR='sub/apps/web', y esta línea lo devolvía a 'sub'.
  [[ -n "$o_spa"     ]] && A_SPA="$o_spa"
  [[ -n "$o_docroot" ]] && A_DOCROOT="$o_docroot"
  # En Laravel el docroot es public/ y punto. El asistente ya lo fijaba, pero
  # por bandera no: quien corregía a mano un tipo mal detectado se quedaba con
  # el A_DOCROOT vacío que había dejado la rama estática, y eso es nginx
  # sirviendo la raíz del repositorio **y ejecutando** como PHP cualquier .php
  # que haya ahí. Corregir el tipo dejaba la app peor que no corregirlo.
  [[ "$A_TYPE" == "laravel" && -z "$A_DOCROOT" ]] && A_DOCROOT="$(_app_sub public)"
  # 'no' tiene que poder apagar lo detectado, así que se compara con el valor y
  # no con "¿lo han dicho?": A_PHP vacío es el "no".
  [[ -n "$o_php" ]] && { [[ "$o_php" == "yes" ]] && A_PHP="yes" || A_PHP=""; }

  # Forzar un tipo con proceso sobre un repo que se detectó como estático deja
  # A_START vacío, y con él la unidad de systemd lleva un ExecStart vacío que
  # systemd rechaza al arrancar. Se comprueba aquí, antes de escribir nada, y
  # se deshace el clon: media app registrada es peor que ninguna.
  if [[ -n "$o_type" ]] && needs_svc "$A_TYPE" && [[ -z "$A_START" ]]; then
    rm -rf "$base"
    die "El tipo «%s» necesita un comando de arranque: pásalo con --start." "$A_TYPE"
  fi

  printf "\n  %s\n" "$(t "{cya}{b}Detección automática{r}")"
  printf "%s\n" "$(t "    Tipo        {b}%s{r}" "$A_TYPE")"
  printf "%s\n" "$(t "    Gestor      %s" "$A_PKG")"
  printf "%s\n" "$(t "    Build       %s" "${A_BUILD:-$(t "<ninguno>")}")"
  [[ -n "$A_START"  ]] && printf "%s\n" "$(t "    Start       %s" "$A_START")"
  [[ -n "$A_OUTDIR" ]] && printf "%s\n" "$(t "    Carpeta web %s" "$A_OUTDIR")"
  [[ "${A_APPDIR:-.}" != "." ]] && printf "%s\n" "$(t "    Subcarpeta  {b}%s{r}  (monorepo)" "$A_APPDIR")"
  [[ "$A_TYPE" == "static" ]] && printf "%s\n" "$(t "    SPA         %s" "$A_SPA")"
  [[ -n "$A_DOCROOT" ]] && printf "%s\n" "$(t "    Docroot     %s" "$A_DOCROOT")"
  [[ "$A_PHP" == "yes" ]] && printf "%s\n" "$(t "    PHP         {b}sí{r} {d}(los .php se pasan a php-fpm){r}")"
  [[ -n "$A_PYFW"   ]] && printf "%s\n" "$(t "    Framework   %s (%s)" "$A_PYFW" "$A_PYMGR")"
  [[ -n "$A_MIGRATE" ]] && printf "%s\n" "$(t "    Migrar      %s {d}(nunca automático){r}" "$A_MIGRATE")"
  printf "\n"

  # En modo EVA no se pregunta «¿es correcto?»: se pasa por todos los campos.
  # Ese es el trato del modo — Orbit deja de decidir y tú escribes lo que sea.
  local revisar="no"
  if [[ "$EVA" == "yes" ]]; then
    revisar="yes"; printf "  %s\n\n" "$(t "{mag}{b}Modo EVA{r} {d}· fuera de la nave: se pregunta todo{r}")"
  elif ! confirm "¿Es correcto?" y; then
    revisar="yes"
  fi

  if [[ "$revisar" == "yes" ]]; then
    # De dónde se leen los scripts: en un monorepo, del package.json de la app.
    local srcdir="$cache"
    [[ "${A_APPDIR:-.}" != "." ]] && srcdir="$cache/$A_APPDIR"
    local tipo; tipo="$(choose "Tipo de aplicación" static next node go bun deno php laravel python)"
    [[ -n "$tipo" ]] && A_TYPE="$tipo"
    # Aquí es donde se elige entre 'build', 'dev' o 'dev:debug': los nombres se
    # los pone cada proyecto y no hay forma de adivinarlos, así que se enseñan.
    A_BUILD="$(_pick_script "$srcdir" "Comando de build" "$A_BUILD" --vacio)"
    case "$A_TYPE" in
      static) ask A_OUTDIR "Carpeta con los ficheros compilados" "${A_OUTDIR:-dist}"
              confirm "¿Es una SPA (todas las rutas a index.html)?" "${A_SPA:-no}" && A_SPA="yes" || A_SPA="no" ;;
      next|node|bun) A_START="$(_pick_script "$srcdir" "Comando de arranque" "${A_START:-$A_PKG run start}")" ;;
      # Deno no tiene scripts de package.json que enseñar, y sus tareas no
      # sirven de arranque (§18.8), así que se pregunta a secas. El valor por
      # defecto lleva los permisos puestos porque es lo que hay que editar.
      deno)   ask A_START "Comando de arranque" \
                "${A_START:-deno run --allow-net --allow-env --allow-read=. main.ts}" ;;
      # En Go no hay scripts que enseñar —no existe el package.json— así que se
      # pregunta a secas. El build es la parte que de verdad cambia entre
      # proyectos: cuál de los binarios es el servidor.
      go)     ask A_BUILD "Comando de build" "${A_BUILD:-go build -trimpath -o bin/app .}"
              ask A_START "Comando de arranque" "${A_START:-./bin/app}" ;;
      python) ask A_PYAPP "Módulo WSGI/ASGI" "${A_PYAPP:-app:app}"
              if [[ "$A_START" == *uvicorn* ]]; then
                A_START='./.venv/bin/uvicorn --host 127.0.0.1 --port ${PORT} '"$A_PYAPP"
              else
                A_START='./.venv/bin/gunicorn -w 3 -b 127.0.0.1:${PORT} '"$A_PYAPP"
              fi ;;
      php)    ask A_DOCROOT "Docroot dentro del repo" "${A_DOCROOT:-.}" ;;
      # A Laravel no se le pregunta el docroot: es public/ y punto. Preguntarlo
      # sólo abre la puerta a contestar mal.
      laravel) A_DOCROOT="$(_app_sub public)" ;;
    esac
    # Sólo en EVA: lo que en modo sencillo se decide solo y casi nadie toca.
    if [[ "$EVA" == "yes" ]]; then
      [[ "${A_APPDIR:-.}" != "." || -n "$A_OUTDIR" ]] && ask A_APPDIR "Subcarpeta del repo (monorepo; '.' es la raíz)" "${A_APPDIR:-.}"
      # Si aquí ha cambiado la subcarpeta, el docroot de Laravel la sigue: es
      # el public/ **de la app**, no uno en la raíz del repositorio. Sin esto,
      # corregir la subcarpeta a mano dejaba nginx sirviendo un public/ que no
      # existe, y con él la raíz del repositorio a la vista.
      [[ "$A_TYPE" == "laravel" ]] && A_DOCROOT="$(_app_sub public)"
      confirm "¿Servir los .php de este repo con php-fpm?" "${A_PHP:-no}" && A_PHP="yes" || A_PHP=""
    fi
  fi

  A_REPO="$repo"; A_BRANCH="$branch"; A_DOMAIN="$domain"; A_ALIASES="$aliases"
  A_PORT=""; needs_svc "$A_TYPE" && A_PORT="$(free_port)"
  # Aislamiento por app: las nuevas con proceso nacen con su propio usuario
  # (principio 7: lo seguro es lo que sale sin pedirlo). Sólo con proceso: en
  # una estática no corre nada que aislar, y las PHP comparten el pool de
  # php-fpm, así que un usuario propio ahí sería teatro — ver ARCHITECTURE §5.3.
  A_USER=""
  # '_serves_php' y no sólo 'needs_svc': una app PHP es justamente la que más
  # lo necesita —su código lo ejecuta php-fpm, no ella—, y dejarla fuera aquí
  # significaba que nacía compartiendo pool con todas las demás hasta que
  # alguien se acordara de 'orbit isolate'.
  if { needs_svc "$A_TYPE" || _serves_php; } && [[ "${APP_ISOLATION:-yes}" != "no" ]]; then
    A_USER="$(_app_username "$name")"
    _ensure_app_user "$A_USER" "$name"
  fi
  # shellcheck disable=SC2034  # save_app la lee por nombre
  A_CREATED="$(date -Iseconds)"
  save_app
  # Y su pool si ejecuta PHP: el usuario solo no aísla nada ahí (§5.4). Si
  # php-fpm no lo carga no se aborta el alta —la app existe y funcionaría
  # igual en el pool compartido—, pero se dice en voz alta y con el comando
  # para reintentarlo, que es lo contrario de dejarlo pasar en silencio.
  if [[ -n "$A_USER" ]] && _serves_php \
     && ! _php_pool_apply "$name" "$A_USER"; then
    warn "php-fpm no ha cargado el pool de '%s'; de momento comparte el de siempre." "$name"
    info "Cuando lo arregles:  orbit isolate %s" "$name"
  fi
  # Dos mensajes y no uno con un '${A_PORT:+ …}' dentro: ahí había texto —«puerto
  # interno»— escondido en una expansión, donde ningún catálogo lo alcanza.
  if [[ -n "$A_PORT" ]]; then
    ok "App '%s' registrada (puerto interno %s)" "$name" "$A_PORT"
  else
    ok "App '%s' registrada" "$name"
  fi

  # --- base de datos
  if confirm "¿Crear una base de datos PostgreSQL para esta app?" "$want_db"; then
    db_create "$name"
  fi

  # --- variables de entorno
  # Sin --yes, porque abre un editor: sin terminal se quedaría colgado.
  if [[ "$ASSUME_YES" != "yes" ]] && confirm "¿Editar ahora el fichero .env?" n; then
    cmd_env "$name"
  fi

  # El primer despliegue puede fallar por algo que está en el repositorio —un
  # lockfile que no cuadra, un build roto— y eso no lo arregla Orbit. Lo que sí
  # es cosa suya es cómo se sale: hasta ahora el 'die' de cmd_deploy mataba el
  # proceso entero, dejaba la app ya registrada y devolvía al usuario a la
  # shell sin decirle qué había quedado hecho. Parecía que Orbit se había roto
  # al crear la app, cuando el fallo estaba en el código que se le pidió servir.
  #
  # El subshell contiene el 'exit' y permite terminar el asistente contando en
  # qué estado queda todo. La app se deja registrada a propósito: está en
  # nginx, tiene su puerto y su .env, y el arreglo es un 'orbit deploy' cuando
  # el repositorio esté bien. Deshacerlo obligaría a repetir el asistente entero.
  if ! ( cmd_deploy "$name" ); then
    _new_undeployed "$name" "$want_db"
    return 1
  fi

  # --- certificado
  # Let's Encrypt necesita un email y sin terminal no hay a quién pedírselo.
  # Morir aquí dejaría la app creada y desplegada pero el comando en error, así
  # que se avisa y se sigue: el certificado se emite después con 'orbit ssl'.
  #
  # La condición decía sólo '--yes', y por eso no cubría lo que su propio
  # comentario prometía: **sin terminal**. Un 'orbit new --repo … --name …
  # --domain …' lanzado desde un script llegaba hasta aquí, el 'confirm' de
  # abajo se quedaba con su valor por defecto (que es «sí») porque 'read' falla
  # con EOF, y 'cmd_ssl' moría pidiendo un correo que nadie podía teclear. O
  # sea: **la app quedaba creada, desplegada y sirviendo, y el comando salía
  # con 1**. Anunciar un fallo que no ha ocurrido es el mismo pecado que
  # anunciar un éxito que no ha ocurrido, sólo que se nota menos.
  #
  # El '! -t 0' es el patrón que ya usa el rellenado de .env unas líneas más
  # abajo, y el mismo que exige '--yes' en 'doctor --fix --json'.
  if [[ "$want_ssl" == "y" && ( ! -t 0 || "$ASSUME_YES" == "yes" ) && -z "${LETSENCRYPT_EMAIL:-}" ]]; then
    warn "Sin email de Let's Encrypt configurado: no emito el certificado."
    info "Pásalo con --email <correo> o hazlo luego con:  orbit ssl %s" "$name"
  elif confirm "¿Emitir certificado HTTPS de Let's Encrypt ahora?" "$want_ssl"; then
    cmd_ssl "$name"
  else
    info "Podrás hacerlo luego con:  orbit ssl %s" "$name"
  fi
}

# El asistente ha llegado hasta el final pero el código no compila. Lo único
# que hace falta aquí es que nadie se quede adivinando: qué existe ya, qué no,
# y cuál es el siguiente comando. Sin esto, un build fallido en 'orbit new' se
# vive como «Orbit no sabe crear apps».
_new_undeployed() { # _new_undeployed <app> <se-pidió-bd>
  local name="$1" db="${2:-no}"
  # Se distingue de dónde viene el fallo mirando el disco, y no se supone: si
  # hay una release activa, el código compiló y lo que falló fue lo de después
  # —nginx, o el arranque—. Dar el discurso del «arréglalo en tu repositorio»
  # cuando lo que se ha roto es un vhost manda a mirar donde no es.
  local publicado="no" responde="si"
  [[ -L "$(app_dir "$name")/current" ]] && publicado="yes"
  # Y «hay release» tampoco quiere decir «arranca». Con una app con proceso, el
  # symlink se mueve antes del health check, así que una release que compila y
  # se estrella al arrancar deja exactamente el mismo rastro en disco que un
  # vhost roto. Distinguirlas es preguntarle al puerto: si no contesta, lo que
  # se ha roto es el arranque —el código del usuario— y mandarle a 'nginx -t' y
  # a 'orbit doctor' es mandarle donde no está. Salió desplegando en un VPS una
  # rama con un import inexistente.
  # Con '-' y no a pelo: esta función se llama desde el asistente, pero también
  # es la que alguien invoca sin haber cargado la app, y con 'nounset' un A_TYPE
  # sin definir mata la función a mitad del mensaje — deja al usuario con media
  # explicación justo cuando ya le ha fallado el despliegue. Lo cazó la suite.
  if [[ "$publicado" == "yes" ]] && needs_svc "${A_TYPE-}"; then
    health_wait "${A_PORT-}" 1 || responde="no"
  fi
  printf "\n"
  err "La app se ha creado, pero su primer despliegue ha fallado."
  printf "\n  %s\n" "$(t "{b}Lo que ya existe{r}")"
  printf "%s\n" "$(t "    {grn}✓{r} La app '%s' está registrada  {d}(%s){r}" "$name" "$ETC_DIR/apps/$name.conf")"
  printf "%s\n" "$(t "    {grn}✓{r} Su vhost de nginx y su carpeta en %s" "$(app_dir "$name")")"
  [[ "$db" == "y" || "$db" == "yes" ]] && printf "%s\n" "$(t "    {grn}✓{r} Su base de datos PostgreSQL")"
  if [[ "$publicado" == "yes" ]]; then
    printf "%s\n" "$(t "    {grn}✓{r} El código compiló y hay una release activa")"
    printf "%s\n" "$(t "    {red}✗{r} Pero el dominio no la sirve todavía")"
  else
    printf "%s\n" "$(t "    {red}✗{r} Ninguna versión publicada: el dominio todavía no sirve nada")"
  fi
  printf "%s\n" "$(t "    {red}✗{r} Sin certificado HTTPS {d}(no se emite para algo que no sirve){r}")"

  if [[ "$publicado" == "yes" && "$responde" == "no" ]]; then
    printf "\n  %s\n" "$(t "{b}Dónde mirar{r}")"
    printf "%b\n\n" "$(t "    {d}El build fue bien, pero la app no arranca: nadie contesta en su\n    puerto. Lo que falla es el proceso, y el motivo está en su log.{r}")"
    printf "        orbit logs %s\n" "$name"
    printf "        journalctl -u %s -n 50\n" "$(svc_name "$name")"
  elif [[ "$publicado" == "yes" ]]; then
    printf "\n  %s\n" "$(t "{b}Dónde mirar{r}")"
    printf "%b\n\n" "$(t "    {d}El build fue bien y la app responde, así que esto no es tu\n    código: se ha roto algo entre la release y nginx.{r}")"
    printf "        sudo nginx -t\n"
    printf "        orbit doctor\n"
  else
    printf "\n  %s\n" "$(t "{b}Por qué no es cosa del servidor{r}")"
    printf "%b\n\n" "$(t "    {d}El build se ha hecho sobre un clon recién traído de git, en una\n    carpeta nueva. No hay nada heredado de otro despliegue: el mismo\n    commit falla igual en tu máquina y en un servidor recién montado.\n    Compruébalo tú mismo, y verás el mismo error:{r}")"
    printf "        git clone --depth 1 -b %s %s /tmp/comprobar\n" "$A_BRANCH" "$A_REPO"
    printf "        cd /tmp/comprobar && %s\n" "${A_BUILD:-$(t "<el build de tu proyecto>")}"
  fi

  printf "\n  %s\n" "$(t "{b}Cómo seguir{r}")"
  if [[ "$publicado" == "yes" ]]; then
    printf "%s\n\n" "$(t "    Arregla lo que dice el error y vuelve a intentarlo:")"
  else
    printf "%s\n\n" "$(t "    Arregla lo que dice el error {b}en tu repositorio{r}, súbelo, y:")"
  fi
  printf "        orbit deploy %s\n\n" "$name"
  printf "%b\n\n" "$(t "    {d}El asistente no hace falta otra vez: la app ya está puesta.\n    Si prefieres empezar de cero:  orbit remove %s --purge{r}" "$name")"
}

# ═══════════════════════════════════════════════════════ clonar ══════════
# Duplicar una app para montar un staging. Lo interesante no es lo que se
# copia: es lo que no. El certificado, los valores del .env, el puerto, el
# permiso de autodespliegue y las rutas absolutas que llevan el nombre de la
# app original se quedan fuera, porque una copia literal haría que la copia
# escribiese en la base de datos y en las subidas de producción sin decirlo.
# El razonamiento está en ARCHITECTURE §8.4.

# Reescribe una ruta que apunte a la carpeta de la app original. Las rutas
# relativas viven dentro de la release, no llevan el nombre de la app y se
# quedan como están.
_clone_path() { # _clone_path <valor> <origen> <nuevo>
  local v="$1" from="$2" to="$3"
  if [[ "$v" == "$APPS_DIR/$from" || "$v" == "$APPS_DIR/$from/"* ]]; then
    printf '%s%s' "$APPS_DIR/$to" "${v#"$APPS_DIR/$from"}"
  else
    printf '%s' "$v"
  fi
}

# Los nombres sí, los valores no: se conservan comentarios y orden para que el
# fichero siga siendo reconocible, pero cada valor sale vacío.
_clone_env() { # _clone_env <origen> <nuevo> <valores: yes|no>
  local from="$1" to="$2" values="$3" src dst
  src="$(_env_path "$from")"; dst="$(_env_path "$to")"
  if [[ "$values" == "yes" ]]; then
    cp "$src" "$dst"
  else
    sed -E 's/^([[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*)=.*/\1=/' "$src" > "$dst"
  fi
  chown "$(app_user):$(app_user)" "$dst"; chmod 0640 "$dst"
}

cmd_clone() {
  need_root clone
  local from="" to="" domain="" branch="" values="no"
  local -a pos=()
  while (( $# )); do
    case "$1" in
      --domain|--dominio)     domain="${2:-}"; shift ;;
      --domain=*|--dominio=*)  domain="${1#*=}" ;;
      --branch|--rama)        branch="${2:-}"; shift ;;
      --branch=*|--rama=*)     branch="${1#*=}" ;;
      --with-env|--con-env)   values="yes" ;;
      -*) die "Opción desconocida: %s" "$1" ;;
      *)  pos+=("$1") ;;
    esac
    shift
  done
  from="${pos[0]:-}"; to="${pos[1]:-}"

  # ── todo lo que puede fallar, antes de escribir nada
  [[ -n "$from" ]] || from="$(pick_app 'App a clonar')" || return 0
  app_exists "$from" || die "La app '%s' no existe. Mira 'orbit list'." "$from"
  load_app "$from"
  [[ "$A_TYPE" == "redirect" ]] \
    && die "'%s' sólo redirige un dominio a otro; no hay nada que clonar. Para otra redirección:  orbit redirect add <viejo.com> <destino>" "$from"
  local origin_domain="$A_DOMAIN"

  [[ -n "$to" ]] || ask to "Nombre de la copia" "staging-$from"
  [[ -n "$to" ]] || die "Sin nombre no hay copia"
  _app_name_ok "$to" || die "'%s' no vale como nombre: minúsculas, números, '.', '-' y '_', empezando por letra o número." "$to"
  app_exists "$to" && die "Ya existe una app llamada '%s'" "$to"

  [[ -n "$domain" ]] || ask domain "Dominio de la copia" "staging.$origin_domain"
  [[ -n "$domain" ]] || die "Necesito un dominio para la copia"
  [[ "$domain" == "$origin_domain" ]] && die "La copia necesita un dominio distinto del original."
  local owner; owner="$(domain_owner "$domain")"
  [[ -n "$owner" ]] && die "El dominio '%s' ya lo sirve la app '%s'" "$domain" "$owner"

  title "Clonando «%s» → «%s»" "$from" "$to"
  local base="$APPS_DIR/$to"
  install -d -o "$DEPLOY_USER" -g "$DEPLOY_USER" "$base"
  install -d -o "$(app_user)" -g "$(app_user)" "$base/releases" "$base/shared"

  # ── la configuración: se hereda todo menos lo que identifica al original
  A_NAME="$to"
  A_DOMAIN="$domain"
  A_ALIASES=""                                    # los alias son del original
  [[ -n "$branch" ]] && A_BRANCH="$branch"
  A_PORT=""; needs_svc "$A_TYPE" && A_PORT="$(free_port)"
  # El usuario tampoco se hereda: compartirlo dejaría al staging leer el .env
  # de producción, que es exactamente lo que el clon promete no hacer.
  A_USER=""
  if { needs_svc "$A_TYPE" || _serves_php; } && [[ "${APP_ISOLATION:-yes}" != "no" ]]; then
    A_USER="$(_app_username "$to")"
    _ensure_app_user "$A_USER" "$to"
  fi
  A_STATIC_ROOT="$(_clone_path "$A_STATIC_ROOT" "$from" "$to")"
  A_MEDIA_ROOT="$(_clone_path "$A_MEDIA_ROOT" "$from" "$to")"
  # Desplegarse sola es un permiso, y los permisos no se heredan. Procesar la
  # cola tampoco: un staging que vacía la cola manda de verdad los correos que
  # encuentre, y quien clona una app espera una copia mirando, no trabajando.
  A_AUTODEPLOY="no"; A_AUTOFAIL=""; A_QUEUE="no"
  A_LASTDEPLOY=""
  # shellcheck disable=SC2034  # save_app la lee por nombre
  A_CREATED="$(date -Iseconds)"
  save_app
  # Y su pool si ejecuta PHP: el usuario solo no aísla nada ahí (§5.4). Si
  # php-fpm no lo carga no se aborta el alta —la app existe y funcionaría
  # igual en el pool compartido—, pero se dice en voz alta y con el comando
  # para reintentarlo, que es lo contrario de dejarlo pasar en silencio.
  if [[ -n "$A_USER" ]] && _serves_php \
     && ! _php_pool_apply "$to" "$A_USER"; then
    warn "php-fpm no ha cargado el pool de '%s'; de momento comparte el de siempre." "$to"
    info "Cuando lo arregles:  orbit isolate %s" "$to"
  fi

  _clone_env "$from" "$to" "$values"
  # La página de mantenimiento es parte del aspecto de la app y se copia; el
  # testigo y el motivo son estado del original y no.
  [[ -f "$(maint_page "$from")" ]] \
    && install -o "$(app_user)" -g "$(app_user)" -m 0644 "$(maint_page "$from")" "$(maint_page "$to")"
  [[ -f "$(redir_file "$from")" ]] && cp "$(redir_file "$from")" "$(redir_file "$to")"

  # Todavía no hay release. Sin esto el dominio contestaría 502, o el listado
  # de un directorio vacío; con el mantenimiento puesto dice la verdad.
  _maint_on "$to" "$(t "Copia recién creada de %s: todavía no se ha desplegado." "$from")"

  if ! render_nginx "$to"; then
    rm -f "$(nginx_file "$to")" "$(nginx_link "$to")" \
          "$(app_conf "$to")" "$(redir_file "$to")"
    rm -rf "$base"
    nginx -t >/dev/null 2>&1 && systemctl reload nginx
    die "nginx ha rechazado el vhost de la copia. No se ha creado nada."
  fi
  logline "clone $from $to"

  ok "«%s» creada a partir de «%s»" "$to" "$from"
  printf "%s\n" "$(t "    Dominio     %s" "$A_DOMAIN")"
  printf "%s\n" "$(t "    Rama        %s" "$A_BRANCH")"
  [[ -n "$A_PORT" ]] && printf "%s\n" "$(t "    Puerto      %s {d}(nuevo, el del original sigue siendo suyo){r}" "$A_PORT")"
  echo
  info "Sin copiar, a propósito: el certificado, los dominios extra y el despliegue automático."
  [[ "$values" == "yes" ]] || info "Del .env están los nombres, vacíos: los valores apuntaban a producción."

  local p
  for p in "$A_STATIC_ROOT" "$A_MEDIA_ROOT"; do
    [[ -n "$p" && "$p" == /* && "$p" != "$APPS_DIR/$to"* ]] \
      && warn "«%s» es una ruta absoluta fuera de la copia: las dos apps escribirán ahí." "$p"
  done
  if [[ "$values" == "yes" ]]; then
    warn "Has copiado los valores del .env. Si apuntan a la base de datos o al"
    warn "almacenamiento de producción, la copia escribirá ahí. Revísalo antes de desplegar."
  fi

  echo
  info "Ahora:"
  [[ "$values" == "yes" ]] || info "  orbit env %s              rellena los valores" "$to"
  grep -qiE '^[[:space:]]*(export[[:space:]]+)?(DATABASE_URL|DB_|POSTGRES_)' "$(_env_path "$to")" 2>/dev/null \
    && info "  orbit db create %s        {d}(el .env menciona una base de datos){r}" "$to"
  info "  orbit deploy %s" "$to"
  info "  orbit maintenance off %s  {d}(hasta entonces sirve la página de aviso){r}" "$to"
  info "  orbit ssl %s" "$to"
  echo
}

# ═══════════════════════════════════════════════════════════ ssl ══════════
cmd_ssl() {
  need_root ssl
  local name="${1:-}"
  [[ -n "$name" ]] || name="$(pick_app 'App')" || return 0
  load_app "$name"
  title "Certificado HTTPS para %s" "$A_DOMAIN"

  if [[ -z "${LETSENCRYPT_EMAIL:-}" ]]; then
    local mail; ask mail "Email para avisos de Let's Encrypt" ""
    [[ -z "$mail" ]] && die "Let's Encrypt necesita un email"
    sed -i "s|^LETSENCRYPT_EMAIL=.*|LETSENCRYPT_EMAIL=\"$mail\"|" "$CONF_FILE"
    LETSENCRYPT_EMAIL="$mail"
  fi

  local domains=(-d "$A_DOMAIN"); local a
  for a in $A_ALIASES; do domains+=(-d "$a"); done

  local method
  if [[ -f "$ETC_DIR/cloudflare.ini" ]]; then
    method="dns"
    info "Usando la API de Cloudflare (funciona con el proxy naranja activado)"
  else
    method="webroot"
    warn "Sin token de Cloudflare. Usaré validación HTTP."
    warn "En Cloudflare pon el registro en 'DNS only' (nube gris) mientras se emite,"
    warn "o ejecuta 'orbit cf-token' para el método por DNS (recomendado)."
    confirm "¿Continuar con validación HTTP?" y || return 0
  fi

  local rc=0
  if [[ "$method" == "dns" ]]; then
    certbot certonly --dns-cloudflare \
      --dns-cloudflare-credentials "$ETC_DIR/cloudflare.ini" \
      --dns-cloudflare-propagation-seconds 30 \
      "${domains[@]}" --non-interactive --agree-tos -m "$LETSENCRYPT_EMAIL" \
      --key-type ecdsa --cert-name "$A_DOMAIN" || rc=$?
  else
    certbot certonly --webroot -w "$ACME_DIR" \
      "${domains[@]}" --non-interactive --agree-tos -m "$LETSENCRYPT_EMAIL" \
      --key-type ecdsa --cert-name "$A_DOMAIN" || rc=$?
  fi

  if (( rc != 0 )); then
    err "Certbot ha fallado. Revisa que el DNS apunte a este servidor."
    return 1
  fi

  render_nginx "$name" || die "nginx rechazó la nueva configuración"
  ok "HTTPS activo en https://%s" "$A_DOMAIN"
  info "En Cloudflare deja el modo SSL/TLS en 'Full (strict)'"
  logline "ssl $name $A_DOMAIN"
}

cmd_cf_token() {
  need_root cf-token
  title "Token de API de Cloudflare"
  case "$ORBIT_LANG_CODE" in
    en) cat <<EOF
  Create the token at:  ${B}https://dash.cloudflare.com/profile/api-tokens${R}
    · Template:    "Edit zone DNS"
    · Permissions: Zone → DNS → Edit
    · Zones:       all of yours (or the ones you want to use here)

EOF
       ;;
    *) cat <<EOF
  Crea el token en:  ${B}https://dash.cloudflare.com/profile/api-tokens${R}
    · Plantilla: "Edit zone DNS"
    · Permisos:  Zone → DNS → Edit
    · Zonas:     todas las tuyas (o las que quieras usar aquí)

EOF
       ;;
  esac
  local tok; ask tok "Pega el token" ""
  [[ -z "$tok" ]] && { warn "Cancelado"; return 0; }
  printf 'dns_cloudflare_api_token = %s\n' "$tok" > "$ETC_DIR/cloudflare.ini"
  chmod 0600 "$ETC_DIR/cloudflare.ini"
  ok "Token guardado en %s/cloudflare.ini (sólo root puede leerlo)" "$ETC_DIR"
}

# ════════════════════════════════════════════════════════ github ══════════
#
# Tres preguntas que este servidor sabe contestar sobre GitHub —quién está
# conectado, qué repositorios tiene y qué ramas tiene uno— y que hasta ahora
# sólo existían **dentro** del selector interactivo de 'orbit new'.
#
# Salen de ahí porque un cliente no puede usar un selector. 'choose' necesita un
# terminal —fzf, o una lista numerada que alguien lee— y con '--yes' ni se llega
# a él, que es justo como invoca 'new' cualquier cliente. La capacidad estaba
# desde el principio; lo que faltaba era el contrato.
#
# Son de SÓLO LECTURA. Conectar sigue siendo 'orbit github' a secas, sigue
# necesitando un navegador y sigue sin poder hacerse desde una ventana: el token
# es de quien lo emite y no tiene por qué pasar por ningún sitio más.

# ¿Hay sesión de gh para el usuario de despliegue?
#
# **La sesión que importa es la del servidor**, no la de quien mira. Es la que
# clona, así que es la única que contesta si un repositorio privado se va a
# poder traer. Un cliente que enseñe la lista de OTRA cuenta está enseñando
# repositorios que este servidor puede no alcanzar.
_gh_ok() { as_deploy "gh auth status" >/dev/null 2>&1; }

# La cuenta conectada, o vacío.
#
# gh cambió la frase en la 2.40 —«account davabe» donde antes decía «as davabe»—
# así que se aceptan las dos. Si algún día dice una tercera, esto devuelve vacío
# en vez de inventarse un nombre: un hueco se ve, un nombre inventado no.
#
# Y sólo la cuenta. Esa misma salida lleva el token enmascarado y las rutas de
# los ficheros de configuración, y nada de eso tiene por qué salir de aquí.
_gh_account() {
  as_deploy "gh auth status" 2>&1 \
    | sed -n 's/.*Logged in to [^ ]* \(account\|as\) \([A-Za-z0-9_-]\{1,39\}\).*/\2/p' \
    | head -1
}

# El separador de los campos de un repositorio: US (0x1f), el que existe para
# esto desde ASCII.
#
# Y no un tabulador, que es lo primero que se prueba. Con `IFS=$'\t'`, bash
# **colapsa los separadores seguidos** porque el tabulador es espacio en blanco:
# un repositorio sin descripción llega con dos tabuladores juntos, se leen como
# uno, y la fecha acaba en el campo de la descripción. Pasó, y la prueba lo
# cuenta. US no es espacio en blanco, así que un campo vacío sigue siendo un
# campo.
GH_SEP=$'\x1f'

# Los repositorios, un campo por columna: nombre, privado, rama, descripción y
# fecha.
#
# En texto y no en JSON aunque gh sepa dar JSON: así lo consume igual el selector
# de 'new' —que sólo quiere la primera columna— y el emisor de abajo, sin que
# haya dos llamadas distintas que puedan quedarse contando cosas distintas.
#
# Los caracteres de control de la descripción se quitan **en el propio jq**. La
# escribe cualquiera, puede traer saltos de línea, y un salto ahí partiría un
# repositorio en dos registros. `[[:cntrl:]]` y no `\u0000-\u001f`: el jq que
# lleva gh dentro es Go, y su motor de expresiones no entiende `\u`.
_gh_campos() { # _gh_campos [tope]
  local tope="${1:-200}"
  local q='.[] | [.nameWithOwner, (.isPrivate|tostring), (.defaultBranchRef.name // ""), ((.description // "") | gsub("[[:cntrl:]]";" ")), .updatedAt] | join("\u001f")'
  as_deploy "gh repo list --limit $tope --json nameWithOwner,isPrivate,defaultBranchRef,description,updatedAt -q '$q'" 2>/dev/null
}

# Sólo los nombres, que es lo que necesita el selector de 'orbit new'. Sin tope
# propio: el selector siempre quiere el de por defecto, y un parámetro que nadie
# pasa es un parámetro que se queda sin probar.
_gh_repos() { _gh_campos | cut -d"$GH_SEP" -f1; }

_github_status() {
  local conectado="no" cuenta=""
  _gh_ok && { conectado="yes"; cuenta="$(_gh_account)"; }
  if [[ "$JSON" == "yes" ]]; then
    printf '{"schema":%s,"connected":%s,"account":%s,"deploy_user":%s}\n' \
      "$JSON_SCHEMA" "$(_j_bool "$conectado")" \
      "$([[ -n "$cuenta" ]] && _j_str "$cuenta" || printf 'null')" \
      "$(_j_str "$DEPLOY_USER")"
    return 0
  fi
  title "GitHub"
  if [[ "$conectado" == "yes" ]]; then
    ok "Conectado como {b}%s{r} {d}(usuario %s){r}" "${cuenta:-?}" "$DEPLOY_USER"
    # Sin nombre reconocido se dice, en vez de callarlo: hay sesión y no sabemos
    # de quién, que no es lo mismo que no haberla.
    [[ -z "$cuenta" ]] && warn "Hay sesión, pero no he sabido leer de quién. Mira 'gh auth status'."
  else
    warn "GitHub no está conectado. Ejecuta 'orbit github' para los repos privados."
  fi
}

_github_repos() {
  local tope="${1:-200}"
  [[ "$tope" =~ ^[0-9]+$ ]] || die "orbit github repos: el tope es un número, no «%s»." "$tope"
  if ! _gh_ok; then
    [[ "$JSON" == "yes" ]] && {
      printf '{"schema":%s,"connected":false,"account":null,"limit":%s,"truncated":false,"repos":[]}\n' \
        "$JSON_SCHEMA" "$tope"
      return 0
    }
    warn "GitHub no está conectado. Ejecuta 'orbit github'."
    return 0
  fi

  local -a lineas=(); mapfile -t lineas < <(_gh_campos "$tope")
  local n="${#lineas[@]}" truncado="no"
  # Han llegado justo los que caben: puede haber más, y eso NO es lo mismo que
  # saber que los hay. Se dice lo que se sabe.
  (( n >= tope )) && truncado="yes"

  if [[ "$JSON" == "yes" ]]; then
    local sep="" l nombre privado rama desc fecha
    printf '{"schema":%s,"connected":true,"account":%s,"limit":%s,"truncated":%s,"repos":[' \
      "$JSON_SCHEMA" "$(_j_str "$(_gh_account)")" "$tope" "$(_j_bool "$truncado")"
    for l in "${lineas[@]}"; do
      IFS="$GH_SEP" read -r nombre privado rama desc fecha <<<"$l"
      [[ -n "$nombre" ]] || continue
      printf '%s{"name_with_owner":%s,"private":%s,"default_branch":%s,"description":%s,"updated_at":%s}' \
        "$sep" "$(_j_str "$nombre")" "$(_j_bool "$privado")" \
        "$([[ -n "$rama" ]] && _j_str "$rama" || printf 'null')" \
        "$([[ -n "$desc" ]] && _j_str "$desc" || printf 'null')" \
        "$([[ -n "$fecha" ]] && _j_str "$fecha" || printf 'null')"
      sep=","
    done
    printf ']}\n'
    return 0
  fi

  title "Repositorios de %s" "$(_gh_account)"
  local l nombre privado rama desc fecha
  for l in "${lineas[@]}"; do
    IFS="$GH_SEP" read -r nombre privado rama desc fecha <<<"$l"
    [[ -n "$nombre" ]] || continue
    printf "  %s%s%s %s%s%s %s\n" "$B" "$nombre" "$R" \
      "$D" "${rama:-sin rama}$([[ "$privado" == "true" ]] && echo " · privado")" "$R" \
      "${desc:0:60}"
  done
  (( n == 0 )) && warn "No he podido listar ninguno."
  [[ "$truncado" == "yes" ]] && info "Son los %s más recientes; puede haber más." "$tope"
}

_github_branches() {
  local url="${1:-}"
  [[ -n "$url" ]] || die "orbit github branches: dime de qué repositorio.  orbit github branches <url>"
  local -a ramas=(); mapfile -t ramas < <(_remote_branches "$url")
  if [[ "$JSON" == "yes" ]]; then
    # La lista puede estar vacía y eso es una respuesta: un repositorio recién
    # creado no tiene ninguna rama, y **no se rellena con «main»** — un cliente
    # que clonara --branch main de un repo vacío fallaría por culpa nuestra.
    printf '{"schema":%s,"repo":%s,"branches":%s}\n' \
      "$JSON_SCHEMA" "$(_j_str "$url")" "$(_j_list "${ramas[@]+"${ramas[@]}"}")"
    return 0
  fi
  title "Ramas de %s" "$url"
  if (( ${#ramas[@]} == 0 )); then
    warn "Ninguna. O el repositorio está vacío, o no se llega a él desde aquí."
    return 0
  fi
  printf '  %s\n' "${ramas[@]}"
}

_github_connect() {
  title "Conectar GitHub"
  if as_deploy "gh auth status" 2>&1 | grep -q "Logged in"; then
    as_deploy "gh auth status" 2>&1 | sed 's/^/  /'
    confirm "¿Volver a autenticar?" n || return 0
  fi
  info "Se abrirá el flujo de GitHub: copia el código y ábrelo en tu navegador."
  as_deploy "gh auth login --hostname github.com --git-protocol https --web"
  as_deploy "gh auth setup-git"
  ok "GitHub conectado para el usuario '%s'" "$DEPLOY_USER"
}

cmd_github() {
  # Root para todos, también los de leer: las tres preguntas se hacen con el gh
  # del usuario de despliegue, y para ser otro usuario hace falta serlo.
  need_root github
  _subcmd github connect noapp "connect|conectar status repos branches|ramas help|-h|--help|ayuda" "$@"
  local sub="$SUBCMD"; set -- "${SUBCMD_ARGS[@]}"
  # Conectar abre un navegador y hace preguntas: no hay objeto que devolver, y
  # fingir que lo hay dejaría a un cliente esperando algo que no llega.
  [[ "$JSON" == "yes" && "$sub" == "connect" ]] \
    && die "--json está en 'orbit github status', 'repos' y 'branches'. Conectar necesita un navegador."
  case "$sub" in
    status)   _github_status ;;
    repos)    _github_repos "${1:-200}" ;;
    branches) _github_branches "${1:-}" ;;
    help)     printf "%s\n" "$(t "  uso: orbit github [connect|status|repos|branches <url>]")" ;;
    *)        _github_connect ;;
  esac
}

# ════════════════════════════════════════════════════════ base datos ══════
db_create() {
  local name="$1"
  local db="${name//-/_}" user="${name//-/_}"
  local pass; pass="$(openssl rand -base64 24 | tr -d '/+=' | head -c 28)"
  if sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname='$user'" | grep -q 1; then
    warn "El rol '%s' ya existe, sólo actualizo la contraseña" "$user"
    sudo -u postgres psql -qc "ALTER ROLE \"$user\" WITH LOGIN PASSWORD '$pass';" >/dev/null
  else
    sudo -u postgres psql -qc "CREATE ROLE \"$user\" WITH LOGIN PASSWORD '$pass';" >/dev/null
  fi
  if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname='$db'" | grep -q 1; then
    sudo -u postgres createdb -O "$user" "$db"
  fi
  sudo -u postgres psql -qc "GRANT ALL PRIVILEGES ON DATABASE \"$db\" TO \"$user\";" >/dev/null
  local url="postgresql://$user:$pass@127.0.0.1:5432/$db"
  local envf="$APPS_DIR/$name/shared/.env"
  # El dueño por nombre: 'orbit db create <app>' llega aquí sin load_app, y
  # app_user() caía a deploy — el .env de una app aislada se quedaba con un
  # dueño que su builder no puede leer (revisión del PR #10).
  local duser; duser="$(app_user_of "$name")"
  install -d -o "$duser" -g "$duser" "$APPS_DIR/$name/shared"
  touch "$envf"; chown "$duser:$duser" "$envf"; chmod 0640 "$envf"
  # Con comillas simples: si la contraseña llevara un '$', las dobles harían
  # que bash lo expandiera al cargar el fichero y la URL llegaría truncada.
  _env_write "$envf" DATABASE_URL "$url"
  # Laravel no lee DATABASE_URL: mira DB_CONNECTION, y su valor por defecto es
  # sqlite. Así que crear la base, anunciarla y dejarlo ahí producía una app que
  # contestaba 500 a todo —«Database file at path […] does not exist»— con un
  # PostgreSQL recién hecho al lado sin usar. Se escriben también las dos
  # variables que Laravel sí entiende. No es meterse en la configuración de
  # nadie: Orbit ya escribe la APP_KEY en este mismo fichero, y aquí acaba de
  # crear la base de datos que estas dos líneas describen.
  if [[ "$(app_type_of "$name")" == "laravel" ]]; then
    _env_write "$envf" DB_CONNECTION "pgsql"
    _env_write "$envf" DB_URL "$url"
    ok "Base de datos '%s' creada · DATABASE_URL, DB_CONNECTION y DB_URL en el .env" "$db"
    return 0
  fi
  ok "Base de datos '%s' creada · DATABASE_URL guardada en el .env de la app" "$db"
}

cmd_db() {
  need_root db
  _subcmd db help noapp "create list shell backup backup-all help|-h|--help" "$@"
  local sub="$SUBCMD"; set -- "${SUBCMD_ARGS[@]}"
  [[ "$JSON" == "yes" && "$sub" != "list" ]] && die "--json sólo está en 'orbit db list'"
  case "$sub" in
    create) db_create "${1:?uso: orbit db create <app>}" ;;
    list)
      if [[ "$JSON" == "yes" ]]; then
        # Consulta propia en vez de '\l': el formato de \l está pensado para
        # leerse, cambia entre versiones de psql y no da el tamaño en bytes.
        local sep="" dbname owner size filas
        # La consulta va a una variable **antes** de imprimir nada, para poder
        # mirar si ha funcionado. Alimentando el bucle directamente, un
        # PostgreSQL apagado daba cero filas y salía '{"databases":[]}' con
        # código 0: no «no he podido preguntar», sino «no hay ninguna». Un
        # script de copias que lea eso concluye que no hay nada que salvar.
        # Sin --json el mismo caso sale con error, y las dos formas tienen que
        # contar lo mismo.
        if ! filas="$(sudo -u postgres psql -tAF'|' -c \
              "SELECT datname, pg_get_userbyid(datdba), pg_database_size(datname)
                 FROM pg_database WHERE NOT datistemplate ORDER BY datname" 2>&1)"; then
          die "No he podido preguntarle a PostgreSQL: %s" "$(printf '%s' "$filas" | grep -v '^$' | tail -1)"
        fi
        printf '{"schema":%s,"databases":[' "$JSON_SCHEMA"
        while IFS='|' read -r dbname owner size; do
          [[ -n "$dbname" ]] || continue
          printf '%s{"name":%s,"owner":%s,"size_bytes":%s}' \
            "$sep" "$(_j_str "$dbname")" "$(_j_str "$owner")" "$(_j_num "$size")"
          sep=","
        done <<<"$filas"
        printf ']}\n'
        return 0
      fi
      title "Bases de datos"
      sudo -u postgres psql -c "\l" | sed 's/^/  /' ;;
    shell)  sudo -u postgres psql "${1:-postgres}" ;;
    backup)
      local n="${1:?uso: orbit db backup <app>}"; local db="${n//-/_}"
      install -d -m 0700 "$BACKUP_DIR"
      local out; out="$BACKUP_DIR/${db}-$(date +%Y%m%d-%H%M%S).sql.gz"
      sudo -u postgres pg_dump "$db" | gzip > "$out"
      ok "Copia guardada en %s" "$out" ;;
    backup-all)
      install -d -m 0700 "$BACKUP_DIR"
      local d
      for d in $(sudo -u postgres psql -tAc "SELECT datname FROM pg_database WHERE datistemplate=false AND datname NOT IN ('postgres')"); do
        sudo -u postgres pg_dump "$d" | gzip > "$BACKUP_DIR/${d}-$(date +%Y%m%d).sql.gz"
      done
      find "$BACKUP_DIR" -name '*.sql.gz' -mtime "+$BACKUP_KEEP" -delete
      echo "backup-all ok $(date -Iseconds)" ;;
    help)
      case "$ORBIT_LANG_CODE" in
        en) cat <<EOF
  orbit db create <app>     Creates role + database and writes it into the .env
  orbit db list             Lists the databases
  orbit db shell [db]       Opens psql
  orbit db backup <app>     Compressed backup
EOF
           ;;
        *) cat <<EOF
  orbit db create <app>     Crea rol + base de datos y la escribe en el .env
  orbit db list             Lista las bases de datos
  orbit db shell [db]       Abre psql
  orbit db backup <app>     Copia de seguridad comprimida
EOF
           ;;
      esac ;;
  esac
}

# ═══════════════════════════════════════════════ copias de seguridad ══════
# Hasta ahora sólo se copiaban las bases de datos, y eso deja fuera lo único
# que de verdad no se puede recuperar de ninguna otra parte: el `.env`.
#
# **El código no se copia, y es deliberado.** Está en git, que es la copia de
# seguridad del código y está mejor hecha que cualquier cosa que pudiera hacer
# Orbit. Lo que no está en git es exactamente lo que se guarda aquí: los
# secretos, lo que han subido tus usuarios, la configuración de la app y su
# base de datos. Restaurar es dejar todo eso en su sitio y desplegar.
#
# Formato: un tar.gz por app, que se lee con 'tar tzf' sin necesitar a Orbit.
#
#   <app>-20260806-101010.tar.gz
#   ├── manifest          qué lleva dentro, en texto plano
#   ├── app.conf          la configuración de la app
#   ├── redirects.list    sus redirecciones, si tiene
#   ├── database.sql.gz   volcado de PostgreSQL, si tiene
#   └── shared/           el .env, la página de mantenimiento y las subidas
#
# El fichero se crea con permisos 0600 y dueño root, porque lleva secretos.
# Lo que NO lleva es /etc/orbit/cloudflare.ini: ese token se regenera en
# treinta segundos con 'orbit cf-token', y dejarlo fuera significa que una
# copia robada no sirve para tomar el control de tu DNS.
backup_file() { echo "$BACKUP_DIR/$1-$(date +%Y%m%d-%H%M%S).tar.gz"; }

# El nombre de la base de datos de una app, con la misma regla que db_create.
app_db() { echo "${1//-/_}"; }

_db_exists() { # _db_exists <base>
  sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname='$1'" 2>/dev/null | grep -q 1
}

_role_exists() { # _role_exists <rol>
  sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname='$1'" 2>/dev/null | grep -q 1
}

# Usuario y contraseña de un DATABASE_URL, para poder recrear el rol al
# restaurar en un servidor limpio. Sin esto, la base se restauraría con una
# contraseña nueva y el .env que se acaba de restaurar ya no valdría.
_pg_url_part() { # _pg_url_part <url> <user|pass>
  local u="${1:-}" rest creds
  [[ "$u" == *://*:*@* ]] || return 1
  # La ÚLTIMA arroba, no la primera: una contraseña puede llevar arrobas
  # dentro y cortando por la primera se parte por la mitad.
  rest="${u#*://}"; creds="${rest%@*}"
  [[ "$creds" == *:* ]] || return 1
  case "$2" in
    user) printf '%s' "${creds%%:*}" ;;
    pass) printf '%s' "${creds#*:}" ;;
  esac
}

# La última línea que escribe pg_dump cuando **termina**. Es lo único que
# distingue un volcado bueno de uno cortado a la mitad, y hace falta porque un
# .gz truncado a mitad de escritura sigue siendo un .gz perfectamente válido:
# 'gzip -t' lo da por bueno. Comprobado con un PostgreSQL 16 de verdad, con un
# volcado entero, uno cortado y uno vacío.
#
# Dos trampas, las dos comprobadas ejecutándolas:
#
#   · **No es la última línea del fichero.** Desde PostgreSQL 16.13 el volcado
#     acaba en un '\unrestrict <token>' que va DESPUÉS de la marca. Mirar sólo
#     el final daría por rota una copia buena en cualquier servidor al día.
#     Se busca en todo el volcado: la marca sólo se escribe al terminar.
#   · **Empieza por '--', así que grep la toma por una opción.** Sin el '-e'
#     delante, grep contesta con su ayuda de uso y la comprobación dice «no
#     está» siempre — o sea, daría por rotas todas las copias.
_DUMP_MARK='-- PostgreSQL database dump complete'

# ¿De este volcado se puede volver? Comprime bien Y está entero.
_dump_ok() { # _dump_ok <fichero.sql.gz>
  [[ -s "$1" ]] || return 1
  gzip -t "$1" 2>/dev/null || return 1
  # Aquí el 'grep -q' de una tubería SÍ es seguro, y conviene decir por qué,
  # porque en general no lo es: bajo pipefail grep cierra la tubería al primer
  # acierto y quien escribe muere con 141. La marca es la ÚLTIMA línea del
  # volcado, así que cuando grep acierta ya no queda nada que escribir y zcat
  # ha terminado por su cuenta. Si algún día se buscara una marca de cabecera,
  # esta línea empezaría a dar por rotas todas las copias buenas.
  { zcat "$1" 2>/dev/null | grep -qF -e "$_DUMP_MARK"; } || return 1
  return 0
}

_backup_one() { # _backup_one <app> -> imprime la ruta del fichero
  local name="$1"
  load_app "$name"
  local out tmp db con_db="no" con_redir="no" con_env="no" n_shared=0
  out="$(backup_file "$name")"
  tmp="$(mktemp -d)"
  db="$(app_db "$name")"

  install -m 0600 "$(app_conf "$name")" "$tmp/app.conf"
  if [[ -f "$(redir_file "$name")" ]]; then
    install -m 0600 "$(redir_file "$name")" "$tmp/redirects.list"; con_redir="si"
  fi
  if [[ -d "$(app_shared "$name")" ]]; then
    cp -a "$(app_shared "$name")" "$tmp/shared"
    # shared/home es el HOME del servicio (§5.1), y es **caché**: el gestor de
    # paquetes que baja corepack y lo que cada librería deje en ~/.cache. Nada
    # de eso está sólo aquí —corepack lo vuelve a bajar y el build lo siembra
    # de nuevo—, así que entra en la regla de §17.1: en la copia va lo que no
    # está en ninguna otra parte. Copiarlo multiplicaría el tamaño de cada
    # copia y de cada generación que se conserve, por datos que caducan.
    #
    # Se borra después del cp y no con un --exclude porque el recuento de
    # abajo tiene que salir de lo que de verdad va dentro: si contara los
    # ficheros de la caché, 'verify' echaría en falta unos que nunca se
    # guardaron y daría por rotas todas las copias.
    rm -rf "$tmp/shared/home"
    # Y por el mismo criterio, las cachés de Laravel. Desde que storage/ es
    # compartido, una copia de una app Laravel se llenaba de sesiones, vistas
    # compiladas y logs: medido en una app recién desplegada, 411 de los 415
    # ficheros de la copia eran eso. Blade recompila las vistas, la caché se
    # rehace y las sesiones caducan; lo único irrepetible es storage/app/. En
    # un sitio de verdad esto son decenas de miles de ficheros por copia, y
    # 'backup verify' los recorre todos.
    rm -rf "$tmp/shared/storage/framework/cache" \
           "$tmp/shared/storage/framework/sessions" \
           "$tmp/shared/storage/framework/views"
    [[ -f "$tmp/shared/.env" ]] && con_env="si"
    # Cuántos ficheros van dentro, para que 'verify' pueda notar que faltan.
    n_shared="$(find "$tmp/shared" -type f 2>/dev/null | wc -l)"
  fi

  if _db_exists "$db"; then
    # El código de salida es el de **pg_dump**, no el del gzip. Sin esto, un
    # pg_dump que falla deja un .gz vacío —válido para 'gzip -t'— y la copia se
    # anunciaba con 'base_de_datos=si': sabías que el fichero existía, no que
    # se pudiera volver de él. Es justo el agujero que este comando cierra.
    #
    # Y la forma de recoger ese código tiene que ser ésta y no otra: dentro de
    # un '&&', de un '||' o de un 'if', bash apaga errexit y el subshell lo
    # hereda, así que 'pipefail' no salta. Ver ARCHITECTURE §20.7.
    local rc=0
    set +e
    ( set -Eeuo pipefail; sudo -u postgres pg_dump "$db" 2>/dev/null | gzip > "$tmp/database.sql.gz" )
    rc=$?
    set -e
    if (( rc != 0 )) || ! _dump_ok "$tmp/database.sql.gz"; then
      rm -rf "$tmp"
      err "El volcado de «%s» ha fallado o ha salido incompleto." "$db" >&2
      err "No hago una copia que diga llevar la base de datos y no la lleve." >&2
      hint "Comprueba que PostgreSQL está vivo:  systemctl status postgresql"
      return 1
    fi
    con_db="si"
  fi

  # El manifiesto es para quien abra el fichero dentro de dos años sin tener
  # Orbit delante: dice qué hay, qué falta y qué hacer con ello.
  cat > "$tmp/manifest" <<EOF
# Copia de seguridad de Orbit
app=$name
fecha=$(date -Iseconds)
orbit=${ORBIT_VERSION}
host=$(hostname -s 2>/dev/null || echo servidor)
dominio=$A_DOMAIN
tipo=$A_TYPE
repositorio=$A_REPO
rama=$A_BRANCH
base_de_datos=$con_db
redirecciones=$con_redir
entorno=$con_env
ficheros_shared=$n_shared
# El código NO está aquí: está en el repositorio de arriba. Para volver a
# levantar esta app:  orbit restore <este fichero>  y después  orbit deploy $name
EOF

  install -d -m 0700 "$BACKUP_DIR"
  tar -czf "$out" -C "$tmp" .
  chmod 0600 "$out"
  rm -rf "$tmp"
  printf '%s' "$out"
}

# ══════════════════════════════════ verificar una copia ══════════════════
# Saber que el fichero existe no es saber que se puede volver de él. Entre las
# dos cosas caben: un pg_dump que falló y dejó un .gz vacío, un disco que se
# llenó a mitad de escritura, un hook que copió el fichero a medias, y un
# manifiesto que dice llevar una base de datos que no está.
#
# Ninguno de esos casos lo detecta mirar el tamaño del fichero, y **tres de los
# cuatro pasan 'gzip -t'**. Se comprueba de verdad: se abre la copia, se lee lo
# que hay dentro y se contrasta con lo que el manifiesto dice que hay.
#
# Lo que NO hace, a propósito: restaurar sobre una base de datos de pruebas
# para ver si el SQL se aplica. Sería la única comprobación completa de verdad,
# pero exige crear y borrar bases en el servidor de producción, y una
# herramienta de verificación que puede romper lo que verifica no vale. Lo que
# sí se comprueba es que el volcado esté entero, que es donde falla de verdad.
#
# Deja el detalle en VERIFY_MSG y devuelve 0 si de la copia se puede volver.
VERIFY_MSG=""
_verify_one() { # _verify_one <fichero.tar.gz> -> 0 si sirve
  local f="$1" tmp rc=0 l
  VERIFY_MSG=""
  [[ -f "$f" ]] || { VERIFY_MSG="$(t "no existe")"; return 1; }
  [[ -s "$f" ]] || { VERIFY_MSG="$(t "está vacío")"; return 1; }

  # 1 · ¿se abre entera? Un tar.gz cortado por un disco lleno falla aquí.
  if ! tar tzf "$f" >/dev/null 2>&1; then
    VERIFY_MSG="$(t "el fichero está corrupto o incompleto (tar no puede leerlo)")"
    return 1
  fi

  tmp="$(mktemp -d)"
  if ! tar xzf "$f" -C "$tmp" 2>/dev/null; then
    rm -rf "$tmp"; VERIFY_MSG="$(t "no se ha podido extraer")"; return 1
  fi

  # 2 · ¿está lo imprescindible? Es lo mismo que exige _restore_one antes de
  # tocar nada, así que si falta, la restauración va a abortar.
  local falta=""
  [[ -f "$tmp/manifest" ]] || falta="manifest"
  [[ -f "$tmp/app.conf" ]] || falta="${falta:+$falta y }app.conf"
  if [[ -n "$falta" ]]; then
    rm -rf "$tmp"; VERIFY_MSG="$(t "le falta %s: 'orbit restore' la rechazaría" "$falta")"; return 1
  fi

  # 3 · ¿el manifiesto dice de qué app es? Sin eso no se sabe dónde va.
  local app; app="$(sed -n 's/^app=//p' "$tmp/manifest" | head -1)"
  if [[ -z "$app" ]]; then
    rm -rf "$tmp"; VERIFY_MSG="$(t "el manifiesto no dice de qué app es")"; return 1
  fi

  # 4 · ¿la configuración de la app dice cómo se llama?
  #
  # Se **lee**, no se ejecuta, y la diferencia importa. La primera versión de
  # esto hacía '. "$tmp/app.conf"' dentro de un subshell, creyendo que el
  # subshell bastaba: aísla las variables, sí, pero no los efectos. Un app.conf
  # con una línea cualquiera dentro la ejecutaría **como root**, que es quien
  # corre 'orbit', y ficheros, procesos y red no vuelven atrás al salir del
  # subshell. Y este comando existe precisamente para apuntarlo a un fichero
  # del que no te fías: verificar una copia no puede ser más peligroso que no
  # verificarla. 'orbit restore' nunca lo ejecutó — copia el fichero con
  # 'install' y ya—, así que esto era un agujero nuevo, no uno heredado.
  local acn=""
  while IFS= read -r l || [[ -n "$l" ]]; do
    [[ "$l" == A_NAME=* ]] || continue
    acn="${l#A_NAME=}"
    acn="${acn%\"}"; acn="${acn#\"}"; acn="${acn%\'}"; acn="${acn#\'}"
    break
  done < "$tmp/app.conf"
  if [[ -z "$acn" ]]; then
    rm -rf "$tmp"; VERIFY_MSG="$(t "app.conf no dice el nombre de la app")"; return 1
  fi
  # Y que las dos mitades de la copia hablen de la misma app: un manifiesto que
  # dice una cosa y una configuración que dice otra restauraría encima de quien
  # no toca.
  if [[ "$acn" != "$app" ]]; then
    rm -rf "$tmp"
    VERIFY_MSG="$(t "el manifiesto dice «%s» y app.conf dice «%s»" "$app" "$acn")"
    return 1
  fi

  # 5 · lo que el manifiesto promete tiene que estar. Los campos nuevos no
  # existen en copias de versiones anteriores: si no están, no se comprueban,
  # que es distinto de darlas por rotas.
  local dice_db dice_env dice_n
  dice_db="$(sed -n 's/^base_de_datos=//p' "$tmp/manifest" | head -1)"
  dice_env="$(sed -n 's/^entorno=//p' "$tmp/manifest" | head -1)"
  dice_n="$(sed -n 's/^ficheros_shared=//p' "$tmp/manifest" | head -1)"

  if [[ "$dice_db" == "si" ]]; then
    if [[ ! -f "$tmp/database.sql.gz" ]]; then
      rm -rf "$tmp"; VERIFY_MSG="$(t "dice llevar base de datos y no está")"; return 1
    fi
    if ! _dump_ok "$tmp/database.sql.gz"; then
      rm -rf "$tmp"
      VERIFY_MSG="$(t "el volcado de la base está incompleto o corrupto")"
      return 1
    fi
  fi
  if [[ "$dice_env" == "si" && ! -f "$tmp/shared/.env" ]]; then
    rm -rf "$tmp"; VERIFY_MSG="$(t "dice llevar .env y no está — es lo único irrecuperable")"; return 1
  fi
  if [[ -n "$dice_n" && "$dice_n" =~ ^[0-9]+$ ]]; then
    local hay; hay="$(find "$tmp/shared" -type f 2>/dev/null | wc -l)"
    if (( hay < dice_n )); then
      rm -rf "$tmp"
      VERIFY_MSG="$(t "faltan ficheros de shared/: dice %s y hay %s" "$dice_n" "$hay")"
      return 1
    fi
  fi

  # 6 · si lleva base de datos, restaurarla necesita usuario y contraseña del
  # DATABASE_URL. Que no se puedan leer no rompe la copia —el resto se
  # restaura— pero sí conviene saberlo ahora y no durante la restauración.
  local aviso=""
  if [[ "$dice_db" == "si" && -f "$tmp/shared/.env" ]]; then
    local url; url="$(sed -n 's/^[[:space:]]*DATABASE_URL=//p' "$tmp/shared/.env" | head -1)"
    url="${url%\"}"; url="${url#\"}"; url="${url%\'}"; url="${url#\'}"
    if [[ -z "$url" ]] || ! _pg_url_part "$url" pass >/dev/null 2>&1; then
      aviso="$(t " (sin DATABASE_URL legible: el rol habrá que recrearlo a mano)")"
    fi
  fi

  local tam; tam="$(du -h "$f" | cut -f1)"
  VERIFY_MSG="$app · $tam$aviso"
  rm -rf "$tmp"
  return $rc
}

# El comando de BACKUP_HOOK recibe la copia recién hecha. Es la forma de
# sacarla del servidor sin que Orbit tenga que saber de S3, de rclone ni de
# scp: una copia que vive en el mismo disco que los datos no es una copia,
# pero elegir a dónde va tampoco es trabajo de Orbit.
_backup_hook() { # _backup_hook <fichero>
  [[ -n "$BACKUP_HOOK" ]] || return 0
  # Hay dos maneras de escribir un hook y las dos tienen que funcionar:
  #
  #   BACKUP_HOOK='rclone copy --'                     comando suelto
  #   BACKUP_HOOK='gpg -e -r yo -o - "$ORBIT_BACKUP_FILE" | aws s3 cp - s3://…'
  #
  # Al primero se le añade el fichero al final, como hace 'find -exec'. Al
  # segundo no: ya dice dónde va, y añadírselo otra vez lo dejaría de último
  # argumento del último comando de la tubería, que es donde no hace nada.
  local cmd="$BACKUP_HOOK"
  [[ "$cmd" == *'$ORBIT_BACKUP_FILE'* || "$cmd" == *'$1'* ]] || cmd="$cmd \"\$1\""
  if spin "Enviando la copia fuera del servidor" \
       env ORBIT_BACKUP_FILE="$1" bash -c "$cmd" _ "$1"; then
    return 0
  fi
  err "El BACKUP_HOOK ha fallado: la copia sólo está en este servidor."
  return 1
}

_backup_prune() {
  find "$BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' -mtime "+$BACKUP_KEEP" -delete 2>/dev/null || true
  return 0
}

# ── el contrato de 'backup', para que un cliente no parsee columnas ────────
#
# 'orbit backup list' imprime una tabla con anchuras fijas y el tamaño en
# 'du -h'. Cualquiera que quiera esos datos acaba cortando por columnas, y a
# partir de ahí alinear una columna es un cambio incompatible (§13.1). Además
# 'du -h' escribe «1,2G» con el separador decimal de la configuración regional
# del servidor, o sea que el cliente tendría que deshacer una decisión de
# presentación tomada al otro lado.
#
# Tres decisiones, todas heredadas de lo que el contrato ya hace:
#   · 'app' es null en la copia de la configuración global, que no es de
#     ninguna app. 'kind' lo dice sin obligar a mirar el nombre del fichero,
#     que es la clase de dependencia que convierte un renombrado en una avería.
#   · 'size_bytes' en bruto. 'du -h' es presentación.
#   · 'created' en ISO-8601 con huso, como A_CREATED. El '%Y-%m-%d %H:%M' de la
#     tabla pierde el huso y no se puede comparar entre servidores.
#   · 'verified' es null: «no lo he comprobado en esta llamada», que no es lo
#     mismo que «está mal». Es el mismo null que 'cert_days' en 'list'.
#     Quien quiera la respuesta tiene 'orbit backup verify --json', que cuesta
#     abrir cada fichero y por eso no se hace de gratis en 'list'.
# Devuelve por dos globales y no por stdout, y no es estilo: quien lo llama
# necesita **dos** valores, y capturar con "$( )" abriría un subshell donde el
# segundo se perdería. Es la misma razón por la que '_top_measure' deja su
# resultado en TM_*, y el mismo fork que §13.6d quitó de los ayudantes JSON.
BK_KIND=""; BK_APP=""
_backup_kind_of() { # _backup_kind_of <ruta>  -> BK_KIND, BK_APP
  local b; b="${1##*/}"
  BK_APP=""
  if [[ "$b" == _orbit-conf-* ]]; then BK_KIND="config"; return 0; fi
  BK_KIND="app"
  # El nombre es '<app>-AAAAMMDD-HHMMSS.tar.gz'. Se recorta el sufijo, que es de
  # anchura fija, en vez de cortar por el primer guion: los nombres de app
  # llevan guiones —'_app_name_ok' los admite— y cortar por el primero partiría
  # 'mi-web' en 'mi'.
  [[ "$b" =~ ^(.+)-[0-9]{8}-[0-9]{6}\.tar\.gz$ ]] && BK_APP="${BASH_REMATCH[1]}"
  return 0
}

_backup_list_json() {
  local f sep="" total=0 bytes=0 sz
  printf '{"schema":%s,"dir":' "$JSON_SCHEMA"; _j_str "$BACKUP_DIR"
  printf ',"backups":['
  while read -r f; do
    [[ -n "$f" ]] || continue
    sz="$(stat -c %s "$f" 2>/dev/null || echo 0)"
    _backup_kind_of "$f"
    printf '%s{"file":' "$sep"; _j_str "$f"
    printf ',"app":'
    if [[ -n "$BK_APP" ]]; then _j_str "$BK_APP"; else printf 'null'; fi
    printf ',"kind":';       _j_str "$BK_KIND"
    printf ',"created":';    _j_str "$(date -r "$f" -Iseconds 2>/dev/null)"
    printf ',"size_bytes":'; _j_num "$sz"
    printf ',"verified":null}'
    sep=","
    total=$(( total + 1 )); bytes=$(( bytes + sz ))
  done < <(find "$BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' 2>/dev/null | sort -r)
  printf '],"total":%s,"bytes":%s,"keep_days":%s}\n' "$total" "$bytes" "$(_j_num "$BACKUP_KEEP")"
  # Cero copias salen como una colección vacía con total 0, no como silencio:
  # con stdout en blanco un cliente no puede distinguir «no había nada» de
  # «algo se rompió» (§13.6bb).
  return 0
}

# 'ok' de arriba es booleano y es **la misma regla que el código de salida**,
# no un recuento. Es la regla de 'deploy --all --json': un cliente que mire el
# objeto y otro que mire el código de salida no pueden discrepar nunca. Los
# recuentos van aparte, en 'good' y 'bad'.
_backup_verify_json() { # _backup_verify_json <fichero…>
  local f sep="" good=0 bad=0
  printf '{"schema":%s,"backups":[' "$JSON_SCHEMA"
  for f in "$@"; do
    [[ -n "$f" ]] || continue
    _backup_kind_of "$f"
    local ok="true" msg=""
    if [[ "$BK_KIND" == "config" ]]; then
      # La configuración global no lleva app ni manifiesto: se comprueba que se
      # abre y ya. Medirla con la misma vara diría que está rota.
      if tar tzf "$f" >/dev/null 2>&1; then msg="$(t "configuración global")"
      else ok="false"; msg="$(t "corrupta")"; fi
    else
      if _verify_one "$f"; then msg="$VERIFY_MSG"; else ok="false"; msg="$VERIFY_MSG"; fi
    fi
    [[ "$ok" == "true" ]] && good=$(( good + 1 )) || bad=$(( bad + 1 ))
    printf '%s{"file":' "$sep"; _j_str "$f"
    printf ',"kind":';    _j_str "$BK_KIND"
    printf ',"app":'
    if [[ -n "$BK_APP" ]]; then _j_str "$BK_APP"; else printf 'null'; fi
    printf ',"ok":%s' "$ok"
    # 'message' es prosa traducida, para enseñársela a una persona; 'ok' es
    # para decidir. La misma separación que 'error' y 'failed_step' en deploy.
    printf ',"message":'; _j_str "$msg"
    printf '}'
    sep=","
  done
  printf '],"total":%s,"good":%s,"bad":%s,"ok":%s}\n' \
    "$(( good + bad ))" "$good" "$bad" \
    "$([[ $bad -eq 0 ]] && printf 'true' || printf 'false')"
  (( bad == 0 ))
}

cmd_backup() {
  need_root backup
  _subcmd backup create app "create all|--all|--todas list|ls verify|check help|-h|--help" "$@"
  local sub="$SUBCMD"; set -- "${SUBCMD_ARGS[@]}"
  [[ "$JSON" == "yes" && "$sub" != "list" && "$sub" != "verify" ]] \
    && die "--json sólo está en 'orbit backup list' y 'orbit backup verify'"

  case "$sub" in
    verify)
      # Sin argumento, todas las que haya: es lo que se quiere de un comando
      # que existe para responder «¿puedo dormir tranquilo?».
      local -a files=()
      if [[ -n "${1:-}" ]]; then
        files=("$1")
        [[ -f "$1" ]] || die "No encuentro «%s»." "$1"
      else
        mapfile -t files < <(find "$BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' 2>/dev/null | sort -r)
        # Con --json, cero copias son una colección vacía y no un mensaje: es
        # una respuesta, y callarse no lo es.
        if [[ "$JSON" == "yes" ]] && (( ${#files[@]} == 0 )); then _backup_verify_json; return 0; fi
        (( ${#files[@]} )) || { info "Todavía no hay ninguna copia en %s." "$BACKUP_DIR"; return 0; }
      fi
      [[ "$JSON" == "yes" ]] && { _backup_verify_json "${files[@]}"; return $?; }
      title "Verificando copias"
      local f malas=0
      for f in "${files[@]}"; do
        # La configuración global no lleva app ni manifiesto: se comprueba que
        # se abre y ya. Verificarla con la misma vara diría que está rota.
        if [[ "$(basename "$f")" == _orbit-conf-* ]]; then
          if tar tzf "$f" >/dev/null 2>&1; then ok "%s {d}· configuración global{r}" "$(basename "$f")"
          else err "%s — corrupta" "$(basename "$f")"; malas=$((malas + 1)); fi
          continue
        fi
        if _verify_one "$f"; then
          ok "%s {d}· %s{r}" "$(basename "$f")" "$VERIFY_MSG"
        else
          err "%s — %s" "$(basename "$f")" "$VERIFY_MSG"; malas=$((malas + 1))
        fi
      done
      echo
      if (( malas )); then
        err "%s copia(s) de las que NO se puede volver." "$malas"
        info "Una copia rota no avisa sola: haz otra con 'orbit backup <app>'."
        logline "backup verify malas=$malas"
        return 1
      fi
      ok "Las %s copias se pueden restaurar." "${#files[@]}"
      logline "backup verify ok=${#files[@]}"
      return 0 ;;
    list)
      [[ "$JSON" == "yes" ]] && { _backup_list_json; return 0; }
      title "Copias de seguridad"
      local f n=0
      while read -r f; do
        [[ -n "$f" ]] || continue
        printf "  %-44s %8s  %s\n" "$(basename "$f")" \
          "$(du -h "$f" | cut -f1)" "$(date -r "$f" '+%Y-%m-%d %H:%M')"
        n=$((n + 1))
      done < <(find "$BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' 2>/dev/null | sort -r)
      (( n )) || info "Todavía no hay ninguna en %s." "$BACKUP_DIR"
      echo
      return 0 ;;
    all)
      local n out fallos=0 gout
      for n in $(app_names); do
        if out="$(_backup_one "$n")"; then
          # Se verifica antes de enviarla fuera: mandar a S3 una copia rota es
          # peor que no mandarla, porque parece que estás cubierto.
          if _verify_one "$out"; then
            ok "%s → %s {d}· %s{r}" "$n" "$(basename "$out")" "$VERIFY_MSG"
            _backup_hook "$out" || fallos=$((fallos + 1))
          else
            err "%s → la copia ha salido mal: %s" "$n" "$VERIFY_MSG"
            fallos=$((fallos + 1))
          fi
        else
          err "No he podido copiar «%s»" "$n"; fallos=$((fallos + 1))
        fi
      done
      # La configuración global va aparte: no es de ninguna app y restaurarla
      # es una decisión distinta, así que no se mezcla con ellas.
      install -d -m 0700 "$BACKUP_DIR"
      gout="$BACKUP_DIR/_orbit-conf-$(date +%Y%m%d-%H%M%S).tar.gz"
      local -a gconf=(orbit.conf)
      [[ -f "$ETC_DIR/notify.conf" ]] && gconf+=(notify.conf)
      if tar -czf "$gout" -C "$ETC_DIR" "${gconf[@]}" 2>/dev/null; then
        chmod 0600 "$gout"; ok "configuración global → %s" "$(basename "$gout")"
      fi
      _backup_prune
      logline "backup --all fallos=$fallos"
      (( fallos == 0 )) || return 1
      return 0 ;;
    create)
      local name="${1:-}" out
      [[ -n "$name" ]] || name="$(pick_app 'App a copiar')" || return 0
      app_exists "$name" || die "La app '%s' no existe. Mira 'orbit list'." "$name"
      # Sin 'if' ni '&&' alrededor: dentro de cualquiera de los dos, bash apaga
      # errexit y un _backup_one que aborta a mitad seguiría como si nada.
      set +e; out="$(_backup_one "$name")"; local brc=$?; set -e
      (( brc == 0 )) || die "No he podido copiar «%s»." "$name"
      ok "Copia de «%s» en %s (%s)" "$name" "$out" "$(du -h "$out" | cut -f1)"
      # Verificar aquí y no sólo bajo petición: una copia se hace una vez y se
      # necesita años después, así que el momento de descubrir que está rota es
      # éste y no aquel. Cuesta leer el fichero que se acaba de escribir.
      if _verify_one "$out"; then
        ok "Verificada: se puede restaurar {d}(%s){r}" "$VERIFY_MSG"
      else
        err "La copia ha salido mal: %s" "$VERIFY_MSG"
        err "No la des por buena. Revisa el disco y vuelve a intentarlo."
        logline "backup $name VERIFICACION-FALLIDA"
        return 1
      fi
      info "Lleva la configuración, el .env, las subidas y la base de datos."
      info "El código no: está en tu repositorio, que es mejor copia que ésta."
      _backup_hook "$out" || true
      _backup_prune
      logline "backup $name"
      return 0 ;;
    help)
      case "$ORBIT_LANG_CODE" in
        en) cat <<EOF
  orbit backup [app]        Backs up an app: configuration, .env, uploads and database
  orbit backup --all        All of them, plus Orbit's global configuration
  orbit backup list         Which backups are stored
  orbit backup verify [f]   Checks a backup can be come back from (no f, all of them)
  orbit restore <file>      Puts a backup back in its place
  orbit restore --all       Brings the whole server up from the backup directory

  Every backup is verified as soon as it is made. 'verify' repeats the check
  over the ones already stored: that they open whole, that they carry what
  their manifest promises, and that the database dump is not cut short.

  They live in $BACKUP_DIR and are deleted after $BACKUP_KEEP days (BACKUP_KEEP).
  With BACKUP_HOOK in orbit.conf, each backup is handed to that command to
  get it off the server:   BACKUP_HOOK="rclone copy --"
EOF
           ;;
        *) cat <<EOF
  orbit backup [app]        Copia una app: configuración, .env, subidas y base de datos
  orbit backup --all        Todas, más la configuración global de Orbit
  orbit backup list         Qué copias hay guardadas
  orbit backup verify [f]   Comprueba que de una copia se puede volver (sin f, todas)
  orbit restore <fichero>   Devolver una copia a su sitio
  orbit restore --all       Levantar el servidor entero desde el directorio de copias

  Cada copia se verifica nada más crearla. 'verify' repite la comprobación
  sobre las que ya están guardadas: que se abren enteras, que llevan lo que
  su manifiesto promete y que el volcado de la base no está cortado.

  Se guardan en $BACKUP_DIR y se borran a los $BACKUP_KEEP días (BACKUP_KEEP).
  Con BACKUP_HOOK en orbit.conf, cada copia se le pasa a ese comando para
  sacarla del servidor:   BACKUP_HOOK="rclone copy --"
EOF
           ;;
      esac ;;
  esac
}

# Restaurar es lo contrario de copiar, pero no es simétrico: la copia se hace
# sobre un servidor que funciona y la restauración, casi siempre, sobre uno que
# no. Por eso aquí se comprueba todo antes de tocar nada y se dice en voz alta
# lo que se va a sobrescribir.
_restore_db() { # _restore_db <app> <dump.gz>
  local name="$1" dump="$2" db role url pass user
  db="$(app_db "$name")"; role="$db"

  systemctl is-active --quiet postgresql 2>/dev/null || {
    warn "PostgreSQL no está en marcha: me salto la base de datos."
    info "  Arráncalo y carga el volcado con:  gunzip -c <copia> | sudo -u postgres psql %s" "$db"
    return 0
  }

  # El rol tiene que existir con la MISMA contraseña que dice el .env recién
  # restaurado. Si se creara con una nueva, la app no arrancaría y el fallo
  # aparecería mucho después como "password authentication failed", sin
  # relación aparente con la restauración.
  if ! _role_exists "$role"; then
    url="$(_env_read "$(_env_path "$name")" DATABASE_URL 2>/dev/null || true)"
    pass="$(_pg_url_part "$url" pass || true)"
    user="$(_pg_url_part "$url" user || true)"
    if [[ -z "$pass" || -z "$user" ]]; then
      warn "No existe el rol «%s» y no he podido sacar la contraseña del .env." "$role"
      info "  Créalo con 'orbit db create %s' y carga el volcado a mano:" "$name"
      info "    gunzip -c <copia>/database.sql.gz | sudo -u postgres psql %s" "$db"
      return 0
    fi
    role="$user"
    sudo -u postgres psql -qc "CREATE ROLE \"$role\" WITH LOGIN PASSWORD '$pass';" >/dev/null
    ok "Rol «%s» recreado con la contraseña que tenía el .env" "$role"
  fi

  if _db_exists "$db"; then
    warn "La base «%s» ya existe: el volcado se cargaría encima de lo que haya." "$db"
    confirm "¿Cargar el volcado sobre la base existente?" n || {
      info "Base de datos sin tocar. El volcado sigue dentro de la copia."
      return 0
    }
  else
    sudo -u postgres createdb -O "$role" "$db"
  fi
  if gunzip -c "$dump" | sudo -u postgres psql -q "$db" >/dev/null 2>&1; then
    sudo -u postgres psql -qc "GRANT ALL PRIVILEGES ON DATABASE \"$db\" TO \"$role\";" >/dev/null
    ok "Base de datos «%s» restaurada" "$db"
  else
    err "El volcado ha dado errores. Revísalo a mano:"
    info "  gunzip -c <copia>/database.sql.gz | sudo -u postgres psql %s" "$db"
  fi
  return 0
}

# El nombre de la app que lleva dentro una copia, leyendo sólo el manifiesto.
# Sirve para enseñar el plan de una restauración completa sin desempaquetar
# media docena de ficheros primero.
# El '|| true' es imprescindible, no una precaución. Con 'pipefail', un tar que
# no es un tar —o que no lleva manifiesto— hace que la tubería salga con el
# código de tar, y quien recoge esto en una asignación lo hereda: errexit mataba
# a orbit **antes** de llegar al mensaje que explica qué pasa. El usuario veía
# un código 2 y ni una línea. Aquí «no he podido leerlo» es una respuesta
# válida, y se devuelve vacía para que la decida quien pregunta.
_restore_name() { # _restore_name <fichero>
  { tar xzOf "$1" ./manifest 2>/dev/null | sed -n 's/^app=//p' | head -1; } || true
}

# El trabajo de restaurar, sin preguntas: quien llama ya ha confirmado. Está
# separado para que la restauración de una app y la del servidor entero hagan
# exactamente lo mismo y no dos cosas parecidas.
_restore_one() { # _restore_one <fichero> [--sin-siguiente-paso]
  local file="$1" callado="${2:-}"
  local tmp; tmp="$(mktemp -d)"
  tar -xzf "$file" -C "$tmp" 2>/dev/null \
    || { rm -rf "$tmp"; err "«%s» no es un tar.gz legible." "$file"; return 1; }
  if [[ ! -f "$tmp/manifest" || ! -f "$tmp/app.conf" ]]; then
    rm -rf "$tmp"; err "«%s» no parece una copia de Orbit: no trae manifiesto." "$file"; return 1
  fi
  local name; name="$(sed -n 's/^app=//p' "$tmp/manifest" | head -1)"
  if [[ -z "$name" ]] || ! _app_name_ok "$name"; then
    rm -rf "$tmp"; err "La copia no dice de qué app es, o el nombre no es válido."; return 1
  fi
  local existia="no"; app_exists "$name" && existia="si"

  install -d -m 0755 "$APPS_CONF"
  install -m 0640 "$tmp/app.conf" "$(app_conf "$name")"
  ok "Configuración restaurada"
  # El usuario del aislamiento viaja en la configuración, pero en un servidor
  # recién instalado no existe: se recrea antes de devolverle sus ficheros, y
  # con el MISMO nombre — _app_username es determinista justo para esto.
  local ruser; ruser="$(sed -n "s/^A_USER='\(.*\)'\$/\1/p" "$(app_conf "$name")" | head -1)"
  if [[ -n "$ruser" && "$ruser" != "$DEPLOY_USER" ]]; then
    _ensure_app_user "$ruser" "$name"
    # Y su pool, si es una app PHP: el vhost restaurado apunta al socket
    # propio, y sin el pool detrás la web contestaría 502 desde el minuto uno.
    # El fichero del pool no viaja en la copia —es configuración de ESTA
    # máquina, con su versión de PHP— sino que se regenera aquí.
    if ( load_app "$name"; _serves_php ); then
      render_php_pool "$name"
      _php_fpm_reload || true
    fi
  fi

  if [[ -f "$tmp/redirects.list" ]]; then
    install -d -m 0755 "$ETC_DIR/redirects"
    install -m 0644 "$tmp/redirects.list" "$(redir_file "$name")"
    ok "Redirecciones restauradas"
  fi

  if [[ -d "$tmp/shared" ]]; then
    install -d -o "$DEPLOY_USER" -g "$DEPLOY_USER" "$(app_dir "$name")"
    rm -rf "$(app_shared "$name")"
    cp -a "$tmp/shared" "$(app_shared "$name")"
    chown -R "${ruser:-$DEPLOY_USER}:${ruser:-$DEPLOY_USER}" "$(app_shared "$name")"
    ok "Datos compartidos restaurados (.env, subidas, página de mantenimiento)"
  fi

  [[ -f "$tmp/database.sql.gz" ]] && _restore_db "$name" "$tmp/database.sql.gz"
  rm -rf "$tmp"

  load_app "$name"
  ok "«%s» restaurada" "$name"
  # En una restauración de servidor entero el siguiente paso se dice una vez al
  # final, con todas las apps juntas; repetirlo por cada una es ruido.
  if [[ "$callado" != "--sin-siguiente-paso" ]]; then
    if [[ "$existia" == "no" ]]; then
      info "Falta el código, que está en %s. Tráelo con:  orbit deploy %s" "$A_REPO" "$name"
    else
      info "Si el .env ha cambiado, reinicia con:  orbit restart %s" "$name"
    fi
  fi
  logline "restore $name existia=$existia"
  return 0
}

# Qué claves de orbit.conf se restauran y cuáles no. Las que describen ESTE
# servidor —dónde viven las apps, con qué usuario corren, qué PHP hay— las
# escribe el instalador y las buenas son las de aquí: traerlas de otra máquina
# es la mejor forma de dejar un servidor recién montado apuntando a rutas que
# no existen. Las que son preferencias tuyas —cada cuánto vigilar, cuántas
# releases guardar, a dónde van las copias— son justo las que quieres de vuelta.
_ORBIT_CONF_RESTORE='LETSENCRYPT_EMAIL|KEEP_RELEASES|PORT_BASE|AUTODEPLOY_EVERY|QUEUE_EVERY|BUILD_RECOVERY|WATCH_[A-Z_]+|BACKUP_[A-Z_]+|TOP_[A-Z_]+'

# Vuelca las preferencias de una copia de orbit.conf sobre el de este servidor,
# clave a clave. No se copia el fichero entero a propósito: ver arriba.
_restore_conf() { # _restore_conf <orbit.conf de la copia>
  local src="$1" k v n=0
  [[ -r "$src" ]] || return 0
  while IFS='=' read -r k v; do
    [[ "$k" =~ ^($_ORBIT_CONF_RESTORE)$ ]] || continue
    v="${v%\"}"; v="${v#\"}"
    _conf_set "$k" "$v"
    n=$((n + 1))
  done < <(grep -E '^[A-Z_]+=' "$src" 2>/dev/null)
  (( n )) && ok "Preferencias restauradas de orbit.conf (%s claves)" "$n"
  return 0
}

cmd_restore() {
  need_root restore
  local file="" dir="" yes="no" all="no" deploy="no" a
  for a in "$@"; do
    case "$a" in
      -y|--yes|--si)     yes="yes" ;;
      --all|--todo)      all="yes" ;;
      --deploy)          deploy="yes" ;;
      -h|--help|help|ayuda)
        case "$ORBIT_LANG_CODE" in
          en) cat <<EOF
  usage: orbit restore <file.tar.gz> [-y]
         orbit restore --all [directory] [-y] [--deploy]

    Restores configuration, .env, uploads and database. The code is not in the
    backup —it is in your repository— so you have to deploy afterwards.

    --all      Every app in the backup directory, taking the most recent one
               of each, plus the preferences from orbit.conf
    --deploy   And deploy them at the end, one after another
    -y         Do not ask
EOF
             ;;
          *) cat <<EOF
  uso: orbit restore <fichero.tar.gz> [-y]
       orbit restore --all [directorio] [-y] [--deploy]

    Restaura configuración, .env, subidas y base de datos. El código no está
    en la copia —está en tu repositorio— así que después hay que desplegar.

    --all      Todas las apps que haya en el directorio de copias, cogiendo
               de cada una la más reciente, más las preferencias de orbit.conf
    --deploy   Y desplegarlas al terminar, una detrás de otra
    -y         No preguntar
EOF
             ;;
        esac
        return 0 ;;
      -*) die "orbit restore: no entiendo «%s»." "$a" ;;
      *)  if [[ "$all" == "yes" ]]; then
            [[ -n "$dir" ]] && die "orbit restore: sobra «%s»." "$a"; dir="$a"
          else
            [[ -n "$file" ]] && die "orbit restore: sobra «%s»." "$a"; file="$a"
          fi ;;
    esac
  done

  [[ "$all" == "yes" ]] && { _restore_all "${dir:-$BACKUP_DIR}" "$yes" "$deploy"; return $?; }

  [[ -n "$file" ]] || die "uso: orbit restore <fichero.tar.gz> [-y]   ·   orbit restore --all"
  [[ -r "$file" ]] || die "No puedo leer «%s»." "$file"

  local name; name="$(_restore_name "$file")"
  [[ -n "$name" ]] || die "«%s» no parece una copia de Orbit: no trae manifiesto." "$file"

  title "Restaurar «%s»" "$name"
  tar xzOf "$file" ./manifest 2>/dev/null | sed -n 's/^\([a-z_]*\)=\(.*\)$/  \1: \2/p'
  echo
  app_exists "$name" && \
    warn "La app «%s» ya existe: se sobrescriben configuración, .env y subidas." "$name"
  [[ "$yes" == "yes" ]] || confirm "¿Restaurar?" n || { info "Cancelado"; return 0; }

  _restore_one "$file" || return 1
  echo
  return 0
}

# Un servidor entero de una tirada. El caso para el que existe: la máquina se
# ha perdido, hay un Ubuntu nuevo con Orbit instalado, y en un directorio están
# las copias que el hook fue sacando de la anterior.
#
# De cada app se coge la copia más reciente. Se enseña el plan entero antes de
# tocar nada y se pregunta **una vez**: encadenar veinte confirmaciones a las
# tres de la mañana no es seguridad, es una carrera de clics.
_restore_all() { # _restore_all <directorio> <yes> <deploy>
  local dir="$1" yes="$2" deploy="$3"
  [[ -d "$dir" ]] || die "No existe el directorio de copias: %s" "$dir"

  local -A ultima=() cuando=()
  local f n ts conf=""
  while read -r f; do
    [[ -n "$f" ]] || continue
    case "$(basename "$f")" in
      _orbit-conf-*) [[ "$f" > "$conf" ]] && conf="$f"; continue ;;
    esac
    n="$(_restore_name "$f")"
    [[ -n "$n" ]] && _app_name_ok "$n" || continue
    ts="$(date -r "$f" +%s 2>/dev/null || echo 0)"
    # La más reciente de cada app: restaurar una vieja encima de una nueva
    # sería perder datos sin que nadie lo haya pedido.
    if [[ -z "${ultima[$n]:-}" ]] || (( ts > ${cuando[$n]:-0} )); then
      ultima["$n"]="$f"; cuando["$n"]="$ts"
    fi
  done < <(find "$dir" -maxdepth 1 -name '*.tar.gz' 2>/dev/null | sort)

  title "Restaurar el servidor entero"
  printf "  ${D}%s${R}\n\n" "$(t "Copias en %s" "$dir")"
  (( ${#ultima[@]} )) || { info "No hay ninguna copia de app en %s." "$dir"; return 0; }

  for n in $(printf '%s\n' "${!ultima[@]}" | sort); do
    printf "  %-18s %-40s %s  %s\n" "$n" "$(basename "${ultima[$n]}")" \
      "$(date -r "${ultima[$n]}" '+%Y-%m-%d %H:%M')" \
      "$(app_exists "$n" && t "{yel}(ya existe, se sobrescribe){r}" || true)"
  done
  [[ -n "$conf" ]] && printf "  %-18s %s\n" "preferencias" "$(basename "$conf")"
  printf "\n  %s\n\n" \
    "$(t "{b}%s apps{r} {d}· el código se trae de git después%s{r}" "${#ultima[@]}" \
        "$([[ "$deploy" == "yes" ]] && t ", y se despliegan solas" || true)")"

  [[ "$yes" == "yes" ]] || confirm "¿Restaurar todo esto?" n || { info "Cancelado"; return 0; }

  local fallos=0
  for n in $(printf '%s\n' "${!ultima[@]}" | sort); do
    hr 66
    _restore_one "${ultima[$n]}" --sin-siguiente-paso || fallos=$((fallos + 1))
  done
  [[ -n "$conf" ]] && _restore_global "$conf"

  hr 66
  echo
  if (( fallos )); then
    err "%s copias no se han podido restaurar. Las demás sí." "$fallos"
  else
    ok "Servidor restaurado: %s apps" "${#ultima[@]}"
  fi

  # El código es la mitad que falta, y traerlo puede tardar y puede fallar, así
  # que no se hace por sorpresa: o lo pides con --deploy, o se te dan los
  # comandos ya escritos.
  if [[ "$deploy" == "yes" ]]; then
    for n in $(printf '%s\n' "${!ultima[@]}" | sort); do
      hr 66
      cmd_deploy "$n" || { err "El despliegue de «%s» ha fallado" "$n"; fallos=$((fallos + 1)); }
    done
  else
    echo
    info "Falta traer el código. Cuando GitHub esté conectado ('orbit github'):"
    for n in $(printf '%s\n' "${!ultima[@]}" | sort); do
      printf "      orbit deploy %s\n" "$n"
    done
    info "O de una vez:  orbit restore --all --deploy"
  fi
  logline "restore --all apps=${#ultima[@]} fallos=$fallos"
  (( fallos == 0 ))
}

# La configuración global de la copia: las preferencias se vuelcan clave a
# clave y los avisos se restauran enteros, porque notify.conf no describe al
# servidor —es a quién avisar y por dónde—.
_restore_global() { # _restore_global <_orbit-conf-*.tar.gz>
  local file="$1" tmp; tmp="$(mktemp -d)"
  if tar -xzf "$file" -C "$tmp" 2>/dev/null; then
    [[ -f "$tmp/orbit.conf" ]] && _restore_conf "$tmp/orbit.conf"
    if [[ -f "$tmp/notify.conf" ]]; then
      install -m 0600 "$tmp/notify.conf" "$ETC_DIR/notify.conf"
      ok "Avisos restaurados (notify.conf)"
    fi
  else
    err "No he podido abrir %s" "$(basename "$file")"
  fi
  rm -rf "$tmp"
  return 0
}

# ════════════════════════════════════════════════════════ varios ══════════
# El mismo objeto de app en 'list' y en 'status', para que un cliente aprenda
# una forma y no dos. Pisa las variables A_*: llámala dentro de $(…).
_apps_json() {
  local n sep=""
  local -a al
  printf '['
  for n in $(app_names); do
    load_app "$n"
    # read -ra y no $A_ALIASES a pelo: separa por espacios sin que un comodín
    # en el valor se convierta en nombres de fichero. Con nullglob activo, ese
    # comodín sin coincidencias además desaparecería.
    read -ra al <<<"$A_ALIASES"
    # Se llaman en vez de capturarse, por lo mismo que en _app_state_json:
    # todas escriben por stdout y "$( )" sólo añadía un fork por campo.
    # '_app_state_json' sólo LEE las A_*, así que no necesita el subshell que
    # sí necesita _apps_json —que llama a load_app y las pisa—.
    printf '%s{"name":' "$sep"; _j_str "$A_NAME"
    printf ',"type":';          _j_str "$A_TYPE"
    printf ',"domain":';        _j_str "$A_DOMAIN"
    printf ',"aliases":';       _j_list "${al[@]}"
    printf ',"state":';         _app_state_json
    printf '}'
    sep=","
  done
  printf ']'
}

_list_json() { printf '{"schema":%s,"apps":%s}\n' "$JSON_SCHEMA" "$(_apps_json)"; }

cmd_list() {
  [[ "$JSON" == "yes" ]] && { _list_json; return 0; }
  title "Aplicaciones"
  local names; names=$(app_names)
  [[ -z "$names" ]] && { info "Todavía no hay ninguna. Crea la primera con 'orbit new'."; return 0; }
  printf "  ${B}%-16s %-8s %-30s %-7s %-9s %s${R}\n" \
    "$(t "APP")" "$(t "TIPO")" "$(t "DOMINIO")" "$(t "PUERTO")" "$(t "ESTADO")" "$(t "SSL")"
  hr 90
  # Las siete palabras de las columnas ESTADO y SSL no dependen de la app, así
  # que se traducen una vez y no cuarenta. Cada "$(t …)" es una sustitución de
  # órdenes, o sea un fork, y estaban todas dentro del bucle: con 40 apps, 327
  # procesos y 330 ms para pintar una tabla que cabe en pantalla —el comando
  # que más se escribe y la portada del menú—. Ahora 167 y 190 ms. Se usa
  # '_t', que deja el resultado en I18N_MSG, porque 't' sólo lo imprime y
  # volvería a hacer falta el "$( )" para recogerlo.
  local W_STATIC W_PHP W_REDIR W_UP W_DOWN W_MAINT W_NOVHOST SSL_NO SSL_SI
  _t "estatico"; W_STATIC="$I18N_MSG"
  _t "php-fpm";  W_PHP="$I18N_MSG"
  _t "redirige"; W_REDIR="$I18N_MSG"
  _t "activo";   W_UP="$I18N_MSG"
  _t "parado";   W_DOWN="$I18N_MSG"
  # La misma palabra que usa 'orbit top', para que las dos tablas no se
  # inventen cada una la suya.
  _t "manten.";  W_MAINT="$I18N_MSG"
  _t "sin vhost"; W_NOVHOST="$I18N_MSG"
  _t "no";       SSL_NO="${RED}$I18N_MSG${R}"
  _t "sí";       SSL_SI="${GRN}$I18N_MSG${R}"
  local n
  for n in $names; do
    load_app "$n"
    # Las palabras de la columna se traducen, pero el ancho se calcula después
    # con printf '%-9s', que cuenta bytes: en inglés caben todas, y si algún día
    # no cupieran, la columna se desalinearía y se vería. Alinear por caracteres
    # aquí exigiría fijar la configuración regional dentro de la función, que es
    # lo que hace _pad en las pruebas.
    local word color="$GRY"
    word="$W_STATIC"
    # Una app PHP no es «estática», y en Laravel esa palabra es además la del
    # fallo que la detección existe para evitar: quien mire la lista para
    # comprobar que su Laravel está bien detectado leería justo lo contrario.
    [[ "$A_TYPE" == "php" || "$A_TYPE" == "laravel" ]] && word="$W_PHP"
    [[ "$A_TYPE" == "redirect" ]] && word="$W_REDIR"
    if needs_svc "$A_TYPE"; then
      if systemctl is-active --quiet "$(svc_name "$n")" 2>/dev/null; then word="$W_UP"; color="$GRN"
      else word="$W_DOWN"; color="$RED"; fi
    fi
    # Y el mantenimiento gana sobre todo lo anterior, porque es lo que de verdad
    # está recibiendo el visitante: con el testigo puesto, nginx devuelve 503
    # antes de mirar nada más, esté la unidad como esté.
    #
    # Faltaba aquí, y sólo aquí: 'orbit top' ya lo marcaba y el '--json' de este
    # mismo comando ya trae "maintenance": true — o sea que **la salida humana y
    # la salida máquina del mismo comando se contradecían**, y la que se
    # contradecía era la que mira una persona. Con una app en mantenimiento
    # —puesta a mano, o el residuo de un despliegue muerto de mala manera
    # (§5.5)— la tabla decía «activo» sobre una web que contestaba 503 a todo el
    # mundo. Salió midiendo justo ese residuo en un servidor.
    [[ -f "$(maint_flag "$n")" ]] && { word="$W_MAINT"; color="$YEL"; }
    # Y no tener vhost gana sobre todo, incluido el mantenimiento: sin vhost
    # nginx no sirve ni la página de 503 — la petición cae en el servidor por
    # defecto y el visitante recibe la conexión cerrada. Es el estado más fuerte
    # que puede tener una app, porque no la sirve nadie.
    #
    # Antes esta columna decía 'php-fpm' en ese caso, que es una **constante**
    # escrita para las apps PHP y no puede acusar a nada. Una columna que no
    # puede tomar más de un valor no es un estado: es una etiqueta.
    [[ -f "$(nginx_file "$n")" && -L "$(nginx_link "$n")" ]] \
      || { word="$W_NOVHOST"; color="$RED"; }
    # printf -v y no "$(printf …)": rellenar a nueve columnas no merece un fork.
    local pad state; printf -v pad '%-9s' "$word"; state="$color$pad$R"
    local ssl="$SSL_NO"
    has_cert "$A_DOMAIN" && ssl="$SSL_SI"
    printf "  %-16s %-8s %-30s %-7s %b %b\n" "$A_NAME" "$A_TYPE" "$A_DOMAIN" "${A_PORT:--}" "$state" "$ssl"
  done
  echo
}

_info_json() { # con la app cargada
  local -a rels; mapfile -t rels < <(releases_desc "$(app_dir "$A_NAME")")
  printf '{"schema":%s,"app":{"name":%s,"path":%s,"config":%s,"state":%s,"releases":%s}}\n' \
    "$JSON_SCHEMA" "$(_j_str "$A_NAME")" "$(_j_str "$(app_dir "$A_NAME")")" \
    "$(_app_config_json)" "$(_app_state_json --cert-days)" \
    "$(_j_list "${rels[@]}")"
}

cmd_info() {
  local name="${1:-}"
  # Un cliente que pide JSON no puede contestar a un selector interactivo.
  if [[ -z "$name" && "$JSON" == "yes" ]]; then
    die "uso: orbit info <app> --json"
  fi
  [[ -n "$name" ]] || name="$(pick_app 'App')" || return 0
  load_app "$name"
  [[ "$JSON" == "yes" ]] && { _info_json; return 0; }
  title "%s" "$A_NAME"
  printf "%s\n" "$(t "  Repositorio   %s (%s)" "$A_REPO" "$A_BRANCH")"
  printf "%s\n" "$(t "  Dominios      %s %s" "$A_DOMAIN" "$A_ALIASES")"
  printf "%s\n" "$(t "  Tipo          %s" "$A_TYPE")"
  printf "%s\n" "$(t "  Build         %s" "${A_BUILD:--}")"
  printf "%s\n" "$(t "  Start         %s" "${A_START:--}")"
  printf "%s\n" "$(t "  Puerto        %s" "${A_PORT:--}")"
  printf "%s\n" "$(t "  Ruta          %s" "$(app_dir "$name")")"
  printf "%s\n" "$(t "  Último deploy %s" "${A_LASTDEPLOY:-$(t "nunca")}")"
  printf "%s\n" "$(t "  Releases      %s" "$(releases_desc "$(app_dir "$name")" | wc -l)")"
  echo
}

# ════════════════════════════════════════════════════════ panel ═══════════
# 'orbit top' es la interfaz gráfica que Orbit puede permitirse: la dibuja el
# terminal, no abre ningún puerto, no deja nada corriendo y se va con Ctrl-C.
# Un panel web habría necesitado un proceso escuchando —principio 2— y este no
# necesita ni eso ni una dependencia nueva. El razonamiento está en
# ARCHITECTURE §13.
#
# Mide de tres sitios, todos ya en uso:
#   · systemd  MemoryCurrent y CPUUsageNSec del cgroup de cada unidad
#   · nginx    las líneas del último minuto en el log de acceso de la app
#   · disco    el fichero de mantenimiento y el certificado
#
# El porcentaje de CPU es una **diferencia entre dos lecturas**, no un valor
# que se pueda preguntar: systemd sólo lleva el total acumulado desde que
# arrancó el servicio. Por eso hace falta recordar la muestra anterior entre
# fotogramas, y por eso una foto suelta ('--once') tiene que esperar a propósito.
declare -A TOP_CPU_PREV=() TOP_TS_PREV=()

# Resultado de la última medición. Globales y no una cadena por stdout porque
# medir actualiza TOP_CPU_PREV, y en $(…) eso pasaría en un subshell y se
# perdería: el porcentaje no volvería a salir nunca.
TM_STATE=""; TM_MEM=""; TM_PCT=""; TM_REQ=""; TM_CAP="no"

# Peticiones servidas por una app desde el corte. Se miran las últimas
# TOP_LOG_LINES líneas y no el fichero entero, que en una web con tráfico son
# cientos de megas y esto se refresca cada dos segundos. Si el minuto llena el
# tope, TM_CAP lo dice: un número corto sin avisar es peor que no darlo.
_top_reqs() { # _top_reqs <app> <corte YYYYMMDDHHMMSS>
  local f count
  f="$(nginx_log_access "$1")"
  [[ -r "$f" ]] || return 0
  _log_has_time "$f" || return 0
  count="$(tail -n "$TOP_LOG_LINES" "$f" | awk -v CUT="$2" "$_LOG_SINCE_AWK" | wc -l)"
  TM_REQ="$count"
  (( count >= TOP_LOG_LINES )) && TM_CAP="yes"
  return 0
}

# TM_PCT va en décimas de punto porcentual (125 = 12,5 %): la aritmética de
# bash es entera y redondear a unidades esconde justo el rango que interesa
# mirar en un VPS pequeño.
_top_measure() { # _top_measure <app> <tipo> <ahora_ns> <corte|0 para no mirar el log>
  local n="$1" t="$2" now="$3" cut="$4" unit mem cpu dt dcpu
  TM_STATE="$(svc_state "$n" "$t")"; TM_MEM=""; TM_PCT=""; TM_REQ=""; TM_CAP="no"
  if [[ "$TM_STATE" == "running" ]]; then
    unit="$(svc_name "$n")"
    mem="$(systemctl show "$unit" -p MemoryCurrent --value 2>/dev/null || true)"
    [[ "$mem" =~ ^[0-9]+$ ]] && TM_MEM="$mem"
    # Vacío o '[not set]' si la unidad no lleva contabilidad de CPU. No es un
    # error: es que no se puede saber, y se pinta como que no se sabe.
    cpu="$(systemctl show "$unit" -p CPUUsageNSec --value 2>/dev/null || true)"
    if [[ "$cpu" =~ ^[0-9]+$ ]]; then
      if [[ -n "${TOP_CPU_PREV[$n]:-}" ]]; then
        dt=$(( now - ${TOP_TS_PREV[$n]:-0} ))
        dcpu=$(( cpu - ${TOP_CPU_PREV[$n]} ))
        (( dt > 0 && dcpu >= 0 )) && TM_PCT=$(( dcpu * 1000 / dt ))
      fi
      TOP_CPU_PREV["$n"]="$cpu"; TOP_TS_PREV["$n"]="$now"
    fi
  else
    # Una app parada no gasta y su contador se queda quieto. Si se guardara la
    # muestra, al volver a arrancar la diferencia contra ella daría un pico
    # enorme que no ha ocurrido.
    unset "TOP_CPU_PREV[$n]" "TOP_TS_PREV[$n]"
  fi
  [[ "$cut" != "0" ]] && _top_reqs "$n" "$cut"
  return 0
}

_human_bytes() { # _human_bytes <bytes>
  local b="${1:-}"
  [[ "$b" =~ ^[0-9]+$ ]] || { printf '·'; return 0; }
  if   (( b >= 1073741824 )); then printf '%s,%sG' "$(( b / 1073741824 ))" "$(( b % 1073741824 * 10 / 1073741824 ))"
  elif (( b >= 1048576 ));    then printf '%sM'    "$(( b / 1048576 ))"
  elif (( b >= 1024 ));       then printf '%sK'    "$(( b / 1024 ))"
  else                             printf '%sB'    "$b"; fi
}

_top_pct_text() { # décimas -> "12,5%" o "·" si no se sabe
  [[ -n "$TM_PCT" ]] || { printf '·'; return 0; }
  printf '%s,%s%%' "$(( TM_PCT / 10 ))" "$(( TM_PCT % 10 ))"
}

_top_frame() { # _top_frame <intervalo>
  local n now cut word color state reqs mem cpu
  now="$(date +%s%N)"; cut="$(date -d '1 minute ago' '+%Y%m%d%H%M%S')"
  # Sólo se borra la pantalla si hay pantalla. Con la salida redirigida, la
  # secuencia de borrado es basura al principio del fichero.
  [[ -t 1 ]] && printf '\e[H\e[2J'
  # Cabecera propia y no banner(): la suya lleva una regla de 66 columnas que
  # no cuadra con esta tabla. La hora, además, hace visible que se refresca.
  printf "\n${CYA}${B}  ORBIT top${R}  ${D}%s · %s apps · %s${R}\n" \
    "$(hostname -s)" "$(app_count)" "$(date '+%H:%M:%S')"
  hr 88
  printf "  ${B}%-16s %-7s %-9s %8s %7s %9s %-24s${R}\n" \
    "$(t "APP")" "$(t "TIPO")" "$(t "ESTADO")" "$(t "CPU")" "$(t "MEM")" "$(t "REQ/min")" "$(t "DOMINIO")"
  hr 88
  for n in $(app_names); do
    load_app "$n"
    _top_measure "$n" "$A_TYPE" "$now" "$cut"
    case "$TM_STATE" in
      running) word="activo";  color="$GRN" ;;
      stopped) word="parado";  color="$RED" ;;
      *)       word="—";       color="$GRY" ;;
    esac
    [[ -f "$(maint_flag "$n")" ]] && { word="manten."; color="$YEL"; }
    state="$color$(printf '%-9s' "$word")$R"
    mem="$(_human_bytes "$TM_MEM")"
    cpu="$(_top_pct_text)"
    reqs="${TM_REQ:-·}"; [[ "$TM_CAP" == "yes" ]] && reqs="${reqs}+"
    printf "  %-16s %-7s %b %8s %7s %9s %-24s\n" \
      "$A_NAME" "$A_TYPE" "$state" "$cpu" "$mem" "$reqs" "$A_DOMAIN"
  done
  hr 88
  printf "  ${D}%s${R}\n" "$(t "carga %s · memoria %s · disco %s" \
    "$(cut -d' ' -f1-3 /proc/loadavg)" \
    "$(free -h | awk '/^Mem:/{print $3"/"$2}')" \
    "$(df -h / | awk 'NR==2{print $5}')")"
  printf "  %s\n" "$(t "{d}refresco %ss · {r}{b}q{r}{d} salir · {r}{b}r{r}{d} refrescar ya{r}" "$1")"
}

_top_json() {
  local n now cut sep="" pct
  now="$(date +%s%N)"; cut="$(date -d '1 minute ago' '+%Y%m%d%H%M%S')"
  printf '{"schema":%s,"apps":[' "$JSON_SCHEMA"
  for n in $(app_names); do
    load_app "$n"
    _top_measure "$n" "$A_TYPE" "$now" "$cut"
    pct="null"; [[ -n "$TM_PCT" ]] && pct="$(( TM_PCT / 10 )).$(( TM_PCT % 10 ))"
    printf '%s{"name":%s,"type":%s,"domain":%s,"port":%s,"service":%s,' \
      "$sep" "$(_j_str "$A_NAME")" "$(_j_str "$A_TYPE")" "$(_j_str "$A_DOMAIN")" \
      "$(_j_num "$A_PORT")" \
      "$([[ -n "$TM_STATE" ]] && _j_str "$TM_STATE" || printf 'null')"
    printf '"cpu_percent":%s,"memory_bytes":%s,"requests_last_minute":%s,"requests_capped":%s}' \
      "$pct" "$(_j_num "$TM_MEM")" "$(_j_num "$TM_REQ")" "$(_j_bool "$TM_CAP")"
    sep=","
  done
  printf ']}\n'
}

cmd_top() {
  local once="no" interval="$TOP_INTERVAL" a
  for a in "$@"; do
    case "$a" in
      --once|-1)   once="yes" ;;
      --interval=*) interval="${a#*=}" ;;
      -h|--help|help|ayuda)
        printf '%b' "$(t "  uso: orbit top [--once] [--interval=<segundos>] [--json]\n")"; return 0 ;;
      *) die "orbit top: no entiendo «%s». Prueba 'orbit top --help'." "$a" ;;
    esac
  done
  [[ "$interval" =~ ^[0-9]+$ ]] && (( interval >= 1 )) || die "orbit top: el intervalo son segundos enteros a partir de 1."

  # Sin terminal no hay panel: un bucle que se refresca dentro de una tubería
  # sólo sirve para llenar un fichero. Se da una foto y se sale.
  [[ -t 1 && -t 0 ]] || once="yes"

  if [[ "$JSON" == "yes" || "$once" == "yes" ]]; then
    # La primera medición no puede dar CPU porque no hay con qué compararla.
    # En el panel en vivo la comparación llega sola en el fotograma siguiente;
    # aquí sólo hay uno, así que se toma una muestra, se espera y se mide.
    local n
    for n in $(app_names); do load_app "$n"; _top_measure "$n" "$A_TYPE" "$(date +%s%N)" 0; done
    sleep 1
    if [[ "$JSON" == "yes" ]]; then _top_json; else _top_frame "$interval"; fi
    return 0
  fi

  # Pantalla alternativa: al salir, el terminal queda como estaba y el panel no
  # se queda pegado en el historial. Es lo que hacen htop y less.
  local key
  trap '_top_leave' EXIT
  trap '_top_leave; exit 0' INT TERM
  printf '\e[?1049h\e[?25l'
  while true; do
    _top_frame "$interval"
    # read hace de espera y de teclado a la vez: la 'q' sale en el momento y no
    # cuando se acabe el intervalo.
    key=""; read -rsn1 -t "$interval" key || true
    case "$key" in q|Q) break ;; esac
  done
  _top_leave
  trap - EXIT INT TERM
}

# Idempotente a propósito: la llaman la salida normal, Ctrl-C y el trap de EXIT
# que dispara ese mismo Ctrl-C, y repetir estas secuencias no hace nada.
_top_leave() { printf '\e[?25h\e[?1049l'; }

# ════════════════════════════════════════════════════════ logs ════════════
# En un solo sitio: lo escribe el vhost y lo lee 'orbit logs'. Las pruebas las
# sustituyen para no necesitar /var/log/nginx.
nginx_log_access() { echo "/var/log/nginx/$1.access.log"; }
nginx_log_error()  { echo "/var/log/nginx/$1.error.log"; }
NGINX_BASE_CONF="/etc/nginx/conf.d/00-orbit-base.conf"

# «hace una hora» se escribe de muchas maneras y ninguna es la de journalctl.
# Se traducen las formas cortas y lo demás se le pasa tal cual a date, que
# entiende '10:00', 'ayer' en inglés y las fechas ISO.
_since_expr() { # _since_expr <texto>
  local s="${1,,}" n="${1%%[!0-9]*}"
  case "$s" in
    hoy|today)                        printf 'today' ;;
    ayer|yesterday)                   printf 'yesterday' ;;
    [0-9]*m|[0-9]*min|[0-9]*minutos)  printf '%s minutes ago' "$n" ;;
    [0-9]*h|[0-9]*hora|[0-9]*horas)   printf '%s hours ago' "$n" ;;
    [0-9]*d|[0-9]*dia|[0-9]*dias|[0-9]*día|[0-9]*días) printf '%s days ago' "$n" ;;
    [0-9]*s|[0-9]*seg|[0-9]*segundos) printf '%s seconds ago' "$n" ;;
    *) printf '%s' "$1" ;;
  esac
}

# Momento de corte como YYYYMMDDHHMMSS, que es comparable como texto y es el
# formato que construye el filtro de abajo. Vacío si no se entiende.
_since_stamp() { date -d "$(_since_expr "$1")" '+%Y%m%d%H%M%S' 2>/dev/null || true; }

# Filtro por fecha para los logs de nginx. En awk y no en gawk a propósito:
# Ubuntu trae mawk, que no tiene match() de tres argumentos ni strftime. Las dos
# marcas de tiempo posibles son de ancho fijo, así que basta con substr:
#   acceso  [05/Aug/2026:17:59:52 +0000] …
#   errores 2026/08/05 17:59:52 [error] …
_LOG_SINCE_AWK='
BEGIN { meses = "JanFebMarAprMayJunJulAugSepOctNovDec" }
{
  stamp = ""
  if (substr($0,1,1) == "[") {
    mes = index(meses, substr($0,5,3))
    if (mes > 0)
      stamp = substr($0,9,4) sprintf("%02d", (mes+2)/3) substr($0,2,2) \
              substr($0,14,2) substr($0,17,2) substr($0,20,2)
  } else if (substr($0,5,1) == "/" && substr($0,8,1) == "/") {
    stamp = substr($0,1,4) substr($0,6,2) substr($0,9,2) \
            substr($0,12,2) substr($0,15,2) substr($0,18,2)
  }
  if (stamp != "" && stamp >= CUT) print
}'

_log_since() { # _log_since <corte> <fichero…>
  local cut="$1"; shift
  local f
  for f in "$@"; do
    [[ -r "$f" ]] || continue
    awk -v CUT="$cut" "$_LOG_SINCE_AWK" "$f"
  done
}

# Un log de acceso sin marca de tiempo no se puede filtrar. Pasa en servidores
# instalados antes de que el formato la llevara; se arregla con nginx-rebuild.
# Se mira la ÚLTIMA línea, no la primera: el fichero no se vacía al cambiar el
# formato, así que durante días conserva arriba las líneas viejas y abajo las
# nuevas, y la primera diría que sigue sin fecha cuando ya la tiene.
_log_has_time() { # _log_has_time <fichero>
  [[ -s "$1" ]] || return 0
  [[ "$(tail -n 1 "$1")" == \[* ]]
}

# ── el contrato de 'logs', y la única excepción del contrato entero ────────
#
# 'logs' es el único comando cuya salida es **inherentemente un flujo sin
# final**: con --follow no termina nunca. Un objeto no se puede emitir hasta
# que se acaba, así que la regla de §13.6b —por stdout un solo objeto— no se
# puede cumplir aquí sin romper el caso principal. Y con '--since 7d' sobre una
# web con tráfico, ese objeto serían cientos de megas acumulados en memoria de
# bash antes de imprimir el primer byte.
#
# Así que aquí va NDJSON: una línea de JSON por línea de log. La excepción se
# declara en vez de fingir que no existe, y para que un cliente no tenga que
# adivinar, **la primera línea es un 'meta' que lleva el schema** y dice qué
# viene detrás. Si el contrato de 'logs' cambiara, se vería ahí.
#
# Lo que NO se hace: sacarle a la línea el nivel, el módulo o el código HTTP.
# Sería inventar un formato que la aplicación del usuario no ha prometido, y es
# el primer paso hacia un parser de logs dentro de Orbit.
#
# La marca de tiempo se toma del propio log y no se inventa:
#   · journal    'journalctl -o short-iso' ya la da con huso.
#   · access     el log de nginx la lleva con huso: [29/Aug/2026:14:02:11 +0200]
#   · error      la lleva SIN huso: 2026/08/29 14:02:11. Sale sin huso, que es
#                ISO-8601 válido y quiere decir «hora local del servidor».
#                Ponerle el huso de hoy sería mentir en cuanto la línea sea de
#                antes de un cambio de horario.
#   · formato viejo de nginx, sin marca: 'ts' es null. Es el mismo null de
#     siempre —no se sabe— y el cliente puede ofrecer 'orbit nginx-rebuild' sin
#     parsear un aviso traducido.
# Sin marca de tiempo se emite un guion y NO un campo vacío. Motivo: "read" con
# IFS de tabulador trata el tabulador como espacio en blanco y se come el primer
# campo cuando está vacío, así que una línea sin fecha llegaba corrida — el
# texto acababa en "ts" y "text" salía en blanco. Con un centinela no hay campo
# vacío que colapsar.
#
# (Y este comentario va aquí y no dentro del programa de awk porque ahí lo
# rodean comillas simples de bash: un apóstrofo dentro cerraría la cadena. Lo
# cazó shellcheck con SC1078 después de que "bash -n" lo diera por bueno.)
_LOG_JSON_AWK='
BEGIN { meses = "JanFebMarAprMayJunJulAugSepOctNovDec"; OFS = "\t" }
{
  iso = ""
  if (substr($0,1,1) == "[") {
    mes = index(meses, substr($0,5,3))
    if (mes > 0) {
      iso = substr($0,9,4) "-" sprintf("%02d", (mes+2)/3) "-" substr($0,2,2) \
            "T" substr($0,14,2) ":" substr($0,17,2) ":" substr($0,20,2)
      hus = substr($0,23,5)
      if (hus ~ /^[+-][0-9][0-9][0-9][0-9]$/)
        iso = iso substr(hus,1,3) ":" substr(hus,4,2)
    }
  } else if (substr($0,5,1) == "/" && substr($0,8,1) == "/") {
    iso = substr($0,1,4) "-" substr($0,6,2) "-" substr($0,9,2) \
          "T" substr($0,12,2) ":" substr($0,15,2) ":" substr($0,18,2)
  }
  # El guion de aquí es un centinela, no un adorno: ver el comentario de arriba.
  print (iso == "" ? "-" : iso), $0
}'

# Convierte un flujo de «ISO<tab>texto» en líneas de JSON. Cuenta lo emitido en
# LOGJ_N para que 'end' pueda decir si se llegó al tope: un número corto sin
# avisar se lee como «hay poco log», que suele ser lo contrario de lo que pasa.
# Se le pasa la entrada por sustitución de proceso y NUNCA por una tubería:
# al final de una tubería el bucle corre en un subshell y LOGJ_N se pierde, o
# sea que 'end' anunciaría siempre cero líneas. Es la misma trampa que obliga a
# '_top_measure' a dejar su resultado en globales.
LOGJ_N=0        # líneas emitidas en total
LOGJ_TRUNC="no"  # ¿algún flujo llegó a su tope?
_log_json_stream() { # _log_json_stream <stream> <tope>   (entrada por stdin)
  local stream="$1" tope="${2:-0}" n=0 iso rest
  while IFS=$'\t' read -r iso rest || [[ -n "${iso:-}" ]]; do
    printf '{"event":"line","ts":'
    if [[ -n "$iso" && "$iso" != "-" ]]; then _j_str "$iso"; else printf 'null'; fi
    printf ',"stream":';  _j_str "$stream"
    printf ',"text":';    _j_str "$rest"
    printf '}\n'
    LOGJ_N=$(( LOGJ_N + 1 )); n=$(( n + 1 ))
  done
  # El tope de --lines es **por fuente**, igual que 'tail -n N f1 f2' da N de
  # cada fichero. Así que 'truncated' es «alguna fuente llegó a su tope», y no
  # se deduce del total: con el log de acceso y el de error, un total de 3 con
  # --lines 2 no dice nada por sí solo.
  (( tope > 0 && n >= tope )) && LOGJ_TRUNC="yes"
  return 0
}

_log_json_meta() { # _log_json_meta <app> <source> <unit|""> <since|""> <follow> <lines>
  printf '{"schema":%s,"event":"meta","app":' "$JSON_SCHEMA"; _j_str "$1"
  printf ',"source":'; _j_str "$2"
  printf ',"unit":';   if [[ -n "$3" ]]; then _j_str "$3"; else printf 'null'; fi
  printf ',"since":';  if [[ -n "$4" ]]; then _j_str "$4"; else printf 'null'; fi
  printf ',"follow":%s,"lines":%s}\n' "$(_j_bool "$5")" "$(_j_num "$6")"
}

# No hay 'end' cuando se sigue en vivo, y es lo correcto: un flujo que no
# termina no tiene final que anunciar. El cliente lo sabe porque el 'meta' de
# arriba se lo dijo con "follow":true.
_log_json_end() {
  printf '{"event":"end","lines":%s,"truncated":%s}\n' \
    "$LOGJ_N" "$([[ "$LOGJ_TRUNC" == "yes" ]] && printf 'true' || printf 'false')"
}

cmd_logs() {
  local name="" since="" lines="80" follow="" only_nginx="no"
  local -a pos=()
  while (( $# )); do
    case "$1" in
      --since|--desde)     since="${2:-}"; shift ;;
      --since=*|--desde=*) since="${1#*=}" ;;
      --lines|-n)          lines="${2:-}"; shift ;;
      --lines=*)           lines="${1#*=}" ;;
      --follow|-f)         follow="yes" ;;
      --no-follow)         follow="no" ;;
      --nginx|--web)       only_nginx="yes" ;;
      # El salto va como '\n' y no como un salto de verdad: la clave del
      # catálogo se escribe dentro de una cadena de bash, donde un salto real no
      # se puede poner, así que las dos nunca coincidirían y este mensaje jamás
      # se traduciría. Ahora el mensaje **es** el formato, y printf lo interpreta.
      -*) die "Opción desconocida: %s\n  uso: orbit logs [app] [--since 1h] [--lines 200] [--nginx] [-f]" "$1" ;;
      *) pos+=("$1") ;;
    esac
    shift
  done
  name="${pos[0]:-}"
  [[ "$lines" =~ ^[0-9]+$ ]] || die "--lines quiere un número, no '%s'" "$lines"

  local cut=""
  if [[ -n "$since" ]]; then
    cut="$(_since_stamp "$since")"
    [[ -n "$cut" ]] || die "No entiendo «%s» como momento. Prueba: 30m · 2h · 3d · hoy · ayer · '10:00' · 2026-08-01" "$since"
  fi
  # Por defecto se sigue en vivo. Con --since se ha pedido una ventana
  # concreta: se enseña y se sale, salvo que además se pida -f.
  #
  # Y con --json tampoco se sigue por defecto, que es la misma regla que
  # 'orbit top': en modo máquina, una foto. Quien quiera el flujo lo pide con
  # --follow. Esto invierte un defecto, y por eso conviene decirlo en voz alta:
  # no rompe a nadie, porque hasta ahora 'orbit logs --json' era un error.
  if [[ -z "$follow" ]]; then
    if [[ -n "$since" || "$JSON" == "yes" ]]; then follow="no"; else follow="yes"; fi
  fi

  # Un cliente no puede contestar a un selector, y 'pick_app' escribe por
  # stdout, que es donde va el NDJSON. Misma regla que 'info --json'.
  if [[ -z "$name" && "$JSON" == "yes" ]]; then
    die "uso: orbit logs <app> --json"
  fi
  [[ -n "$name" ]] || name="$(pick_app 'App')" || return 0
  load_app "$name"

  if needs_svc "$A_TYPE" && [[ "$only_nginx" == "no" ]]; then
    local -a jargs=(-u "$(svc_name "$name")" -n "$lines")
    [[ -n "$cut" ]] && jargs+=(--since "$(date -d "$(_since_expr "$since")" '+%Y-%m-%d %H:%M:%S')")
    if [[ "$follow" == "yes" ]]; then
      # Por $UI_FD y no por stdout a secas: con --json ahí va el NDJSON, y una
      # línea de cortesía traducida en medio lo convertiría en basura. Es la
      # regla de §13.6b, que hasta ahora este comando cumplía por no tener
      # contrato.
      jargs+=(-f); printf "  ${D}%s${R}\n" "$(t "Ctrl-C para salir")" >&"$UI_FD"
    fi
    if [[ "$JSON" == "yes" ]]; then
      _log_json_meta "$A_NAME" "journal" "$(svc_name "$name")" "$since" "$follow" "$lines"
      # -o short-iso da la marca con huso al principio de la línea; el resto se
      # deja tal cual. El 'sed' separa la primera palabra del resto con un
      # tabulador, que es lo que espera _log_json_stream.
      _log_json_stream "journal" "$lines" \
        < <(journalctl "${jargs[@]}" -o short-iso 2>/dev/null | sed 's/ /\t/')
      [[ "$follow" == "yes" ]] || _log_json_end
      return 0
    fi
    journalctl "${jargs[@]}"
    return 0
  fi

  local acc err
  acc="$(nginx_log_access "$A_NAME")"; err="$(nginx_log_error "$A_NAME")"
  if needs_svc "$A_TYPE"; then
    info "Logs de nginx de «%s». Los de la aplicación:  orbit logs %s" "$A_NAME" "$A_NAME"
  fi
  # Una app recién creada todavía no tiene ficheros de log, y 'tail' de algo que
  # no existe aborta. Mejor decir que aún no hay nada.
  local -a files=(); local f
  for f in "$acc" "$err"; do [[ -f "$f" ]] && files+=("$f"); done
  if (( ${#files[@]} == 0 )); then
    # Con --json esto no es un error: es una ventana vacía, y se dice con la
    # forma completa (meta + end) para que el cliente no tenga que distinguir
    # «no hay nada» de «se rompió» mirando un stdout en blanco (§13.6bb).
    if [[ "$JSON" == "yes" ]]; then
      _log_json_meta "$A_NAME" "nginx" "" "$since" "$follow" "$lines"
      _log_json_end
      return 0
    fi
    info "«%s» todavía no tiene logs de nginx. Aparecerán con la primera visita." "$A_NAME"
    return 0
  fi

  if [[ "$JSON" == "yes" ]]; then
    _log_json_meta "$A_NAME" "nginx" "" "$since" "$follow" "$lines"
    # Fichero a fichero y no 'tail' de los dos a la vez, que es lo que hace la
    # salida en prosa. Así cada línea sale con su 'stream', y distinguir el log
    # de acceso del de error es la primera pregunta de cualquiera que mira un
    # log de nginx — hoy se pierde, porque 'tail' los mezcla.
    local jf jstream
    for jf in "${files[@]}"; do
      [[ "$jf" == "$err" ]] && jstream="error" || jstream="access"
      if [[ -n "$cut" ]]; then
        _log_json_stream "$jstream" "$lines" \
          < <(awk -v CUT="$cut" "$_LOG_SINCE_AWK" "$jf" | tail -n "$lines" | awk "$_LOG_JSON_AWK")
      elif [[ "$follow" == "yes" ]]; then
        _log_json_stream "$jstream" "$lines" < <(tail -n "$lines" -f "$jf" | awk "$_LOG_JSON_AWK")
      else
        _log_json_stream "$jstream" "$lines" < <(tail -n "$lines" "$jf" | awk "$_LOG_JSON_AWK")
      fi
    done
    [[ "$follow" == "yes" ]] || _log_json_end
    return 0
  fi

  if [[ -n "$cut" ]]; then
    # tail -f no sabe de fechas: con ventana temporal se filtra y se termina.
    _log_has_time "$acc" \
      || warn "El log de acceso no lleva marca de tiempo. Regenéralo con:  orbit nginx-rebuild"
    _log_since "$cut" "${files[@]}" | tail -n "$lines"
    return 0
  fi
  [[ "$follow" == "yes" ]] && printf "  ${D}%s${R}\n" "$(t "Ctrl-C para salir")" >&"$UI_FD"
  local -a targs=(-n "$lines")
  [[ "$follow" == "yes" ]] && targs+=(-f)
  tail "${targs[@]}" "${files[@]}"
}

cmd_service() { # start|stop|restart
  need_root "$1"
  local action="$1" name="${2:-}"
  [[ -n "$name" ]] || name="$(pick_app 'App')" || return 0
  load_app "$name"
  needs_svc "$A_TYPE" || { info "'%s' es estática, no tiene servicio. Usa 'orbit deploy'." "$A_NAME"; return 0; }
  systemctl "$action" "$(svc_name "$name")"
  ok "%s → %s" "$(svc_name "$name")" "$action"
}

# ═══════════════════════════════════════════════════════ exec ═════════════
# Reproduce el entorno de la unidad de systemd: mismo directorio, mismo .env y
# las mismas variables en el mismo orden de precedencia. Si no coincidiera,
# sería una herramienta de depuración que miente.
#
# El .env se carga primero y las variables fijas después, igual que en la
# unidad, donde EnvironmentFile va antes que las líneas Environment. Un
# NODE_ENV escrito en el .env pierde, exactamente como en producción.
#
# COREPACK_HOME va con las fijas por el mismo motivo que en la unidad: si
# 'orbit exec <app> pnpm …' usara otra caché, resolvería otro pnpm que el de
# producción y depurar un fallo de arranque sería perseguir un fantasma.
#
# El PATH lleva tres añadidos y ninguno es de adorno. node_modules/.bin y
# .venv/bin porque son las herramientas de la app. La carpeta bin/ de la
# release, porque es donde el build de Go deja el binario, y así
# 'orbit exec <app> app' lanza exactamente lo que corre en producción. Y
# /usr/local/go/bin al final, por lo mismo que en _build_run: la instalación
# que recomienda go.dev no toca el PATH de nadie, y una herramienta de
# depuración que no encuentra 'go' en un servidor donde Go funciona miente
# sobre el estado de la máquina.
#
# Ojo al escribir aquí dentro: esto es una cadena entre comillas simples, así
# que una comilla simple en un comentario la cierra y parte el script en dos.
_exec_script='
  set -a
  [ -f "$1" ] && . "$1"
  set +a
  export NODE_ENV=production HOST=127.0.0.1
  [ -n "$2" ] && export PORT="$2"
  [ -n "$4" ] && export COREPACK_HOME="$4"
  export PATH="$3/node_modules/.bin:$3/.venv/bin:$3/bin:$PATH:/usr/local/go/bin"
  cd "$3" || exit 1
  shift 4
  exec "$@"
'

_run_in_dir() { # _run_in_dir <dir> <.env> <puerto> <comando...>
  local dir="$1" envf="$2" port="$3"; shift 3
  # A_NAME está cargada en todas las rutas que llegan aquí (exec, django,
  # _run_in_app). Si alguna vez no lo estuviera, se pasa vacío y el script deja
  # la variable sin tocar en vez de exportar una ruta a medio construir.
  local cph=""; [[ -n "${A_NAME:-}" ]] && cph="$(app_corepack "$A_NAME")"
  sudo -u "$(app_user)" -H bash -lc "$_exec_script" orbit-exec "$envf" "$port" "$dir" "$cph" "$@"
}

# Igual, pero sobre la release activa de una app ya cargada con load_app.
_run_in_app() { # _run_in_app <app> <comando...>
  local name="$1"; shift
  _run_in_dir "$(app_current "$name")" "$(app_shared "$name")/.env" "${A_PORT:-}" "$@"
}

cmd_exec() { # orbit exec <app> [comando...]
  need_root exec
  local name="${1:-}"; shift || true
  [[ -n "$name" ]] || name="$(pick_app 'App')" || return 0
  load_app "$name"

  local dir; dir="$(app_current "$name")"
  [[ -d "$dir" ]] || die "'%s' no tiene ninguna release activa. Ejecuta:  orbit deploy %s" "$A_NAME" "$name"
  local envf; envf="$(app_shared "$name")/.env"

  # Un solo argumento con espacios o metacaracteres es una orden de shell
  # ("orbit exec web 'a && b'"). En cualquier otro caso se ejecuta tal cual,
  # de forma que las comillas de cada argumento se respetan sin sorpresas.
  # Se llama 'argv' y no 'cmd' porque en main() hay una variable 'cmd' que es
  # una cadena, y el linter razona sobre los nombres de forma global (SC2178).
  local shellish='[[:space:]|&;<>()$`]'
  local -a argv
  if (( $# == 0 )); then
    argv=(bash)                     # shell interactiva heredando este entorno
  elif (( $# == 1 )) && [[ "$1" =~ $shellish ]]; then
    argv=(bash -lc "$1")
  else
    argv=("$@")
  fi

  # NODE_ENV=production hace que npm y pnpm se salten las devDependencies. Es
  # el fallo mejor documentado del proyecto: mejor avisar que repetirlo.
  # El aviso va a stderr: la salida de 'exec' es la del comando y tiene que
  # poder encadenarse en una tubería sin que Orbit meta líneas por medio.
  if [[ "$A_TYPE" != php && "$A_TYPE" != python && "$*" == *install* ]]; then
    warn "Aquí NODE_ENV=production, así que npm y pnpm se saltarán las devDependencies." >&2
    warn "Para instalar y compilar usa 'orbit deploy %s'." "$name" >&2
  fi

  # Sólo el nombre de la app: un comando puede llevar una contraseña delante y
  # el log no es sitio para secretos.
  logline "exec $name"
  _run_in_dir "$dir" "$envf" "${A_PORT:-}" "${argv[@]}"
}

# ═════════════════════════════════════════════════════ django ═════════════
# Los ajustes de Django son código Python: no se pueden leer con grep. La única
# forma correcta de saber dónde han quedado los estáticos es preguntárselo a
# Django, y eso sólo se puede hacer después del build, con el venv ya montado.
_django_probe() { # _django_probe <dir de la release> <.env> -> 6 líneas
  local dir="$1" envf="$2" sm
  sm="$(_django_settings_module "$dir/manage.py")"
  [[ -n "$sm" ]] || return 1
  _run_in_dir "$dir" "$envf" "" ./.venv/bin/python -c "
import os, json
os.environ.setdefault('DJANGO_SETTINGS_MODULE', '$sm')
import django
django.setup()
from django.conf import settings
for v in (settings.STATIC_URL, settings.STATIC_ROOT,
          settings.MEDIA_URL,  settings.MEDIA_ROOT):
    print(str(v or ''))
print(','.join(settings.ALLOWED_HOSTS or []))
print('1' if settings.DEBUG else '0')
" 2>/dev/null
}

_host_allowed() { # _host_allowed <dominio> <lista separada por comas>
  local host="$1" hosts="$2" h
  [[ -n "$hosts" ]] || return 1
  # Con 'read -ra' y no con 'for h in $hosts': la división sin comillas también
  # expande comodines, y ALLOWED_HOSTS = ['*'] —que en Django permite cualquier
  # host— se convertía en la lista de ficheros del directorio de turno. El '*'
  # no llegaba a compararse nunca, así que un Django perfectamente configurado
  # recibía en CADA despliegue el aviso de que iba a contestar 400 Bad Request.
  # Con un directorio vacío y 'nullglob' era aún peor: el bucle ni se ejecutaba.
  # Salió desplegando un Django de verdad: la web daba 200 y Orbit decía que no.
  local -a lista
  IFS=',' read -ra lista <<< "$hosts"
  for h in "${lista[@]}"; do
    [[ "$h" == "*" ]] && return 0
    [[ "$h" == "$host" ]] && return 0
    [[ "$h" == .* && "$host" == *"$h" ]] && return 0
    [[ "$h" == .* && "$host" == "${h#.}" ]] && return 0
  done
  return 1
}

# Guarda en la configuración dónde servir /static/ y /media/, y avisa de los
# tres fallos que más veces dejan una web de Django rota en un VPS.
_django_apply_settings() { # <app> <dir de la release> <.env>
  local name="$1" rel="$2" envf="$3"
  # Dos rutas otra vez, y por lo mismo que en _laravel_post_build: manage.py y
  # el venv están donde vive la app, pero STATIC_ROOT se guarda **relativo a la
  # raíz de la release**, que es de lo que habla el vhost. Con la app en
  # backend/, Django devuelve '<release>/backend/staticfiles' y el recorte de
  # abajo deja 'backend/staticfiles', que es exactamente lo que nginx necesita.
  local app; app="$(_app_root "$rel")"
  local -a v
  mapfile -t v < <(_django_probe "$app" "$envf" || true)
  if (( ${#v[@]} < 6 )); then
    warn "No he podido leer los ajustes de Django: nginx no servirá /static/."
    warn "Compruébalo con:  orbit exec %s '%s'" "$name" "$(_app_cd './.venv/bin/python manage.py check')"
    return 0
  fi
  A_STATIC_URL="${v[0]}"; A_STATIC_ROOT="${v[1]}"
  A_MEDIA_URL="${v[2]}";  A_MEDIA_ROOT="${v[3]}"
  local allowed="${v[4]}" debug="${v[5]}"

  # Rutas relativas a la release: la absoluta llevaría el nombre de esta
  # release y quedaría obsoleta en el siguiente despliegue.
  [[ "$A_STATIC_ROOT" == "$rel/"* ]] && A_STATIC_ROOT="${A_STATIC_ROOT#"$rel"/}"
  [[ "$A_MEDIA_ROOT"  == "$rel/"* ]] && A_MEDIA_ROOT="${A_MEDIA_ROOT#"$rel"/}"
  save_app

  if [[ -n "$A_STATIC_ROOT" ]]; then
    ok "nginx servirá %s desde %s" "${A_STATIC_URL}" "$A_STATIC_ROOT"
  else
    warn "STATIC_ROOT no está definido: Django no puede recopilar los estáticos"
    warn "y con DEBUG=False el sitio saldrá sin CSS. Añade a settings.py:"
    warn "  STATIC_ROOT = BASE_DIR / 'staticfiles'"
  fi

  # MEDIA_ROOT dentro de la release significa perder las subidas de los
  # usuarios en el siguiente despliegue: lo que escribe la app en caliente no
  # puede vivir en un directorio que el despliegue siguiente va a sustituir.
  if [[ -n "$A_MEDIA_ROOT" ]] && [[ "$A_MEDIA_ROOT" != /* ]]; then
    warn "MEDIA_ROOT está dentro de la release: lo que suban tus usuarios"
    warn "desaparecerá en el próximo despliegue. Apúntalo a una ruta estable:"
    warn "  MEDIA_ROOT = '%s/%s/shared/media'" "$APPS_DIR" "$name"
  fi

  if [[ "$debug" == "1" ]]; then
    warn "DEBUG=True en producción: expone trazas con rutas y variables."
    warn "Ponlo a False en settings.py o en el .env de la app."
  fi
  if ! _host_allowed "$A_DOMAIN" "$allowed"; then
    warn "%s no está en ALLOWED_HOSTS: Django responderá 400 Bad Request." "$A_DOMAIN"
    warn "Añádelo en settings.py (ALLOWED_HOSTS actual: %s)." "${allowed:-$(t "vacío")}"
  fi
}

# Lo que hay que hacer después del build de un Laravel, y **fuera** del shell
# del build. El motivo es sutil y cuesta un despliegue entero descubrirlo:
#
# _build_run arranca con «set -a; . ./.env; set +a», o sea que **exporta** las
# variables al entorno. Y Dotenv, que es quien lee el .env dentro de Laravel,
# usa createImmutable: no pisa lo que ya está en el entorno. Así que dentro del
# build gana la versión que ha interpretado bash, y en tiempo de petición
# —php-fpm, entorno limpio— gana la que interpreta Dotenv. Medido con
# APP_NAME='mi$app' en el .env:
#
#   entorno limpio, como php-fpm ......... mi$app   ← Dotenv
#   dentro del shell del build ........... mi       ← bash expandió $app
#
# Y 'config:cache' **congela** lo que vea. Con una contraseña que lleve un '$'
# dentro, la app queda desplegada con un valor truncado que no está escrito en
# ningún sitio, y el síntoma es un «authentication failed» sin explicación. Peor
# aún: sin config:cache la app funcionaría, porque leería el .env por Dotenv.
#
# Por eso esto va aparte, con el entorno tal y como lo verá php-fpm.
_laravel_post_build() { # _laravel_post_build <app> <release> <shared>
  local name="$1" rel="$2" shared="$3" out=""
  # artisan, public/ y database/ son de la app, y la app puede vivir en una
  # subcarpeta del repositorio. Son dos rutas distintas y las dos se usan aquí:
  # 'app' para todo lo que ejecuta o lee Laravel, y 'rel' para el 'rm -rf' de
  # los dos caminos que abortan, que tiene que llevarse **la release entera** y
  # no dejar media dentro de releases/.
  local app; app="$(_app_root "$rel")"

  # 1 · APP_KEY. Sin ella, la web devuelve 500 en todas las peticiones — y el
  #     build pasa igualmente: config:cache y route:cache salen con 0. Orbit
  #     crea el .env vacío, y 'key:generate' **sustituye** la línea APP_KEY=,
  #     no la crea: sin ella falla con «No APP_KEY variable was found».
  #     Sólo la primera vez: regenerarla en cada despliegue invalidaría las
  #     sesiones y todo lo que la app haya cifrado con la anterior, que es una
  #     pérdida de datos silenciosa.
  #
  #     El salto de línea antes de añadir nada no es paranoia: un .env traído a
  #     mano por scp o escrito con un printf sin '\n' final hacía que el
  #     'APP_KEY=' se pegara a la última línea. Medido: 'DB_PASSWORD=hunter2'
  #     pasaba a valer 'hunter2APP_KEY=', y como no quedaba ninguna línea
  #     APP_KEY= que sustituir, key:generate salía con 0 sin escribir la clave y
  #     Orbit anunciaba en verde una clave que no existía.
  [[ -s "$shared/.env" && -n "$(tail -c1 "$shared/.env")" ]] && printf '\n' >> "$shared/.env"
  grep -q '^APP_KEY=' "$shared/.env" 2>/dev/null || printf 'APP_KEY=\n' >> "$shared/.env"
  if [[ -z "$(_env_read "$shared/.env" APP_KEY || true)" ]]; then
    as_app "cd '$app' && php artisan key:generate --force" >/dev/null 2>&1 || true
    # El código de salida de artisan no vale: 'key:generate' sale con 0 y dice
    # «Application key set successfully» aunque no haya escrito nada. Lo que se
    # comprueba es el resultado.
    if [[ -n "$(_env_read "$shared/.env" APP_KEY || true)" ]]; then
      ok "APP_KEY generada (se queda en shared/.env, no se toca más)"
    else
      # Y esto sí aborta. Sin APP_KEY la web devuelve 500 en **todas** las
      # peticiones, y Laravel no tiene health check ni rollback automático —no
      # lleva unidad—, así que dejarlo pasar sustituye una web que funcionaba
      # por una que no, con el aviso perdido entre otras veinte líneas y el
      # resumen final diciendo que ha ido bien. Es el paso 4c de Go otra vez.
      err "Laravel no tiene APP_KEY y no he podido generarla: la web daría 500 en todo."
      info "Genérala tú y vuelve a desplegar:"
      info "  orbit exec %s '%s'" "$name" "$(_app_cd 'php artisan key:generate --force')"
      rm -rf "$rel"
      DEP_ERR="$(t "Laravel se quedó sin APP_KEY")"
      die "Nada tocado: la versión anterior sigue en producción."
    fi
  fi

  # 2 · storage:link. El enlace que crea es **absoluto** y lleva dentro el
  #     nombre de esta release, así que hay que rehacerlo en cada despliegue.
  #     --relative no vale: pide symfony/filesystem, que no es dependencia de
  #     producción de laravel/framework y un --no-dev no la instala. --force
  #     porque si ya existe, artisan lo dice y no lo rehace.
  #     Y antes, quitar de en medio un public/storage que sea una carpeta de
  #     verdad: '--force' sólo pisa enlaces, y sobre un directorio artisan dice
  #     «The [public/storage] link already exists» y **sale con 0**, dejando
  #     todas las subidas en 404 para siempre sin que nadie se entere. La
  #     carpeta es artefacto de release, no dato: se puede borrar.
  as_app "[ -L '$app/public/storage' ] || rm -rf '$app/public/storage'" >/dev/null 2>&1 || true
  as_app "cd '$app' && php artisan storage:link --force" >/dev/null 2>&1 \
    || warn "No he podido crear public/storage: las subidas no se verán."

  # 3 · las cachés que son artefactos de esta release. config.php y routes.php
  #     viven en bootstrap/cache/, que es **por release** y tiene que serlo:
  #     así vuelven atrás con el symlink en un rollback.
  #
  #     'view:cache' NO está aquí, y es a propósito: escribe en storage/, que es
  #     compartido, y hace un view:clear primero — o sea que la release nueva
  #     borraría las vistas compiladas de la anterior. Medido: 21 ficheros de r1
  #     antes, 0 después. Blade las compila sola en la primera petición, así que
  #     lo único que se ahorraría es eso, y lo que costaría es que una release
  #     escriba dentro del estado de otra.
  #
  #     Y esto también aborta, por dos motivos. El primero es el de siempre: sin
  #     unidad no hay health check ni rollback, así que una release rota se
  #     publica y se queda. El segundo es que 'config:cache' es el mejor
  #     comprobante previo que tiene esta clase de app — arranca Laravel entero
  #     y lee su configuración—: si falla aquí, tampoco iba a arrancar para el
  #     visitante, y falla **antes** de mover el symlink, que es gratis.
  #     Y con 'as_app', como los dos pasos de arriba: desde §5.3 la release es
  #     del usuario de la app, así que el fetcher no puede escribir en
  #     bootstrap/cache/. Corriendo esto como 'deploy' el artisan moría con
  #     «Failed to open stream: Permission denied» y el despliegue abortaba
  #     SIEMPRE — o sea que con el aislamiento puesto, que es como nace toda
  #     app desde la v1.0.3, Laravel no se podía desplegar en absoluto. Se
  #     quedó atrás al separar los dos papeles, y no lo vio nadie porque la
  #     suite doblaba as_deploy y as_app al mismo shell.
  if ! as_app "cd '$app' && php artisan config:cache && php artisan route:cache" >/dev/null 2>&1; then
    err "Laravel no ha podido cachear su configuración ni sus rutas."
    info "Suele ser que falta el vendor/, que php no está en el PATH del usuario"
    info "de despliegue, o que un proveedor revienta al arrancar. Míralo con:"
    info "  orbit exec %s '%s'" "$name" "$(_app_cd 'php artisan config:cache')"
    rm -rf "$rel"
    DEP_ERR="$(t "Laravel no arrancó para generar sus cachés")"
    die "Nada tocado: la versión anterior sigue en producción."
  fi

  # 4 · los avisos. Los tres dejan el build en verde y la web rota o insegura.
  local dbg drv qc
  dbg="$(_env_read "$shared/.env" APP_DEBUG || true)"
  if [[ "$dbg" == "true" || "$dbg" == "1" ]]; then
    warn "APP_DEBUG=true en producción: un error cualquiera enseña la traza"
    warn "completa, con rutas del servidor y el contenido de las variables."
  fi
  drv="$(_env_read "$shared/.env" DB_CONNECTION || true)"
  # Sin la línea en el .env también es sqlite: es el valor por defecto de
  # Laravel. Salió en el despliegue de prueba de un proyecto real —la portada
  # daba 500 al guardar la sesión— y mirando sólo la variable no se veía venir.
  # Sin DB_CONNECTION el aviso sale IGUAL, exista o no el fichero. La guarda
  # anterior pedía ver un database.sqlite, y así se saltaba justo el caso peor:
  # el esqueleto de Laravel no trae ese fichero —está en su .gitignore—, de modo
  # que una app recién clonada sin DB_CONNECTION no avisaba de nada y contestaba
  # 500 a todo. Que el fichero falte no es que no use sqlite: es que va a
  # estrellarse contra él.
  if [[ "$drv" == "sqlite" || -z "$drv" ]]; then
    # Dos cosas a la vez, y la segunda es la grave: install.sh instala
    # php-pgsql y php-mysql pero no php-sqlite3 —el error que sale si falta es
    # «could not find driver», que no dice qué instalar—, y el fichero de la
    # base de datos vive **dentro de la release**, así que el despliegue
    # siguiente se lleva por delante todos los datos.
    if [[ -f "$app/database/database.sqlite" ]]; then
      warn "Esta app usa sqlite, y el fichero vive dentro de la release: el"
      warn "despliegue siguiente se llevará los datos por delante."
    else
      # Y este es el caso que antes se saltaba: no hay fichero al que llevarse
      # los datos porque no hay fichero, y Laravel se estrella en cada petición.
      warn "Esta app va a usar sqlite y no hay fichero de base de datos: Laravel"
      warn "contestará 500 a todas las peticiones en cuanto toque la base."
    fi
    info "Pásala a PostgreSQL:  orbit db add %s" "$name"
    info "…o apunta DB_DATABASE a %s/%s/shared/, que sí sobrevive." "$APPS_DIR" "$name"
    info "Y el driver no viene instalado:  sudo apt-get install -y php%s-sqlite3" "$PHP_VER"
  fi
  # Una cola que nadie ejecuta no da ningún error: los trabajos se apilan en la
  # tabla y la web sigue contestando 200 mientras los correos no salen.
  # Comprobado. Con 'orbit queue enable' ya hay quien los ejecute (§18.9), así
  # que el aviso sólo tiene sentido mientras nadie lo haya activado.
  # Con la raíz de **esta** release y no la de 'current': aquí el symlink todavía
  # apunta a la anterior, y quien manda sobre la cola es el código que se acaba
  # de compilar.
  qc="$(_queue_connection "$name" "$app")"
  if [[ -n "$qc" && "$qc" != "sync" && "$qc" != "null" && "$A_QUEUE" != "yes" ]]; then
    warn "Esta app encola trabajos (QUEUE_CONNECTION=%s) y aquí no hay quien los ejecute." "$qc"
    info "Se apilarán sin dar ningún error. Enciende el temporizador:"
    info "  · por temporizador:  orbit queue enable %s" "$name"
    info "  · una vez a mano:    orbit queue run %s" "$name"
    info "  · o pon QUEUE_CONNECTION=sync si la app puede esperar."
  fi

  # 5 · el PHP del build contra el del pool. Si no son el mismo, composer
  #     resuelve para uno y php-fpm ejecuta con otro: el build sale en verde y
  #     el visitante ve un 500 de platform_check.php. Medido con un Laravel 13
  #     (que pide PHP ≥ 8.4.1) y el pool en 8.3.
  out="$(as_deploy "php -r 'echo PHP_MAJOR_VERSION.\".\".PHP_MINOR_VERSION;'" 2>/dev/null || true)"
  if [[ -n "$out" && "$out" != "$PHP_VER" ]]; then
    warn "El build compila con PHP %s y las páginas las sirve php%s-fpm." "$out" "$PHP_VER"
    warn "Si el composer.lock pide más de lo que tiene el pool, el build pasa y la"
    warn "web devuelve 500 con «Composer detected issues in your platform»."
  fi
  return 0
}

# ═══════════════════════════════════════════════ notificaciones ═══════════
# Capa compartida: la usa el watchdog y la querrán también los despliegues
# fallidos. Nunca aborta el proceso que la llama: un aviso que no sale no debe
# tumbar el arreglo que estaba en marcha.
NOTIFY_CONF="$ETC_DIR/notify.conf"

_notify_rank() { case "$1" in info) echo 0 ;; warn) echo 1 ;; crit) echo 2 ;; *) echo 1 ;; esac; }

# Cada canal, en su función y todos con la misma forma: reciben nivel, texto ya
# compuesto y mensaje pelado, no imprimen nada por la salida normal y devuelven
# el código de curl. Estaban los tres en línea dentro de notify() con un
# '|| true' pegado a cada uno, y eso es lo que hacía imposible decir **cuál**
# había fallado — que es justo lo que hay que saber de un canal de avisos.
_notify_ch_telegram() { # <nivel> <texto> <mensaje>
  curl -fsS -m 10 -o /dev/null -X POST \
    "https://api.telegram.org/bot${NOTIFY_TELEGRAM_TOKEN}/sendMessage" \
    --data-urlencode "chat_id=${NOTIFY_TELEGRAM_CHAT}" \
    --data-urlencode "text=$2"
}

_notify_ch_discord() {
  curl -fsS -m 10 -o /dev/null -H 'Content-Type: application/json' \
    -d "$(jq -cRn --arg c "$2" '{content:$c}')" "$NOTIFY_DISCORD"
}

_notify_ch_webhook() {
  curl -fsS -m 10 -o /dev/null -H 'Content-Type: application/json' \
    -d "$(jq -cRn --arg l "$1" --arg h "$(hostname -s 2>/dev/null || echo servidor)" \
          --arg m "$3" --arg t "$(date -Iseconds)" \
          '{level:$l,host:$h,message:$m,time:$t}')" "$NOTIFY_WEBHOOK"
}

# El correo va por un **relé** y no por un MTA local, y ésa es toda la razón por
# la que este canal no existía: un VPS limpio no tiene con qué enviar, casi
# todos los proveedores bloquean el puerto 25 de salida, y lo poco que sale sin
# reputación acaba en la carpeta de spam del destinatario. Con relé, el correo
# lo entrega quien ya sabe hacerlo —el proveedor de siempre, o el que use la
# empresa— y Orbit sólo habla SMTP con él, con curl, que ya es dependencia y lo
# sabe hacer desde hace veinte años. Cero dependencias nuevas (principio 6) y
# nada residente (principio 2).
_notify_mail_args() { # _notify_mail_args -> los argumentos de curl, uno por línea
  printf '%s\n' -fsS -m 20 -o /dev/null --url "$NOTIFY_SMTP_URL" \
    --mail-from "${NOTIFY_MAIL_FROM:-$NOTIFY_MAIL_TO}"
  local d
  # Varios destinatarios separados por coma o espacio: un aviso que sólo puede
  # ir a una persona se pierde en cuanto esa persona está de vacaciones.
  for d in ${NOTIFY_MAIL_TO//,/ }; do printf '%s\n' --mail-rcpt "$d"; done
  if [[ -n "${NOTIFY_SMTP_USER:-}" ]]; then
    printf '%s\n' --user "${NOTIFY_SMTP_USER}:${NOTIFY_SMTP_PASS:-}"
    # Con contraseña se exige TLS y no se negocia: un AUTH sin cifrar entrega
    # la contraseña del correo a cualquiera que mire la red. Sin contraseña no
    # se exige, porque ese caso es un relé en la propia máquina o en la red
    # local, donde no hay TLS que pedir y exigirlo sólo impediría usarlo.
    [[ "$NOTIFY_SMTP_URL" == smtps://* ]] || printf '%s\n' --ssl-reqd
  fi
}

_notify_ch_mail() { # <nivel> <texto> <mensaje>
  local -a args; mapfile -t args < <(_notify_mail_args)
  local host; host="$(hostname -s 2>/dev/null || echo servidor)"
  # El charset va declarado: los mensajes de Orbit llevan acentos y comillas
  # españolas, y sin la cabecera el cliente los pinta como bytes sueltos.
  {
    printf 'From: %s\n' "${NOTIFY_MAIL_FROM:-$NOTIFY_MAIL_TO}"
    printf 'To: %s\n' "$NOTIFY_MAIL_TO"
    printf 'Subject: [orbit] %s · %s\n' "$1" "$host"
    printf 'Date: %s\n' "$(date -R)"
    printf 'MIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\n\n'
    printf '%s\n' "$3"
    printf '\n-- \n%s · %s\n' "$host" "$(date -Iseconds)"
  } | curl "${args[@]}" --upload-file -
}

# Los canales que están configurados, uno por línea y en orden fijo.
_notify_channels() {
  [[ -n "${NOTIFY_TELEGRAM_TOKEN:-}" && -n "${NOTIFY_TELEGRAM_CHAT:-}" ]] && echo telegram
  [[ -n "${NOTIFY_DISCORD:-}" ]] && echo discord
  [[ -n "${NOTIFY_WEBHOOK:-}" ]] && echo webhook
  [[ -n "${NOTIFY_MAIL_TO:-}" && -n "${NOTIFY_SMTP_URL:-}" ]] && echo mail
  return 0
}

notify() { # notify <info|warn|crit> <mensaje>
  local lvl="${1:-info}" msg="${2:-}" text host ch
  [[ -r "$NOTIFY_CONF" ]] || return 0
  # shellcheck disable=SC1090
  . "$NOTIFY_CONF"
  (( $(_notify_rank "$lvl") >= $(_notify_rank "${NOTIFY_MIN_LEVEL:-warn}") )) || return 0
  host="$(hostname -s 2>/dev/null || echo servidor)"
  text="[$lvl] $host · $msg"

  # Aquí sí se traga el fallo, y a propósito: esto lo llama el vigilante a
  # mitad de un arreglo, y un aviso que no sale no puede tumbar lo que estaba
  # en marcha. Quien quiera saber si los canales funcionan tiene 'notify test',
  # que es lo que faltaba.
  for ch in $(_notify_channels); do
    "_notify_ch_$ch" "$lvl" "$text" "$msg" >/dev/null 2>&1 || true
  done
  return 0
}

notify_configured() {
  [[ -r "$NOTIFY_CONF" ]] || return 1
  # shellcheck disable=SC1090
  . "$NOTIFY_CONF"
  [[ -n "$(_notify_channels)" ]]
}

_notify_save() {
  local k
  install -d -m 0755 "$ETC_DIR"
  : > "$NOTIFY_CONF"
  printf '# Avisos de Orbit. Puede contener tokens: solo root puede leerlo.\n' >> "$NOTIFY_CONF"
  for k in NOTIFY_MIN_LEVEL NOTIFY_TELEGRAM_TOKEN NOTIFY_TELEGRAM_CHAT NOTIFY_DISCORD NOTIFY_WEBHOOK \
           NOTIFY_MAIL_TO NOTIFY_MAIL_FROM NOTIFY_SMTP_URL NOTIFY_SMTP_USER NOTIFY_SMTP_PASS; do
    printf '%s=%s\n' "$k" "$(_q "${!k-}")" >> "$NOTIFY_CONF"
  done
  chmod 0600 "$NOTIFY_CONF"
}

cmd_notify() {
  need_root notify
  _subcmd notify status noapp "setup test status" "$@"
  local sub="$SUBCMD"; set -- "${SUBCMD_ARGS[@]}"
  case "$sub" in
    setup)
      title "Avisos"
      case "$ORBIT_LANG_CODE" in
        en) cat <<EOF
  Fill in only the channel you use; leave the rest blank.

  ${B}Telegram${R}   talk to @BotFather, create a bot and copy its token.
             You get the chat by writing to it and opening
             https://api.telegram.org/bot<TOKEN>/getUpdates
  ${B}Discord${R}    Channel settings → Integrations → Webhooks → Copy URL
  ${B}Webhook${R}    any URL that accepts a POST with JSON
  ${B}Email${R}      through your own SMTP relay (Gmail app password, Fastmail,
             SES, whatever you already use). Orbit does not run an MTA:
             a clean VPS cannot deliver mail and port 25 is usually
             blocked, so what leaves from here would land in spam.

EOF
           ;;
        *) cat <<EOF
  Rellena solo el canal que uses; deja el resto en blanco.

  ${B}Telegram${R}   habla con @BotFather, crea un bot y copia su token.
             El chat lo sacas escribiéndole y abriendo
             https://api.telegram.org/bot<TOKEN>/getUpdates
  ${B}Discord${R}    Ajustes del canal → Integraciones → Webhooks → Copiar URL
  ${B}Webhook${R}    cualquier URL que acepte un POST con JSON
  ${B}Correo${R}     por un relé SMTP tuyo (contraseña de aplicación de Gmail,
             Fastmail, SES, el que ya uses). Orbit no monta un MTA: un
             VPS limpio no puede entregar correo y el puerto 25 suele
             estar bloqueado, así que lo que saliera de aquí iría a spam.

EOF
           ;;
      esac
      [[ -r "$NOTIFY_CONF" ]] && { # shellcheck disable=SC1090
        . "$NOTIFY_CONF"; }
      ask NOTIFY_TELEGRAM_TOKEN "Token de Telegram"   "${NOTIFY_TELEGRAM_TOKEN:-}"
      ask NOTIFY_TELEGRAM_CHAT  "Chat de Telegram"    "${NOTIFY_TELEGRAM_CHAT:-}"
      ask NOTIFY_DISCORD        "Webhook de Discord"  "${NOTIFY_DISCORD:-}"
      ask NOTIFY_WEBHOOK        "Webhook genérico"    "${NOTIFY_WEBHOOK:-}"
      ask NOTIFY_MAIL_TO        "Correo de destino"   "${NOTIFY_MAIL_TO:-}"
      if [[ -n "${NOTIFY_MAIL_TO:-}" ]]; then
        ask NOTIFY_SMTP_URL   "Servidor SMTP (smtps://host:465)" "${NOTIFY_SMTP_URL:-}"
        ask NOTIFY_MAIL_FROM  "Remitente"           "${NOTIFY_MAIL_FROM:-orbit@$(hostname -f 2>/dev/null || hostname)}"
        ask NOTIFY_SMTP_USER  "Usuario SMTP"        "${NOTIFY_SMTP_USER:-}"
        [[ -n "${NOTIFY_SMTP_USER:-}" ]] && ask NOTIFY_SMTP_PASS "Contraseña SMTP" "${NOTIFY_SMTP_PASS:-}"
      fi
      ask NOTIFY_MIN_LEVEL      "Nivel mínimo (info|warn|crit)" "${NOTIFY_MIN_LEVEL:-warn}"
      _notify_save
      ok "Guardado en %s (solo root puede leerlo)" "$NOTIFY_CONF"
      notify_configured && cmd_notify test || warn "No has configurado ningún canal: no se enviará nada."
      ;;
    test)
      notify_configured || die "No hay ningún canal configurado. Ejecuta:  orbit notify setup"
      # Canal a canal y diciendo la verdad de cada uno. Antes se llamaba a
      # 'notify', que se traga los fallos por diseño, y se anunciaba «Enviado»
      # pasara lo que pasara: un token caducado, un webhook borrado o una
      # contraseña mal escrita daban exactamente la misma línea verde. Un canal
      # de avisos que miente sobre sí mismo es peor que no tenerlo, porque uno
      # deja de mirar el servidor confiando en que ya avisará.
      title "Avisos"
      local ch rc fallos=0 salida texto
      texto="$(t "Prueba de avisos de Orbit. Si lees esto, funciona.")"
      for ch in $(_notify_channels); do
        # La forma entera de docs/DEVELOPMENT.md: dentro de un '||' el errexit se apaga y
        # el fallo del canal se perdería con él.
        set +e
        salida="$("_notify_ch_$ch" crit "[test] $(hostname -s 2>/dev/null) · $texto" "$texto" 2>&1)"
        rc=$?
        set -e
        if (( rc == 0 )); then
          ok "%s: enviado" "$ch"
        else
          fallos=$((fallos + 1))
          err "%s: no ha salido (curl %s)" "$ch" "$rc"
          # La última línea de curl es la que dice qué pasó de verdad
          # («Login denied», «Could not resolve host»). Sin ella, quien lee
          # tiene un número y ninguna pista.
          [[ -n "$salida" ]] && info "  %s" "${salida##*$'"'"'\n'"'"'}"
        fi
      done
      echo
      (( fallos == 0 )) || die "%s canal(es) no han podido enviar. Revísalos en %s" "$fallos" "$NOTIFY_CONF"
      info "Si no te llega nada aunque salga en verde, míralo en el destino: el aviso salió de aquí."
      ;;
    status)
      title "Avisos"
      if notify_configured; then
        # shellcheck disable=SC1090
        . "$NOTIFY_CONF"
        [[ -n "${NOTIFY_TELEGRAM_TOKEN:-}" ]] && ok "Telegram configurado (chat %s)" "${NOTIFY_TELEGRAM_CHAT:-?}"
        [[ -n "${NOTIFY_DISCORD:-}"        ]] && ok "Discord configurado"
        [[ -n "${NOTIFY_WEBHOOK:-}"        ]] && ok "Webhook configurado"
        [[ -n "${NOTIFY_MAIL_TO:-}"        ]] && ok "Correo a %s por %s" "$NOTIFY_MAIL_TO" "${NOTIFY_SMTP_URL:-?}"
        info "Nivel mínimo: %s" "${NOTIFY_MIN_LEVEL:-warn}"
        info "Pruébalo con:  orbit notify test"
      else
        info "Sin avisos configurados. Actívalos con:  orbit notify setup"
        info "Hay Telegram, Discord, webhook y correo por un relé SMTP tuyo."
      fi
      echo ;;
  esac
}

# ═══════════════════════════════════════════════ redirecciones ════════════
# Reescribe el fichero de reglas quitando las que tengan ese origen. Se escribe
# en un temporal y se mueve al final: si algo falla, el fichero anterior sigue
# entero y nginx sigue sirviendo lo mismo.
_redir_write() { # _redir_write <app> [origen_a_quitar] [línea_nueva]
  local app="$1" drop="${2:-}" add="${3:-}" f tmp line osrc
  f="$(redir_file "$app")"
  install -d -m 0755 "$ETC_DIR/redirects"
  tmp="$(mktemp)"
  if [[ -f "$f" ]]; then
    while IFS= read -r line; do
      read -r osrc _ <<<"$line" || true
      [[ -n "$drop" && "$osrc" == "$drop" ]] && continue
      printf '%s\n' "$line"
    done < "$f" > "$tmp"
  else
    printf '# Redirecciones de %s · una por línea:  origen destino [código] [noquery]\n' "$app" > "$tmp"
    printf '# Se regeneran en el vhost con cada despliegue. Edítalo con "orbit redirect".\n' >> "$tmp"
  fi
  [[ -n "$add" ]] && printf '%s\n' "$add" >> "$tmp"
  chmod 0644 "$tmp"
  mv "$tmp" "$f"
}

# Aplica los cambios al vhost y los deshace si nginx los rechaza.
_redir_apply() { # _redir_apply <app> <copia de seguridad>
  local app="$1" backup="$2"
  if render_nginx "$app"; then
    rm -f "$backup"
    return 0
  fi
  if [[ -s "$backup" ]]; then mv "$backup" "$(redir_file "$app")"; else rm -f "$(redir_file "$app")" "$backup"; fi
  render_nginx "$app" >/dev/null 2>&1 || true
  die "nginx ha rechazado la configuración. No he cambiado nada."
}

_redirect_add_domain() { # <viejo.com> <https://destino> <código>
  local from="$1" dst="$2" code="$3"
  [[ "$from" == *.* && "$from" != */* && "$from" != http* ]] \
    || die "'%s' no parece un dominio. Para una ruta hacen falta tres argumentos: orbit redirect add <app> <origen> <destino>" "$from"
  [[ "$dst" == http://* || "$dst" == https://* ]] \
    || die "El destino de un dominio debe ser una URL completa, con https:// delante."
  _redir_valid "$dst" || die "El destino no puede llevar espacios, comillas dobles ni ';'."
  dst="${dst%/}"

  # Si otra app ya sirve ese dominio —como principal o como alias— no se puede
  # crear la redirección. nginx acepta dos vhosts con el mismo server_name
  # avisando sólo por el log y se queda con uno según el orden de los include:
  # la redirección funcionaría o no según cómo se llamen los ficheros, y podría
  # tapar el dominio de la app existente en el siguiente nginx-rebuild.
  local owner; owner="$(domain_owner "$from" "$from")"
  [[ -n "$owner" ]] && die "El dominio '%s' ya lo sirve la app «%s». Quítaselo antes (orbit domain %s) o elige otro." "$from" "$owner" "$owner"

  # Copia de la configuración anterior: si nginx rechaza el vhost hay que dejar
  # el servidor exactamente como estaba, sin una redirección a medio crear.
  local backup="" existed="no"
  if app_exists "$from"; then
    load_app "$from"
    [[ "$A_TYPE" == "redirect" ]] \
      || die "Ya existe una app llamada '%s' de tipo %s. Elimínala antes con 'orbit remove %s'." "$from" "$A_TYPE" "$from"
    existed="si"; backup="$(mktemp)"; cp "$(app_conf "$from")" "$backup"
  fi
  A_NAME="$from"; A_DOMAIN="$from"; A_TYPE="redirect"
  A_REPO=""; A_BRANCH=""; A_ALIASES=""; A_PKG=""; A_BUILD=""; A_START=""
  A_OUTDIR=""; A_SPA="no"; A_PORT=""; A_DOCROOT=""; A_PYAPP=""; A_PYMGR=""
  A_PYFW=""; A_MIGRATE=""; A_STATIC_URL=""; A_STATIC_ROOT=""; A_MEDIA_URL=""
  A_MEDIA_ROOT=""; A_REDIRECT="$dst"; A_REDIRECT_CODE="$code"
  A_CREATED="${A_CREATED:-$(date -Iseconds)}"; A_LASTDEPLOY=""
  save_app
  if ! render_nginx "$from"; then
    if [[ "$existed" == "si" ]]; then
      mv "$backup" "$(app_conf "$from")"
      render_nginx "$from" >/dev/null 2>&1 || true
    else
      rm -f "$(app_conf "$from")" "$(nginx_file "$from")" \
            "$(nginx_link "$from")"
    fi
    die "nginx ha rechazado la configuración. No he cambiado nada."
  fi
  [[ -n "$backup" ]] && rm -f "$backup"
  ok "%s → %s (código %s, conservando ruta y consulta)" "$from" "$dst" "$code"
  if ! has_cert "$from"; then
    info "Emite el certificado para que funcione por HTTPS:  orbit ssl %s" "$from"
  fi
  logline "redirect domain $from $dst $code"
}

_redirect_add_path() { # <app> <origen> <destino> <código> <flags>
  local app="$1" src="$2" dst="$3" code="$4" flags="$5"
  app_exists "$app" || die "La app '%s' no existe. Mira 'orbit list'." "$app"
  [[ "$src" == /* || "$src" == '~'* ]] \
    || die "El origen debe empezar por '/' (o por '~' si es una expresión regular)."
  _redir_valid "$src" || die "El origen no puede llevar espacios, comillas dobles ni ';'."
  _redir_valid "$dst" || die "El destino no puede llevar espacios, comillas dobles ni ';'."
  [[ "$dst" == /* || "$dst" == http://* || "$dst" == https://* ]] \
    || die "El destino debe ser una ruta que empiece por '/' o una URL completa."

  local backup; backup="$(mktemp)"
  [[ -f "$(redir_file "$app")" ]] && cp "$(redir_file "$app")" "$backup"
  _redir_write "$app" "$src" "$src $dst $code${flags:+ $flags}"
  _redir_apply "$app" "$backup"
  if [[ -n "$flags" ]]; then
    ok "%s: %s → %s (código %s, %s)" "$app" "$src" "$dst" "$code" "$flags"
  else
    ok "%s: %s → %s (código %s)" "$app" "$src" "$dst" "$code"
  fi
  logline "redirect add $app $src"
}

_redirect_rm() { # <app> <origen>
  local app="${1:-}" src="${2:-}"
  [[ -n "$app" ]] || die "uso: orbit redirect rm <app> <origen>"
  if [[ -z "$src" ]]; then
    app_exists "$app" && { load_app "$app"; [[ "$A_TYPE" == "redirect" ]] && \
      die "'%s' es una redirección de dominio entero. Elimínala con:  orbit remove %s" "$app" "$app"; }
    die "uso: orbit redirect rm <app> <origen>"
  fi
  app_exists "$app" || die "La app '%s' no existe. Mira 'orbit list'." "$app"
  if ! _redir_rules "$app" | awk '{print $1}' | grep -qxF -- "$src"; then
    info "'%s' no tenía ninguna redirección para %s" "$app" "$src"
    return 0
  fi
  local backup; backup="$(mktemp)"
  cp "$(redir_file "$app")" "$backup"
  _redir_write "$app" "$src"
  _redir_apply "$app" "$backup"
  ok "Eliminada la redirección %s de %s" "$src" "$app"
  logline "redirect rm $app $src"
}

# Las mismas redirecciones que pinta la tabla, leídas de las mismas dos
# fuentes: A_REDIRECT para los dominios enteros y el fichero de reglas para las
# de ruta. 'kind' distingue las dos, que se configuran y se deshacen distinto.
_redirect_list_json() { # [app]
  local app="${1:-}" n rules sep="" src dst code flags
  printf '{"schema":%s,"redirects":[' "$JSON_SCHEMA"
  for n in $(app_names); do
    [[ -n "$app" && "$n" != "$app" ]] && continue
    load_app "$n"
    if [[ "$A_TYPE" == "redirect" ]]; then
      printf '%s{"app":%s,"kind":"domain","from":%s,"to":%s,"code":%s,"query":true}' \
        "$sep" "$(_j_str "$n")" "$(_j_str "$n")" "$(_j_str "$A_REDIRECT")" \
        "$(_j_num "${A_REDIRECT_CODE:-301}")"
      sep=","
    fi
    rules="$(_redir_rules "$n")"
    [[ -n "$rules" ]] || continue
    while read -r src dst code flags; do
      [[ -n "$src" ]] || continue
      # 'noquery' es la única bandera que existe hoy, y se publica como lo que
      # significa —si la cadena de consulta viaja— y no como su nombre interno.
      printf '%s{"app":%s,"kind":"path","from":%s,"to":%s,"code":%s,"query":%s}' \
        "$sep" "$(_j_str "$n")" "$(_j_str "$src")" "$(_j_str "$dst")" \
        "$(_j_num "${code:-301}")" \
        "$([[ "$flags" == *noquery* ]] && printf 'false' || printf 'true')"
      sep=","
    done <<<"$rules"
  done
  printf ']}\n'
}

_redirect_list() { # [app]
  local app="${1:-}" n rules
  [[ "$JSON" == "yes" ]] && { _redirect_list_json "$app"; return 0; }
  title "Redirecciones"
  local any=0
  for n in $(app_names); do
    [[ -n "$app" && "$n" != "$app" ]] && continue
    load_app "$n"
    if [[ "$A_TYPE" == "redirect" ]]; then
      printf "  ${B}%s${R} ${D}%s${R}\n" "$n" "$(t "(dominio entero)")"
      printf "      %-28s → %s\n" "/*" "$A_REDIRECT ${D}[$A_REDIRECT_CODE]${R}"
      any=1
    fi
    rules="$(_redir_rules "$n")"
    if [[ -n "$rules" ]]; then
      [[ "$A_TYPE" == "redirect" ]] || printf "  ${B}%s${R} ${D}(%s)${R}\n" "$n" "$A_DOMAIN"
      local src dst code flags
      while read -r src dst code flags; do
        [[ -n "$src" ]] || continue
        printf "      %-28s → %s ${D}[%s%s]${R}\n" "$src" "$dst" "${code:-301}" "${flags:+ $flags}"
      done <<<"$rules"
      any=1
    fi
  done
  (( any )) || info "No hay ninguna redirección configurada."
  echo
}

cmd_redirect() {
  need_root redirect
  _subcmd redirect list app "add rm|del|remove list|ls help|-h|--help|ayuda" "$@"
  local sub="$SUBCMD"; set -- "${SUBCMD_ARGS[@]}"
  [[ "$JSON" == "yes" && "$sub" != "list" ]] && die "--json sólo está en 'orbit redirect list'"
  case "$sub" in
    add)
      local -a pos=(); local code="301" flags="" a
      for a in "$@"; do
        case "$a" in
          --301|--302|--307|--308) code="${a#--}" ;;
          --no-query|--sin-consulta) flags="noquery" ;;
          -*) die "Opción desconocida: %s" "$a" ;;
          *)  pos+=("$a") ;;
        esac
      done
      case "${#pos[@]}" in
        2) _redirect_add_domain "${pos[0]}" "${pos[1]}" "$code" ;;
        3) _redirect_add_path "${pos[0]}" "${pos[1]}" "${pos[2]}" "$code" "$flags" ;;
        *) die "uso: orbit redirect add <app> <origen> <destino>   ·   orbit redirect add <viejo.com> <https://nuevo.com>" ;;
      esac ;;
    rm)   _redirect_rm "$@" ;;
    list) _redirect_list "$@" ;;
    help)
      case "$ORBIT_LANG_CODE" in
        en) cat <<EOF
  orbit redirect add <app> /old /new          Path redirect (301)
  orbit redirect add <app> '/blog/*' '/n/*'   Wildcard: keeps what follows
  orbit redirect add <app> '~^/p/(\\d+)\$' /x/\$1  Regular expression
  orbit redirect add old.com https://new.com  Whole domain
  orbit redirect list [app]                   See the ones there are
  orbit redirect rm <app> /old                Remove one

  Options:  --302 --307 --308   (301 by default)
            --no-query          do not keep the query string
EOF
           ;;
        *) cat <<EOF
  orbit redirect add <app> /vieja /nueva      Redirección de ruta (301)
  orbit redirect add <app> '/blog/*' '/n/*'   Comodín: conserva lo que sigue
  orbit redirect add <app> '~^/p/(\\d+)\$' /x/\$1  Expresión regular
  orbit redirect add viejo.com https://nuevo.com   Dominio entero
  orbit redirect list [app]                   Ver las que hay
  orbit redirect rm <app> /vieja              Quitar una

  Opciones:  --302 --307 --308   (por defecto 301)
             --no-query          no conservar la cadena de consulta
EOF
           ;;
      esac ;;
  esac
}

# ═══════════════════════════════════════════════════════ watch ════════════
# Orbit no tiene demonios. Esto lo invoca un temporizador de systemd cada
# minuto: el sistema operativo llama a un script, el script termina. Si Orbit
# desaparece, lo único que queda huérfano es un temporizador que se borra con
# 'systemctl disable orbit-watch.timer'.
WATCH_STATE="/var/lib/orbit/watch.state"
WATCH_LOG="/var/log/orbit/watch.log"
WATCH_LOCK="/var/lib/orbit/watch.lock"

declare -A WS_STATE WS_SINCE WS_TRIES WS_LAST
WATCH_EVENTS=0

_watch_state_load() {
  WS_STATE=(); WS_SINCE=(); WS_TRIES=(); WS_LAST=()
  [[ -f "$WATCH_STATE" ]] || return 0
  local subj st since tries last
  while read -r subj st since tries last; do
    [[ -z "$subj" || "$subj" == \#* ]] && continue
    WS_STATE["$subj"]="$st";      WS_SINCE["$subj"]="${since:-0}"
    WS_TRIES["$subj"]="${tries:-0}"; WS_LAST["$subj"]="${last:-0}"
  done < "$WATCH_STATE"
  return 0
}

_watch_state_save() {
  local tmp k
  install -d -m 0755 "$(dirname "$WATCH_STATE")"
  tmp="$(mktemp)"
  {
    printf '# Estado del watchdog de Orbit · %s\n' "$(date -Iseconds)"
    printf '# sujeto estado desde_epoch intentos ultimo_intento_epoch\n'
    for k in "${!WS_STATE[@]}"; do
      printf '%s %s %s %s %s\n' "$k" "${WS_STATE[$k]}" \
        "${WS_SINCE[$k]:-0}" "${WS_TRIES[$k]:-0}" "${WS_LAST[$k]:-0}"
    done | sort
  } > "$tmp"
  chmod 0644 "$tmp"
  mv "$tmp" "$WATCH_STATE"
}

_watch_log() { # _watch_log <sujeto> <texto>
  install -d -m 0755 "$(dirname "$WATCH_LOG")"
  printf '%s %-24s %s\n' "$(date -Iseconds)" "$1" "$2" >> "$WATCH_LOG"
}

# Registra y avisa SOLO cuando el estado cambia. Avisar del estado en lugar de
# la transición llenaría el teléfono con el mismo mensaje cada minuto mientras
# dure la avería, y a la tercera vez nadie los lee.
_watch_to() { # _watch_to <sujeto> <estado> <nivel> <mensaje>
  local subj="$1" st="$2" lvl="$3" msg="$4" prev
  prev="${WS_STATE[$subj]:-ok}"
  WS_STATE["$subj"]="$st"
  [[ "$prev" == "$st" ]] && return 0
  WS_SINCE["$subj"]="$(date +%s)"
  WATCH_EVENTS=$((WATCH_EVENTS + 1))
  _watch_log "$subj" "$prev → $st · $msg"
  case "$st" in
    ok) ok "%s" "$msg" ;;
    rendido) err "%s" "$msg" ;;
    *) warn "%s" "$msg" ;;
  esac
  notify "$lvl" "$msg"
}

_watch_ok() { # _watch_ok <sujeto> <mensaje de recuperación>
  local subj="$1"
  WS_TRIES["$subj"]=0
  _watch_to "$subj" ok info "$2"
}

# Anota un estado en el fichero del vigilante desde fuera de él, para que otro
# comando pueda avisar de una transición sin duplicar la lógica de «avisa una
# vez, no una vez por minuto». Lo usa el autodespliegue con los remotos que no
# contestan: el fallo dura horas y el temporizador pasa cada pocos minutos.
#
# Se toma el mismo cerrojo que 'orbit watch', que reescribe ese fichero cada
# minuto: sin él, las dos escrituras se pisarían. La sección crítica es sólo
# leer-modificar-escribir, nunca un despliegue entero.
_watch_mark() { # _watch_mark <sujeto> <estado|ok> <nivel> <mensaje>
  local subj="$1" st="$2" lvl="$3" msg="$4"
  install -d -m 0755 "$(dirname "$WATCH_LOCK")" 2>/dev/null || return 0
  (
    exec 9>"$WATCH_LOCK" || exit 0
    flock -w 10 9 || exit 0
    _watch_state_load
    if [[ "$st" == "ok" ]]; then _watch_ok "$subj" "$msg"; else _watch_to "$subj" "$st" "$lvl" "$msg"; fi
    _watch_state_save
  ) || true
}

# Un servicio caído se reinicia, pero con freno. Un watchdog que reinicia en
# bucle una app rota consume el servidor y esconde el problema: es peor que no
# tener watchdog.
_watch_down() { # _watch_down <sujeto> <unidad> <descripción>
  local subj="$1" unit="$2" desc="$3" now tries
  now="$(date +%s)"
  tries="${WS_TRIES[$subj]:-0}"
  # La ventana se reinicia sola: tres reinicios en diez minutos son un bucle;
  # tres repartidos a lo largo del día son tres incidentes distintos.
  (( now - ${WS_LAST[$subj]:-0} > WATCH_WINDOW )) && tries=0
  if (( tries >= WATCH_MAX_TRIES )); then
    _watch_to "$subj" rendido crit \
      "$(t "%s sigue sin responder tras %s reinicios en %s min. Dejo de intentarlo." "$desc" "$tries" "$((WATCH_WINDOW / 60))")"
    return 0
  fi
  tries=$(( tries + 1 ))
  WS_TRIES["$subj"]="$tries"; WS_LAST["$subj"]="$now"
  systemctl restart "$unit" >/dev/null 2>&1 || true
  if (( tries == 1 )); then
    _watch_to "$subj" fallo warn "$(t "%s no respondía. La he reiniciado." "$desc")"
  else
    WS_STATE["$subj"]="fallo"
    _watch_log "$subj" "reinicio $tries de $WATCH_MAX_TRIES"
    WATCH_EVENTS=$((WATCH_EVENTS + 1))
    warn "%s sigue caída. Reinicio %s de %s." "$desc" "$tries" "$WATCH_MAX_TRIES"
  fi
}

# Un aviso puro: nada que reiniciar, solo avisar. Borrar ficheros o matar
# procesos por nuestra cuenta convertiría un aviso en una pérdida de datos.
_watch_warn() { # _watch_warn <sujeto> <condición 0|1> <nivel> <msg fallo> <msg vuelta>
  if (( $2 )); then _watch_to "$1" alerta "$3" "$4"; else _watch_ok "$1" "$5"; fi
}

_watch_service() { # _watch_service <unidad> <descripción>
  local unit="$1" desc="$2"
  systemctl list-unit-files "$unit.service" >/dev/null 2>&1 || return 0
  systemctl is-enabled --quiet "$unit" 2>/dev/null || return 0
  if systemctl is-active --quiet "$unit" 2>/dev/null; then
    _watch_ok "svc:$unit" "$(t "%s ha vuelto" "$desc")"
  else
    _watch_down "svc:$unit" "$unit" "$desc"
  fi
}

_watch_apps() {
  local n subj
  for n in $(app_names); do
    load_app "$n"
    needs_svc "$A_TYPE" || continue
    subj="app:$n"
    # Responder en el puerto es lo que importa: una unidad "activa" cuyo
    # proceso se ha quedado colgado no sirve de nada a un visitante.
    if curl -fsS -o /dev/null -m 5 "http://127.0.0.1:$A_PORT/" 2>/dev/null; then
      _watch_ok "$subj" "$(t "«%s» vuelve a responder" "$n")"
    elif systemctl is-active --quiet "$(svc_name "$n")" 2>/dev/null \
         && curl -sS -o /dev/null -m 5 "http://127.0.0.1:$A_PORT/" 2>/dev/null; then
      # Contesta aunque sea con un error HTTP: el proceso está vivo.
      _watch_ok "$subj" "$(t "«%s» vuelve a responder" "$n")"
    else
      _watch_down "$subj" "$(svc_name "$n")" "$(t "La app «%s» (%s)" "$n" "$A_DOMAIN")"
    fi
  done
}

_watch_disk() {
  local used
  used="$(df --output=pcent / | tail -1 | tr -dc '0-9')"
  _watch_warn "disco" "$(( used >= WATCH_DISK_MAX ))" warn \
    "$(t "Disco al %s%% (umbral %s%%). Mira 'ncdu /' o poda releases." "$used" "$WATCH_DISK_MAX")" \
    "$(t "Disco otra vez por debajo del %s%% (%s%%)" "$WATCH_DISK_MAX" "$used")"
}

_watch_mem() {
  local total avail pct
  total="$(awk '/^MemTotal:/{print $2}' /proc/meminfo)"
  avail="$(awk '/^MemAvailable:/{print $2}' /proc/meminfo)"
  (( total > 0 )) || return 0
  pct=$(( avail * 100 / total ))
  _watch_warn "memoria" "$(( pct <= WATCH_MEM_MIN ))" warn \
    "$(t "Solo queda un %s%% de memoria disponible (umbral %s%%)." "$pct" "$WATCH_MEM_MIN")" \
    "$(t "Memoria recuperada: %s%% disponible" "$pct")"
}

# Un mantenimiento se pone para un rato. Si lleva horas puesto, o lo dejó un
# despliegue que murió de mala manera, o alguien se olvidó: en los dos casos
# hay una web devolviendo 503 a todo el mundo sin que nadie lo sepa.
_watch_maint() {
  local n edad
  for n in $(app_names); do
    load_app "$n"
    if _maint_is_on "$n"; then
      edad=$(( ( $(date +%s) - $(stat -c %Y "$(maint_flag "$n")" 2>/dev/null || date +%s) ) / 60 ))
      _watch_warn "mant:$n" "$(( edad >= WATCH_MAINT_MAX ))" warn \
        "$(t "«%s» lleva %s min en mantenimiento y responde 503. Quítalo con 'orbit maintenance off %s'." "$n" "$edad" "$n")" \
        "$(t "«%s» ha salido de mantenimiento" "$n")"
    else
      _watch_ok "mant:$n" "$(t "«%s» ha salido de mantenimiento" "$n")"
    fi
  done
  return 0
}

_watch_certs() {
  local n left
  for n in $(app_names); do
    load_app "$n"
    left="$(cert_days_left "$A_DOMAIN")"
    [[ -n "$left" ]] || continue
    _watch_warn "cert:$A_DOMAIN" "$(( left < WATCH_CERT_DAYS ))" crit \
      "$(t "El certificado de %s caduca en %s días. Renueva con 'orbit ssl %s'." "$A_DOMAIN" "$left" "$n")" \
      "$(t "El certificado de %s vuelve a estar vigente (%s días)" "$A_DOMAIN" "$left")"
  done
}

_watch_run() {
  _watch_state_load
  _watch_service nginx "nginx"
  _watch_service postgresql "PostgreSQL"
  _watch_service "php${PHP_VER}-fpm" "php-fpm"
  _watch_apps
  _watch_disk
  _watch_mem
  _watch_maint
  _watch_certs
  _watch_state_save
}

# El mismo estado que pinta la tabla, leído de los mismos arrays. Los sujetos
# van con su prefijo tal cual —'app:web', 'cert:web.test', 'remoto:web'—
# porque es la clave con la que el watchdog los guarda y con la que se pueden
# cruzar con el fichero de estado.
_watch_report_json() {
  local k sep="" caidas=0 avisos=0 activo="false"
  # Si el temporizador está parado, los sujetos que se enseñan son historia y no
  # estado: nadie los está mirando. Un cliente que no pueda distinguirlo pinta
  # un panel en verde sobre una vigilancia apagada. En texto se dice con una
  # línea, así que aquí tiene que haber un campo.
  systemctl is-active --quiet orbit-watch.timer 2>/dev/null && activo="true"
  printf '{"schema":%s,"timer_active":%s,"subjects":[' "$JSON_SCHEMA" "$activo"
  for k in $(printf '%s\n' "${!WS_STATE[@]}" | sort); do
    case "${WS_STATE[$k]}" in
      ok) ;;
      rendido) caidas=$((caidas + 1)) ;;
      *) avisos=$((avisos + 1)) ;;
    esac
    printf '%s{"subject":%s,"state":%s,"since":%s,"tries":%s,"last_try":%s}' \
      "$sep" "$(_j_str "$k")" "$(_j_str "${WS_STATE[$k]}")" \
      "$(_j_num "${WS_SINCE[$k]:-0}")" "$(_j_num "${WS_TRIES[$k]:-0}")" \
      "$(_j_num "${WS_LAST[$k]:-0}")"
    sep=","
  done
  printf '],"summary":{"total":%s,"down":%s,"warning":%s}}\n' \
    "${#WS_STATE[@]}" "$caidas" "$avisos"
}

_watch_report() {
  [[ "$JSON" == "yes" ]] && { _watch_report_json; return 0; }
  title "Vigilancia"
  local k any=0
  for k in $(printf '%s\n' "${!WS_STATE[@]}" | sort); do
    case "${WS_STATE[$k]}" in
      ok) printf "  ${GRN}%s${R} %-28s %s\n" "$G_ON" "$k" "$(t "correcto")" ;;
      rendido) printf "  ${RED}%s${R} %-28s ${RED}%s${R}\n" "$G_OFF" "$k" "$(t "caída, me he rendido")"; any=1 ;;
      *) printf "  ${YEL}%s${R} %-28s %s\n" "$G_MID" "$k" "${WS_STATE[$k]}"; any=1 ;;
    esac
  done
  (( ${#WS_STATE[@]} )) || info "Nada que vigilar todavía."
  echo
  (( any )) && info "Detalle:  orbit watch --history"
  return 0
}

_watch_timer_write() {
  cat > "$(watch_service)" <<EOF
[Unit]
Description=Orbit · comprobación de salud
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/orbit watch --quiet
EOF
  cat > "$(watch_unit)" <<EOF
[Unit]
Description=Orbit · comprobación de salud cada minuto

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s
Unit=orbit-watch.service

[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload 2>/dev/null \
    || warn "systemd no ha recargado las unidades. ¿Estás en un contenedor sin systemd?"
}

cmd_watch() {
  need_root watch
  # Aquí no caben apps: la vigilancia mira el servidor entero.
  _subcmd watch once noapp "enable disable status history|--history once|--once quiet|--quiet|-q" "$@"
  local sub="$SUBCMD"; set -- "${SUBCMD_ARGS[@]}"
  [[ "$JSON" == "yes" && "$sub" != "status" ]] && die "--json sólo está en 'orbit watch status'"
  case "$sub" in
    enable)
      _watch_timer_write
      systemctl enable --now orbit-watch.timer >/dev/null 2>&1 || true
      ok "Vigilancia activada: un temporizador de systemd llamará a 'orbit watch' cada minuto"
      info "No hay ningún proceso residente. Compruébalo con:  systemctl list-timers orbit-watch.timer"
      notify_configured || warn "Sin avisos configurados: se reiniciará lo caído, pero no te enterarás. 'orbit notify setup'"
      logline "watch enable" ;;
    disable)
      systemctl disable --now orbit-watch.timer >/dev/null 2>&1 || true
      ok "Vigilancia desactivada"
      logline "watch disable" ;;
    status)
      # Con --json, por la salida normal no puede ir **nada** que no sea el
      # JSON. Estas dos líneas son para una persona, y colándose delante del
      # objeto convertían 'orbit watch status --json | jq' en un error de
      # sintaxis: el contrato de §13.1 roto por un adorno.
      if [[ "$JSON" != "yes" ]]; then
        if systemctl is-active --quiet orbit-watch.timer 2>/dev/null; then
          ok "Temporizador activo"
          systemctl list-timers orbit-watch.timer --no-pager 2>/dev/null | sed -n '2p;3p' | sed 's/^/  /'
        else
          info "Temporizador parado. Actívalo con:  orbit watch enable"
        fi
      fi
      _watch_state_load; _watch_report ;;
    history)
      if [[ -f "$WATCH_LOG" ]]; then
        title "Historial de vigilancia"
        tail -n "${1:-40}" "$WATCH_LOG" | sed 's/^/  /'
        echo
        info "Solo se anotan los cambios: un servidor sano no escribe nada aquí."
      else
        info "Todavía no ha pasado nada digno de anotar."
      fi ;;
    quiet)
      # En modo silencioso no se imprime el resumen final, pero los cambios de
      # estado sí salen: van al journal a través de la unidad del temporizador.
      # Un servidor sano no imprime nada, que es lo que se busca.
      # Si la comprobación anterior sigue en marcha, esta sobra: dos a la vez
      # se pisarían el fichero de estado.
      install -d -m 0755 "$(dirname "$WATCH_LOCK")"
      exec 9>"$WATCH_LOCK"
      flock -n 9 || exit 0
      _watch_run ;;
    once)
      install -d -m 0755 "$(dirname "$WATCH_LOCK")"
      exec 9>"$WATCH_LOCK"
      flock -n 9 || die "Ya hay otra comprobación en marcha."
      _watch_run
      _watch_report ;;
  esac
}

# ═══════════════════════════════════════════ despliegue automático ═══════
# Se sondea con un temporizador en lugar de recibir un webhook. Un webhook
# exigiría un proceso escuchando en un puerto, superficie de ataque entrante
# y un secreto que verificar, y si ese proceso muere los despliegues dejan de
# ocurrir en silencio. El sondeo cuesta un 'git ls-remote' por app y ciclo, no
# abre nada hacia dentro y se ve en 'systemctl list-timers'. El razonamiento
# completo está en ARCHITECTURE §4.
# Las rutas de las unidades, en un sitio: las pruebas las sustituyen para no
# escribir en /etc/systemd del equipo donde se ejecutan.
autodeploy_unit()    { echo "/etc/systemd/system/orbit-autodeploy.timer"; }
autodeploy_service() { echo "/etc/systemd/system/orbit-autodeploy.service"; }

_autodeploy_timer_write() {
  cat > "$(autodeploy_service)" <<EOF
[Unit]
Description=Orbit · desplegar las apps cuya rama ha avanzado
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/orbit deploy --all --auto --quiet
EOF
  cat > "$(autodeploy_unit)" <<EOF
[Unit]
Description=Orbit · comprobar cada ${AUTODEPLOY_EVERY} min si hay commits nuevos

[Timer]
OnBootSec=3min
OnUnitActiveSec=${AUTODEPLOY_EVERY}min
AccuracySec=20s
Unit=orbit-autodeploy.service

[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload 2>/dev/null \
    || warn "systemd no ha recargado las unidades. ¿Estás en un contenedor sin systemd?"
}

# Una línea de estado. Espera que load_app ya haya cargado la app, y que el
# estado del vigilante esté leído si se quiere ver el remoto mudo.
_autodeploy_line() { # _autodeploy_line <app>
  local remoto="${WS_STATE[remoto:$1]:-ok}"
  if [[ "$remoto" == "sin-contacto" ]]; then
    printf "  ${RED}%s${R} %-18s %s ${D}%s${R}\n" "$G_OFF" "$1" "$A_BRANCH" "$(t "(no consigo hablar con el remoto)")"
    return 0
  fi
  if [[ "$remoto" == "sin-rama" ]]; then
    printf "  ${RED}%s${R} %-18s %s ${D}%s${R}\n" "$G_OFF" "$1" "$A_BRANCH" "$(t "(esa rama ya no existe en el remoto)")"
    return 0
  fi
  if [[ -n "$A_AUTOFAIL" ]]; then
    printf "  ${RED}%s${R} %-18s %s ${D}%s${R}\n" "$G_OFF" \
      "$1" "$A_BRANCH" "$(t "(commit %s falló; espero uno nuevo)" "${A_AUTOFAIL:0:7}")"
  else
    printf "  ${GRN}%s${R} %-18s %s ${D}%s${R}\n" "$G_ON" \
      "$1" "$A_BRANCH" "$(t "(desplegado %s)" "${A_LASTDEPLOY:-$(t "nunca")}")"
  fi
}

_autodeploy_enabled_apps() {
  local n
  for n in $(app_names); do
    load_app "$n"
    [[ "$A_AUTODEPLOY" == "yes" ]] && printf '%s\n' "$n"
  done
  return 0
}

cmd_autodeploy() {
  need_root autodeploy
  _subcmd autodeploy status app "enable|on disable|off every|cada once|--once status" "$@"
  local sub="$SUBCMD"; set -- "${SUBCMD_ARGS[@]}"
  local name="${1:-}"
  case "$sub" in
    enable)
      [[ -n "$name" ]] || name="$(pick_app 'App a desplegar sola')" || return 0
      load_app "$name"
      [[ "$A_TYPE" == "redirect" ]] && die "'%s' es una redirección: no tiene código que desplegar." "$A_NAME"
      [[ -n "$A_REPO" ]] || die "'%s' no tiene repositorio." "$A_NAME"
      A_AUTODEPLOY="yes"; A_AUTOFAIL=""; save_app
      _autodeploy_timer_write
      systemctl enable --now orbit-autodeploy.timer >/dev/null 2>&1 || true
      ok "«%s» se desplegará sola cuando avance %s" "$name" "$A_BRANCH"
      info "Se comprueba cada %s min con 'git ls-remote'. Sin puertos abiertos ni webhooks." "${AUTODEPLOY_EVERY}"
      notify_configured || warn "Sin avisos configurados no te enterarás si un despliegue falla: 'orbit notify setup'"
      logline "autodeploy enable $name" ;;
    disable)
      [[ -n "$name" ]] || name="$(pick_app 'App')" || return 0
      load_app "$name"
      A_AUTODEPLOY="no"; A_AUTOFAIL=""; save_app
      ok "«%s» ya no se despliega sola" "$name"
      if [[ -z "$(_autodeploy_enabled_apps)" ]]; then
        systemctl disable --now orbit-autodeploy.timer >/dev/null 2>&1 || true
        # Y se apaga la luz roja que pueda haber quedado. Una pasada fallida
        # deja la unidad en 'failed' a propósito —es el aviso de que el
        # automático no funciona— y la pasada siguiente la pone en verde sola.
        # Retirando el temporizador ya no hay pasada siguiente: ese 'failed' se
        # queda para siempre, y con él un servidor que se lee como «degraded»
        # por una unidad que nadie va a volver a ejecutar. Visto en un VPS.
        systemctl reset-failed orbit-autodeploy.service >/dev/null 2>&1 || true
        info "Ninguna app queda en automático: temporizador detenido."
      fi
      logline "autodeploy disable $name" ;;
    every)
      local mins="${1:-}"
      [[ "$mins" =~ ^[0-9]+$ ]] && (( mins >= 1 && mins <= 1440 )) \
        || die "uso: orbit autodeploy every <minutos>   (entre 1 y 1440)"
      _conf_set AUTODEPLOY_EVERY "$mins"
      # Reescribir la unidad no basta: el intervalo va dentro y systemd ya la
      # tiene cargada, así que hay que reiniciar el temporizador.
      if [[ -n "$(_autodeploy_enabled_apps)" ]]; then
        _autodeploy_timer_write
        systemctl restart orbit-autodeploy.timer >/dev/null 2>&1 || true
        ok "Se comprobará cada %s min, y el temporizador ya lo usa" "$mins"
      else
        ok "Guardado: se comprobará cada %s min cuando actives alguna app" "$mins"
      fi
      logline "autodeploy every $mins" ;;
    once)
      cmd_deploy_all --auto ;;
    status)
      title "Despliegue automático"
      # De sólo lectura y sin cerrojo: es para pintar, y como mucho se pierde
      # una transición que se verá en la siguiente pasada.
      _watch_state_load
      if [[ -n "$name" ]]; then
        app_exists "$name" || die "No existe ninguna app llamada «%s»." "$name"
        load_app "$name"
        if [[ "$A_AUTODEPLOY" == "yes" ]]; then
          _autodeploy_line "$name"
        else
          info "«%s» no se despliega sola. Actívalo con:  orbit autodeploy enable %s" "$name" "$name"
        fi
        echo
        return 0
      fi
      local -a on
      mapfile -t on < <(_autodeploy_enabled_apps)
      if (( ${#on[@]} == 0 )); then
        info "Ninguna app se despliega sola. Actívalo con:  orbit autodeploy enable <app>"
      else
        if systemctl is-active --quiet orbit-autodeploy.timer 2>/dev/null; then
          ok "Temporizador activo, cada %s min" "${AUTODEPLOY_EVERY}"
          # El intervalo queda escrito dentro de la unidad. Si alguien edita
          # orbit.conf a mano, la unidad se queda con el valor viejo y el
          # cambio no surte efecto: mejor decirlo que dejarlo pasar.
          local en_unidad
          en_unidad="$(grep -oP 'OnUnitActiveSec=\K[0-9]+' "$(autodeploy_unit)" 2>/dev/null || true)"
          if [[ -n "$en_unidad" && "$en_unidad" != "$AUTODEPLOY_EVERY" ]]; then
            warn "El temporizador sigue con %s min: aplícalo con  orbit autodeploy every %s" "$en_unidad" "$AUTODEPLOY_EVERY"
          fi
        else
          warn "Hay apps en automático pero el temporizador está parado: 'orbit autodeploy enable <app>'"
        fi
        local n
        for n in "${on[@]}"; do
          load_app "$n"; _autodeploy_line "$n"
        done
      fi
      echo ;;
  esac
}

# ═══════════════════════════════════════════════════════ colas ════════════
# La cola de Laravel, por temporizador y no con un worker residente. El
# razonamiento largo está en ARCHITECTURE §18.9; en corto, un 'queue:work' que
# no termina nunca rompe tres cosas. Carga el código una vez y no lo suelta,
# así que tras mover el symlink php-fpm sirve la release nueva y el worker
# sigue con la vieja. La respuesta de Laravel a eso —'queue:restart'— no
# reinicia nada: escribe una señal en la caché y cada worker sale cuando la ve,
# con lo que la corrección del despliegue pasaría a depender de que el
# CACHE_STORE esté bien configurado. Y nada de lo que Orbit ya tiene sabría
# mirar esa unidad: 'watch' reinicia lo que no responde en su puerto, y una
# cola no tiene puerto.
#
# Un temporizador es el patrón que el principio 2 bendice. Cada ciclo arranca
# desde 'current', así que no hay código viejo pegado; si un ciclo revienta, el
# siguiente empieza limpio; y todo se lee con 'cat'. Lo que se paga es
# latencia, hasta un ciclo entero, y por eso se dice en voz alta al activarlo:
# para correos e informes da igual, y para una cola que tiene que contestar en
# segundos esto no vale. Ésa es la conversación, y va antes de encenderlo.
#
# Las rutas en funciones, como las del autodespliegue: así las pruebas las
# sustituyen sin escribir en /etc/systemd del equipo donde se ejecutan.
queue_unit()    { echo "/etc/systemd/system/orbit-queue.timer"; }
queue_service() { echo "/etc/systemd/system/orbit-queue.service"; }
QUEUE_LOCK_DIR="/var/lib/orbit"
queue_lock()    { echo "$QUEUE_LOCK_DIR/queue-$1.lock"; }

# Cuánto puede durar un ciclo como mucho. Se deriva del intervalo en vez de
# configurarse aparte, y no es pereza: si un ciclo pudiera durar más que su
# propio periodo, el siguiente arrancaría con el anterior todavía dentro y las
# dos cosas que compra este diseño —una sola release ejecutándose a la vez y un
# ciclo que empieza limpio— dejarían de ser ciertas. Los cinco segundos de
# margen son para que el proceso haya salido antes de que systemd vuelva a
# llamar. Sin esto, una cola que recibe trabajos más rápido de lo que los
# ejecuta convierte el 'worker de un ciclo' en el worker residente que este
# diseño evita, y por el camino largo.
_queue_max_time() {
  local s=$(( QUEUE_EVERY * 60 - 5 ))
  (( s < 10 )) && s=10
  printf '%s' "$s"
}

# Y el límite es de la **pasada**, no de cada app. Con tres apps ocupadas, tres
# ciclos de 55 s seguidos son 165 s dentro de una ventana de 60: la pasada se
# solaparía con la siguiente y, además, systemd la mataría al llegar a su
# TimeoutStartSec — o sea una unidad en rojo cada minuto por un servidor que
# funciona. Así que la pasada reparte un presupuesto: la primera app se lleva el
# ciclo entero y cada una descuenta lo que haya tardado. La cola que se quede
# sin tiempo no pierde nada: los trabajos siguen ahí y la pasada siguiente
# empieza por ella con el presupuesto entero.
QUEUE_BUDGET=""
_queue_cycle_seconds() {
  [[ -n "$QUEUE_BUDGET" ]] && { printf '%s' "$QUEUE_BUDGET"; return 0; }
  _queue_max_time
}

_queue_timer_write() {
  local mt; mt="$(_queue_max_time)"
  cat > "$(queue_service)" <<EOF
[Unit]
Description=Orbit · vaciar la cola de las apps que lo hayan pedido
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/orbit queue run --all --quiet
# El ciclo ya se limita solo con --max-time; esto es el segundo cinturón, por
# si artisan se queda colgado contra una base de datos que no contesta.
TimeoutStartSec=$(( mt + 30 ))
EOF
  cat > "$(queue_unit)" <<EOF
[Unit]
Description=Orbit · procesar la cola cada ${QUEUE_EVERY} min

[Timer]
OnBootSec=2min
OnUnitActiveSec=${QUEUE_EVERY}min
# Un segundo, y no los 20 del autodespliegue: aquí el margen del temporizador
# se suma directamente a lo que tarda en empezar un trabajo, que es lo único
# que este diseño empeora frente a un worker.
AccuracySec=1s
Unit=orbit-queue.service

[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload 2>/dev/null \
    || warn "systemd no ha recargado las unidades. ¿Estás en un contenedor sin systemd?"
}

_queue_enabled_apps() {
  local n
  for n in $(app_names); do
    load_app "$n"
    [[ "$A_QUEUE" == "yes" ]] && printf '%s\n' "$n"
  done
  return 0
}

# Con qué cola trabaja la app, o vacío si de verdad no se puede saber.
#
# La clave del .env manda, pero que no esté **no** significa que no haya cola, y
# ésta es de las que se descubren ejecutando el producto: desde Laravel 11 el
# valor por defecto del framework es 'database', no 'sync'. Un `.env` sin
# QUEUE_CONNECTION —que es lo que deja 'orbit new', porque el esqueleto de
# Laravel no trae .env— encola en la base de datos y no lo ejecuta nadie: el
# fallo silencioso entero, y el aviso que existe para contarlo callado porque
# leía una clave ausente como un «no». Se encontró en el servidor de pruebas,
# sobre un Laravel 13 recién desplegado por Orbit.
#
# El respaldo se lee de 'config/queue.php', que es código pero cuya línea es
# estable desde hace años y es la declaración autorizada: si algún día deja de
# serlo, el peor caso vuelve a ser el de hoy —vacío, y a callar—, no un aviso
# falso en cada despliegue.
_queue_connection() { # _queue_connection <app> [raíz de la app]
  local envf root conn out
  envf="$(app_shared "$1")/.env"
  if [[ -r "$envf" ]]; then
    conn="$(_env_read "$envf" QUEUE_CONNECTION 2>/dev/null || true)"
    [[ -n "$conn" ]] && { printf '%s' "$conn"; return 0; }
  fi
  root="${2:-$(_app_root "$(app_current "$1")")}"
  [[ -r "$root/config/queue.php" ]] || return 0
  # A una variable y no por una tubería a 'head': bajo pipefail, un 'head' que
  # cierra la tubería antes de tiempo deja un 141 que se lleva por delante al
  # que escribe (docs/DEVELOPMENT.md). Aquí además el fichero es de veinte líneas.
  out="$(sed -n "s/.*env('QUEUE_CONNECTION', *'\([a-z]*\)').*/\1/p" "$root/config/queue.php" || true)"
  printf '%s' "${out%%$'\n'*}"
}

# Un ciclo de una app. Devuelve 0 si ha corrido, 1 si se ha saltado y 2 si ha
# fallado; el motivo queda en QUEUE_MSG. Las tres respuestas son distintas a
# propósito: saltarse un ciclo es normal —un despliegue en marcha, una app sin
# release— y no tiene que poner la unidad en rojo, mientras que un ciclo que
# falla sí, porque significa que los trabajos se están apilando.
_queue_run_one() { # _queue_run_one <app>   (ya cargada con load_app)
  local name="$1" cur app mt rc=0
  QUEUE_MSG=""
  [[ "$A_TYPE" == "laravel" ]] || { QUEUE_MSG="$(t "no es una app de Laravel")"; return 1; }
  cur="$(app_current "$name")"
  [[ -d "$cur" ]] || { QUEUE_MSG="$(t "no tiene ninguna release activa")"; return 1; }
  # El symlink se resuelve **una vez**, aquí, y el ciclo entero corre dentro de
  # esa release. Con el 'cd' sobre 'current' a secas, un despliegue que mueva el
  # symlink a mitad de ciclo deja al worker abriendo unos ficheros de la release
  # vieja y otros de la nueva, que es peor que cualquiera de las dos: la
  # promesa de este diseño es «cada ciclo empieza limpio en una release», y una
  # ruta que puede cambiar bajo los pies no la sostiene.
  cur="$(readlink -f "$cur" 2>/dev/null || printf '%s' "$cur")"
  # Durante un despliegue la app está en mantenimiento y el symlink se está
  # moviendo: arrancar aquí un worker es pedirle que empiece en una release que
  # va a dejar de ser la buena. Y si el mantenimiento lo puso una persona,
  # procesar la cola es justo lo que no quería — la regla 1 de doctor otra vez.
  _maint_is_on "$name" && { QUEUE_MSG="$(t "está en mantenimiento")"; return 1; }
  app="$(_app_root "$cur")"
  [[ -f "$app/artisan" ]] || { QUEUE_MSG="$(t "no encuentro su artisan")"; return 2; }
  mt="$(_queue_cycle_seconds)"
  # Menos de cinco segundos no da ni para arrancar el intérprete: gastarlos en
  # levantar Laravel para matarlo a mitad es peor que esperar a la pasada
  # siguiente, que empezará por aquí con el presupuesto entero.
  (( mt >= 5 )) || { QUEUE_MSG="$(t "no queda tiempo en esta pasada")"; return 1; }
  install -d -m 0755 "$QUEUE_LOCK_DIR" 2>/dev/null || true
  # El cerrojo es por app y no global: dos apps distintas no se estorban, y una
  # ejecución a mano mientras el temporizador está dentro sí. Sin él, dos
  # workers de la misma cola compiten por los mismos trabajos.
  #
  # 'set +e' alrededor del subshell y no '( … ) || x': dentro de un '||' el
  # errexit se apaga, y ésta es la única forma que lo mantiene (docs/DEVELOPMENT.md).
  set +e
  (
    # Dos códigos distintos y no uno: «el cerrojo lo tiene otro» es un ciclo
    # que se salta y no pasa nada, y «no puedo ni abrir el fichero del cerrojo»
    # es un servidor con algo roto. Con el mismo número, un /var/lib/orbit sin
    # permisos se leería para siempre como «el ciclo anterior sigue en marcha»,
    # que es de esos mensajes que mandan a mirar donde no es.
    exec 9>"$(queue_lock "$name")" || exit 96
    flock -n 9 || exit 97
    as_app "cd $(printf '%q' "$app") && php artisan queue:work --stop-when-empty --sleep=0 --max-time=$mt --no-interaction --no-ansi"
  )
  rc=$?
  set -e
  case "$rc" in
    0)  return 0 ;;
    97) QUEUE_MSG="$(t "el ciclo anterior sigue en marcha")"; return 1 ;;
    96) QUEUE_MSG="$(t "no puedo abrir su cerrojo en %s" "$QUEUE_LOCK_DIR")"; return 2 ;;
    *)  QUEUE_MSG="$(t "artisan queue:work salió con %s" "$rc")"; return 2 ;;
  esac
}

# Una línea de estado por app. Espera load_app hecho.
_queue_line() { # _queue_line <app>
  local conn; conn="$(_queue_connection "$1")"
  # Vacío no es 'sync': es «no lo sé» —una app sin desplegar todavía, un .env
  # ilegible—, y decir «no hay nada que procesar» sería afirmar lo que no se ha
  # podido comprobar. Es el mismo error que este comando vino a corregir.
  if [[ -z "$conn" ]]; then
    printf "  ${YEL}%s${R} %-18s %s\n" "$G_WARN" "$1" \
      "$(t "(no he podido saber con qué cola trabaja)")"
  elif [[ "$conn" == "sync" || "$conn" == "null" ]]; then
    printf "  ${YEL}%s${R} %-18s %s\n" "$G_WARN" "$1" \
      "$(t "(QUEUE_CONNECTION=%s: no hay nada que procesar)" "$conn")"
  else
    printf "  ${GRN}%s${R} %-18s %s\n" "$G_ON" "$1" "$conn"
  fi
}

_queue_status_json() {
  local n sep="" activo="false" conn
  systemctl is-active --quiet orbit-queue.timer 2>/dev/null && activo="true"
  printf '{"schema":%s,"timer_active":%s,"every_minutes":%s,"max_seconds":%s,"apps":[' \
    "$JSON_SCHEMA" "$activo" "$(_j_num "$QUEUE_EVERY")" "$(_j_num "$(_queue_max_time)")"
  for n in $(_queue_enabled_apps); do
    load_app "$n"
    conn="$(_queue_connection "$n")"
    printf '%s{"app":%s,"type":%s,"connection":%s}' \
      "$sep" "$(_j_str "$n")" "$(_j_str "$A_TYPE")" \
      "$([[ -n "$conn" ]] && _j_str "$conn" || printf 'null')"
    sep=","
  done
  printf ']}\n'
}

cmd_queue() {
  need_root queue
  _subcmd queue status app "enable|on disable|off every|cada run|once status" "$@"
  local sub="$SUBCMD"; set -- "${SUBCMD_ARGS[@]}"
  # Los demás subcomandos no tienen nada que serializar, y fingir que su salida
  # de siempre es JSON es peor que negarse: el cliente se lo cree.
  [[ "$JSON" == "yes" && "$sub" != "status" ]] && die "--json sólo está en 'orbit queue status'"
  local name="${1:-}"
  case "$sub" in
    enable)
      [[ -n "$name" ]] || name="$(pick_app 'App cuya cola hay que procesar')" || return 0
      load_app "$name"
      # Hoy sólo Laravel: es el único stack donde Orbit sabe qué orden ejecutar
      # y qué significa que termine. Prometer 'colas' para todos sería prometer
      # que Orbit adivina el worker de cualquier framework.
      [[ "$A_TYPE" == "laravel" ]] \
        || die "Las colas sólo están en las apps de Laravel, y '%s' es de tipo %s." "$name" "$A_TYPE"
      local conn; conn="$(_queue_connection "$name")"
      if [[ "$conn" == "sync" || "$conn" == "null" ]]; then
        # No se aborta: el .env puede cambiar en cualquier momento y el permiso
        # queda dado. Pero decirlo evita el peor final, que es alguien mirando
        # una cola vacía convencido de que Orbit no procesa nada.
        warn "QUEUE_CONNECTION=%s: los trabajos se ejecutan en la propia petición y no hay cola que vaciar." "$conn"
        info "Cámbialo cuando toque:  orbit env set %s QUEUE_CONNECTION database" "$name"
      elif [[ -z "$conn" ]]; then
        # Y vacío es «no lo sé», no «no hay»: pasa con una app que todavía no se
        # ha desplegado, donde no hay release en la que mirar el config.
        info "Todavía no sé con qué cola trabaja; se verá cuando la despliegues."
      fi
      A_QUEUE="yes"; save_app
      _queue_timer_write
      systemctl enable --now orbit-queue.timer >/dev/null 2>&1 || true
      ok "«%s» procesará su cola cada %s min" "$name" "$QUEUE_EVERY"
      # La latencia, dicha entera y por delante. Es el precio del diseño, no un
      # detalle: quien necesite segundos tiene que enterarse aquí y no cuando un
      # cliente le pregunte por qué el correo tarda un minuto en salir.
      info "Cada ciclo ejecuta 'queue:work --stop-when-empty', así que un trabajo puede tardar"
      info "hasta %s min en empezar. Para correos e informes da igual; si tu cola tiene que" "$QUEUE_EVERY"
      info "contestar en segundos, esto no te vale y necesitas un worker residente."
      info "Se ajusta con:  orbit queue every <minutos>"
      logline "queue enable $name" ;;
    disable)
      [[ -n "$name" ]] || name="$(pick_app 'App')" || return 0
      load_app "$name"
      A_QUEUE="no"; save_app
      ok "«%s» ya no procesa su cola" "$name"
      if [[ -z "$(_queue_enabled_apps)" ]]; then
        systemctl disable --now orbit-queue.timer >/dev/null 2>&1 || true
        # Y se apaga la luz roja, por lo mismo que en el autodespliegue: un
        # ciclo fallido deja la unidad en 'failed' a propósito, y el ciclo
        # siguiente la pone en verde sola. Sin temporizador no hay ciclo
        # siguiente, así que ese rojo se quedaría para siempre y con él un
        # servidor que 'systemctl is-system-running' lee como «degraded».
        systemctl reset-failed orbit-queue.service >/dev/null 2>&1 || true
        info "Ninguna app procesa colas: temporizador detenido."
      fi
      logline "queue disable $name" ;;
    every)
      local mins="${1:-}"
      [[ "$mins" =~ ^[0-9]+$ ]] && (( mins >= 1 && mins <= 1440 )) \
        || die "uso: orbit queue every <minutos>   (entre 1 y 1440)"
      _conf_set QUEUE_EVERY "$mins"
      # El intervalo va dentro de la unidad —y el límite del ciclo se deriva de
      # él—, así que no basta con guardarlo: hay que reescribirla y reiniciar.
      if [[ -n "$(_queue_enabled_apps)" ]]; then
        _queue_timer_write
        systemctl restart orbit-queue.timer >/dev/null 2>&1 || true
        ok "La cola se procesará cada %s min, y el temporizador ya lo usa" "$mins"
      else
        ok "Guardado: cada %s min cuando actives alguna app" "$mins"
      fi
      logline "queue every $mins" ;;
    run)
      local todas="no" quiet="no" a
      local -a resto=()
      for a in "$@"; do
        case "$a" in
          --all|--todas) todas="yes" ;;
          --quiet|-q)    quiet="yes" ;;
          -*)            die "Opción desconocida: %s" "$a" ;;
          *)             resto+=("$a") ;;
        esac
      done
      name="${resto[0]:-}"
      local -a names=()
      if [[ "$todas" == "yes" ]]; then
        mapfile -t names < <(_queue_enabled_apps)
        if (( ${#names[@]} == 0 )); then
          info "Ninguna app procesa colas. Actívalo con:  orbit queue enable <app>"
          return 0
        fi
      else
        [[ -n "$name" ]] || name="$(pick_app 'App')" || return 0
        app_exists "$name" || die "No existe ninguna app llamada «%s»." "$name"
        names=("$name")
      fi
      local n rc fallos=0 t0
      # El presupuesto es de la pasada entera y se reparte por orden de llegada:
      # la primera app se lleva el ciclo completo y cada una descuenta lo que
      # tardó. Se fija aquí y no dentro del bucle para que dos apps no puedan
      # sumar más de lo que dura la ventana del temporizador.
      QUEUE_BUDGET="$(_queue_max_time)"
      for n in "${names[@]}"; do
        load_app "$n"
        t0=$SECONDS
        rc=0; _queue_run_one "$n" || rc=$?
        QUEUE_BUDGET=$(( QUEUE_BUDGET - (SECONDS - t0) ))
        case "$rc" in
          0) [[ "$quiet" == "yes" ]] || ok "«%s»: cola vaciada" "$n"
             _watch_mark "cola:$n" ok info "$(t "La cola de «%s» vuelve a procesarse" "$n")" ;;
          1) [[ "$quiet" == "yes" ]] || info "«%s»: saltada · %s" "$n" "$QUEUE_MSG" ;;
          *) fallos=$((fallos + 1))
             err "«%s»: la cola no se ha podido procesar · %s" "$n" "$QUEUE_MSG"
             # Se avisa por el vigilante y no con 'notify' a pelo: el
             # temporizador pasa cada minuto y una avería dura horas, así que
             # avisar del estado en vez de la transición sería el mismo mensaje
             # sesenta veces por hora. Es para lo que existe _watch_mark.
             _watch_mark "cola:$n" fallo warn \
               "$(t "La cola de «%s» no se procesa: %s" "$n" "$QUEUE_MSG")" ;;
        esac
      done
      QUEUE_BUDGET=""
      # Un ciclo fallido deja la unidad en rojo, y eso es el aviso: sin él, los
      # trabajos se apilan sin que nada lo diga (medido en §18.9). 'orbit
      # doctor' lo cuenta, y el ciclo siguiente la pone en verde sola.
      (( fallos == 0 )) || return 1
      return 0 ;;
    status)
      if [[ "$JSON" == "yes" ]]; then _queue_status_json; return 0; fi
      title "Colas"
      if [[ -n "$name" ]]; then
        app_exists "$name" || die "No existe ninguna app llamada «%s»." "$name"
        load_app "$name"
        if [[ "$A_QUEUE" == "yes" ]]; then _queue_line "$name"
        else info "«%s» no procesa su cola. Actívalo con:  orbit queue enable %s" "$name" "$name"; fi
        echo
        return 0
      fi
      local -a on
      mapfile -t on < <(_queue_enabled_apps)
      if (( ${#on[@]} == 0 )); then
        info "Ninguna app procesa colas. Actívalo con:  orbit queue enable <app>"
      else
        if systemctl is-active --quiet orbit-queue.timer 2>/dev/null; then
          ok "Temporizador activo, cada %s min (cada ciclo dura %s s como mucho)" \
            "$QUEUE_EVERY" "$(_queue_max_time)"
          # El intervalo queda escrito dentro de la unidad: si alguien edita
          # orbit.conf a mano, el cambio no surte efecto y más vale decirlo.
          local en_unidad
          en_unidad="$(grep -oP 'OnUnitActiveSec=\K[0-9]+' "$(queue_unit)" 2>/dev/null || true)"
          if [[ -n "$en_unidad" && "$en_unidad" != "$QUEUE_EVERY" ]]; then
            warn "El temporizador sigue con %s min: aplícalo con  orbit queue every %s" "$en_unidad" "$QUEUE_EVERY"
          fi
        else
          warn "Hay apps con cola pero el temporizador está parado: 'orbit queue enable <app>'"
        fi
        local n
        for n in "${on[@]}"; do load_app "$n"; _queue_line "$n"; done
      fi
      echo ;;
  esac
}

# ═══════════════════════════════════════════════ mantenimiento ════════════
# Se escribe una vez y es tuya: vive en shared/, sobrevive a los despliegues y
# puedes editarla. Sin recursos externos, para que se vea aunque lo que esté
# caído sea justo la app que servía los estilos.
_maint_page_ensure() { # _maint_page_ensure <app>
  local f; f="$(maint_page "$1")"
  [[ -f "$f" ]] && return 0
  install -d -o "$(app_user)" -g "$(app_user)" "$APPS_DIR/$1/shared"
  cat > "$f" <<'EOF'
<!doctype html>
<html lang="es">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Volvemos enseguida</title>
<style>
  :root { color-scheme: light dark; }
  body { margin: 0; min-height: 100vh; display: grid; place-items: center;
         font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
         background: #fafafa; color: #1a1a1a; }
  @media (prefers-color-scheme: dark) { body { background: #111; color: #eee; } }
  main { max-width: 32rem; padding: 2rem; text-align: center; }
  h1 { font-size: 1.6rem; margin: 0 0 .75rem; }
  p { margin: 0; opacity: .75; }
  /* Si no se ha dado un motivo, el párrafo queda vacío y no se enseña. */
  .motivo { margin-top: .75rem; opacity: 1; font-weight: 500; }
  .motivo:empty { display: none; }
</style>
<main>
  <h1>Volvemos enseguida</h1>
  <p>Estamos publicando una actualización. Suele durar menos de un minuto.</p>
  <p class="motivo"><!--# include file="maintenance.reason" --></p>
</main>
EOF
  chown "$(app_user):$(app_user)" "$f"; chmod 0644 "$f"
}

# El motivo acaba dentro de una página HTML, así que se escapa. No es tanto por
# seguridad —lo escribe quien administra el servidor— como porque un '<' en el
# texto rompería la maqueta.
# Con sed y no con ${s//&/&amp;}: bash 5.2 activa 'patsub_replacement' por
# defecto, con lo que una '&' en el reemplazo significa "lo que ha coincidido"
# igual que en sed, y ${s//</&lt;} produce '<lt;' en vez de '&lt;'. Ver la
# sección 10 de ARCHITECTURE.
_html_escape() {
  printf '%s' "${1-}" \
    | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
}

# El fichero del motivo tiene que existir SIEMPRE. Si falta, la SSI incrusta
# una página de error 404 entera dentro del párrafo. Comprobado.
_maint_reason_write() { # _maint_reason_write <app> [texto]
  local f; f="$(maint_reason "$1")"
  install -d -o "$(app_user)" -g "$(app_user)" "$APPS_DIR/$1/shared"
  printf '%s' "$(_html_escape "${2-}")" > "$f"
  chown "$(app_user):$(app_user)" "$f" 2>/dev/null || true
  chmod 0644 "$f"
}

_maint_on() { # _maint_on <app> [motivo]
  local f; f="$(maint_flag "$1")"
  _maint_page_ensure "$1"
  _maint_reason_write "$1" "${2-}"
  : > "$f"
  chown "$(app_user):$(app_user)" "$f" 2>/dev/null || true
  chmod 0644 "$f"
}

_maint_is_on() { [[ -e "$(maint_flag "$1")" ]]; }

cmd_maintenance() {
  need_root maintenance
  _subcmd maintenance status app "on|activar off|quitar edit|page status" "$@"
  local sub="$SUBCMD"; set -- "${SUBCMD_ARGS[@]}"
  local name="${1:-}"
  case "$sub" in
    on)
      local motivo="${2-}"
      [[ -n "$name" ]] || name="$(pick_app 'App a poner en mantenimiento')" || return 0
      load_app "$name"
      [[ "$A_TYPE" == "redirect" ]] && die "'%s' solo redirige: no hay nada que poner en mantenimiento." "$A_NAME"
      _maint_on "$name" "$motivo"
      ok "«%s» en mantenimiento: responde 503 con la página de aviso" "$name"
      [[ -n "$motivo" ]] && info "Motivo: %s" "$motivo"
      info "Edita la página en %s" "$(maint_page "$name")"
      info "Quítalo con:  orbit maintenance off %s" "$name"
      # Una página escrita por una versión anterior no trae el hueco del
      # motivo, así que el texto no se vería por ningún sitio.
      if [[ -n "$motivo" ]] && ! grep -q 'maintenance.reason' "$(maint_page "$name")" 2>/dev/null; then
        warn "Tu página no tiene el hueco del motivo, así que no se mostrará."
        warn "Añádele esta línea donde quieras que salga:"
        warn '  <p class="motivo"><!--# include file="maintenance.reason" --></p>'
      fi
      # Si el vhost es anterior a esta versión no tiene el bloque todavía.
      if ! grep -q '__orbit_maintenance' "$(nginx_file "$name")" 2>/dev/null; then
        warn "El vhost de esta app aún no conoce el mantenimiento. Aplícalo con:  orbit nginx-rebuild"
      fi
      logline "maintenance on $name" ;;
    off)
      [[ -n "$name" ]] || name="$(pick_app 'App')" || return 0
      load_app "$name"
      if ! _maint_is_on "$name"; then
        info "«%s» no estaba en mantenimiento" "$name"
        return 0
      fi
      rm -f "$(maint_flag "$name")"
      # El motivo se limpia para que no reaparezca en el siguiente aviso.
      _maint_reason_write "$name" ""
      ok "«%s» vuelve a servir con normalidad" "$name"
      logline "maintenance off $name" ;;
    edit)
      [[ -n "$name" ]] || name="$(pick_app 'App')" || return 0
      load_app "$name"
      _maint_page_ensure "$name"
      "${EDITOR:-nano}" "$(maint_page "$name")"
      chown "$(app_user):$(app_user)" "$(maint_page "$name")"; chmod 0644 "$(maint_page "$name")"
      ok "Guardada. Se sirve tal cual, sin recargar nginx." ;;
    status)
      [[ -n "$name" ]] && { app_exists "$name" || die "No existe ninguna app llamada «%s»." "$name"; }
      title "Mantenimiento"
      local n any=0
      for n in $(app_names); do
        [[ -n "$name" && "$n" != "$name" ]] && continue
        if _maint_is_on "$n"; then
          load_app "$n"
          printf "  ${YEL}%s${R} %-18s %s ${D}(desde %s)${R}\n" "$G_MID" "$n" "$A_DOMAIN" \
            "$(date -r "$(maint_flag "$n")" '+%H:%M' 2>/dev/null || echo '?')"
          local motivo; motivo="$(cat "$(maint_reason "$n")" 2>/dev/null || true)"
          [[ -n "$motivo" ]] && printf "      %s\n" "$motivo"
          any=1
        fi
      done
      if (( ! any )); then
        [[ -n "$name" ]] && info "«%s» sirve con normalidad." "$name" \
                         || info "Ninguna app está en mantenimiento."
      fi
      echo ;;
  esac
}

# Durante el reinicio hay un hueco de uno o dos segundos en el que nginx no
# encuentra a nadie al otro lado y responde 502. Un 503 con la página de aviso
# dice lo que de verdad está pasando, y a un buscador le dice "vuelve luego"
# en vez de "esto está roto".
MAINT_BY_DEPLOY=""

_maint_deploy_on() { # _maint_deploy_on <app>
  [[ "${A_MAINT_AUTO:-}" == "no" ]] && return 0
  # Si ya estaba en mantenimiento, lo puso una persona: no es nuestro y no lo
  # vamos a quitar al terminar.
  _maint_is_on "$1" && return 0
  # Sin motivo: el de la vez anterior no tiene nada que ver con este despliegue.
  _maint_on "$1" ""
  MAINT_BY_DEPLOY="$(maint_flag "$1")"
  # El testigo se retira pase lo que pase, pero la trampa que lo hace la pone
  # 'cmd_deploy' —única que llama aquí— junto con lo demás que hay que hacer al
  # salir. Ponerla aquí sustituía la suya, y entonces sólo corría una de las dos.
}

_maint_deploy_off() {
  [[ -n "$MAINT_BY_DEPLOY" ]] || return 0
  rm -f "$MAINT_BY_DEPLOY"
  MAINT_BY_DEPLOY=""
}

cmd_migrate() { # orbit migrate [app] [--yes]
  need_root migrate
  local name="" auto="no" a
  for a in "$@"; do
    case "$a" in
      -y|--yes|--si) auto="yes" ;;
      -*) die "Opción desconocida: %s" "$a" ;;
      *)  [[ -z "$name" ]] && name="$a" ;;
    esac
  done
  [[ -n "$name" ]] || name="$(pick_app 'App a migrar')" || return 0
  load_app "$name"
  [[ -n "$A_MIGRATE" ]] || die "'%s' no tiene comando de migración. Defínelo en A_MIGRATE dentro de %s." "$A_NAME" "$(app_conf "$name")"
  [[ -d "$(app_current "$name")" ]] || die "'%s' no tiene release activa. Ejecuta:  orbit deploy %s" "$A_NAME" "$name"

  title "Migraciones de {b}%s{r}" "$A_NAME"
  # El plan primero. Una migración que borra una columna no debe ser una
  # sorpresa, y por eso el despliegue nunca las aplica solo.
  if [[ "$A_PYFW" == "django" ]]; then
    info "Plan:"
    _run_in_app "$name" bash -lc "$A_MIGRATE --plan" 2>&1 | sed 's/^/      /' || true
  fi
  # En Laravel el equivalente es '--pretend', y es incluso mejor: imprime el SQL
  # exacto, sentencia a sentencia. Necesita '--force' igual que el de verdad,
  # porque en producción y sin terminal artisan cancela y sale con 1.
  if [[ "$A_TYPE" == "laravel" ]]; then
    # Con la advertencia por delante, porque '--pretend' promete menos de lo
    # que parece: suprime las consultas, pero **el resto del código de up() se
    # ejecuta igual**. Medido con una migración que además escribía un fichero:
    # la tabla no se creó y el fichero sí, con «Cancelado, no se ha tocado
    # nada» impreso justo debajo.
    info "Plan (el SQL no se ejecuta, pero el resto del código de la migración sí):"
    _run_in_app "$name" bash -lc "$(_app_cd 'php artisan migrate --pretend --force --no-ansi')" 2>&1 \
      | sed 's/^/      /' || true
  fi
  if [[ "$auto" != "yes" ]]; then
    confirm "¿Aplicar las migraciones ahora?" n || { info "Cancelado, no se ha tocado nada."; return 0; }
  fi
  _run_in_app "$name" bash -lc "$A_MIGRATE" || die "La migración ha fallado. La base de datos puede haber quedado a medias: revisa la salida."
  ok "Migraciones aplicadas"
  logline "migrate $name"
}

cmd_port() { # orbit port [app] [puerto]
  need_root port
  local name="${1:-}" want="${2:-}"
  [[ -n "$name" ]] || name="$(pick_app 'App')" || return 0
  load_app "$name"
  needs_svc "$A_TYPE" || {
    info "'%s' es de tipo %s: nginx la sirve desde disco y no usa puerto interno." "$A_NAME" "$A_TYPE"
    return 0
  }

  if [[ -n "$want" ]]; then
    [[ "$want" =~ ^[0-9]+$ ]] && (( want >= 1024 && want <= 65535 )) \
      || die "Puerto inválido: '%s'. Escribe un número entre 1024 y 65535." "$want"
    _port_taken_by_other "$name" "$want" \
      && die "El puerto %s ya está ocupado. Omite el número y Orbit elegirá uno libre." "$want"
  elif _port_taken_by_other "$name" "$A_PORT"; then
    want="$(free_port "$name")"
    warn "El puerto %s chocaba con otra app o servicio" "$A_PORT"
  else
    want="$A_PORT"
  fi

  if [[ "$want" == "$A_PORT" ]]; then
    ok "'%s' ya usa el puerto %s y no choca con nadie" "$A_NAME" "$A_PORT"
    return 0
  fi

  local prev="$A_PORT"
  A_PORT="$want"; save_app
  render_systemd "$name"
  # nginx primero: si rechaza la configuración abortamos con la app intacta.
  if ! render_nginx "$name"; then
    load_app "$name"; A_PORT="$prev"; save_app; render_systemd "$name"
    die "nginx rechazó la configuración. Puerto revertido a %s." "$prev"
  fi

  if [[ -e "$(app_current "$name")" ]]; then
    systemctl restart "$(svc_name "$name")"
    health_wait "$want" 30 || warn "La app no responde todavía. Mira 'orbit logs %s'." "$name"
  else
    info "La app aún no se ha desplegado: el puerto se usará en el primer 'orbit deploy'."
  fi
  ok "'%s' pasa del puerto %s al %s" "$A_NAME" "$prev" "$want"
  logline "port $name $prev->$want"
}

# ═══════════════════════════════════════════ variables de entorno ═════════
# El .env lo leen dos parsers distintos: bash con 'source' (el build y
# 'orbit exec') y systemd como EnvironmentFile. Lo que se escriba aquí tiene
# que valer para los dos, y no escapan igual.
_env_path() { # _env_path <app>
  local d; d="$(app_shared "$1")"
  # Si el repositorio declaró su propio fichero en orbit.json, es ESE el que
  # tiene que tocar `orbit env`. Si no, `orbit env set` escribiría en
  # shared/.env mientras la provisión mira shared/api/.env: la variable
  # seguiría sin definirse y cada despliegue repetiría el mismo aviso, sin
  # que nadie entienda por qué. Requiere `load_app` previo, que es lo que
  # hacen todos los que llaman aquí.
  local rel="${A_ENV_FILE:-.env}"
  _safe_relpath "$rel" || rel=".env"
  local f="$d/$rel"
  # El dueño sale de la app NOMBRADA, no de la cargada: el clone llama aquí
  # con el original mientras los globales ya son del clon, y con app_user()
  # el chown le robaba el .env al original y le enseñaba sus secretos al
  # usuario del clon (revisión del PR #10).
  local u; u="$(app_user_of "$1")"
  install -d -o "$u" -g "$u" "$(dirname "$f")"
  [[ -f "$f" ]] || { : > "$f"; }
  chown "$u:$u" "$f"; chmod 0640 "$f"
  printf '%s' "$f"
}

_env_key_ok() { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; }

# La clave se compara LITERAL, y esto no es purismo.
#
# Antes era un grep con la clave metida cruda en la expresión regular, y
# '_env_write' —el que borra— ya la comparaba literal con [[ =~ ]] y la clave
# entrecomillada. O sea que los dos no podían coincidir, y con una clave que
# llevara un metacarácter se contradecían de la peor manera posible. Medido
# con un .env que tenía FOOXBAR y pidiendo FOO.BAR:
#
#   · 'orbit env get app FOO.BAR' imprimía el valor de FOOXBAR — el secreto de
#     otra variable, por stdout, con el nombre equivocado.
#   · 'orbit env unset app FOO.BAR' decía «FOO.BAR eliminada» y NO borraba
#     nada, porque el que decide si existe casaba y el que borra no. Quien
#     quita una credencial filtrada se queda creyendo que ya no está.
#
# Ahora los tres —has, read y write— comparan igual, así que no pueden volver
# a discrepar. 'cmd_env' además valida la clave antes de llegar aquí; esto es
# el cinturón, aquello los tirantes. De paso se ahorra un fork por lectura.
_env_line_matches() { # _env_line_matches <línea> <clave>
  [[ "$1" =~ ^[[:space:]]*(export[[:space:]]+)?"$2"= ]]
}

_env_has() { # _env_has <fichero> <clave>
  local line
  [[ -r "$1" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    _env_line_matches "$line" "$2" && return 0
  done < "$1"
  return 1
}

# El valor que verá la app de verdad: se obtiene cargando el fichero igual que
# lo hace el build, no interpretando la línea por nuestra cuenta.
# Lee una clave del .env **sin interpretarlo**. Antes esto hacía un 'source', y
# eso estaba mal por dos motivos distintos, los dos medidos:
#
#   1 · **Ejecutaba lo que hubiera dentro, como root.** Una línea
#       'APP_DEBUG=$(id -un > /tmp/x)' en el .env de una app se ejecutaba en el
#       siguiente despliegue con todos los privilegios. Y el .env lo escribe el
#       usuario de despliegue, que es también el usuario de php-fpm: cualquier
#       ejecución de código en cualquier app PHP del servidor podía dejar ahí
#       una línea y esperar. Con autodespliegue, además, ese despliegue lo lanza
#       un temporizador sin nadie delante.
#   2 · **Un carácter normal de una contraseña rompía todo lo que iba detrás.**
#       Con 'DB_PASSWORD=aB3(x9Z!', bash aborta el source en el paréntesis y
#       todas las claves siguientes se leen vacías — mientras que phpdotenv las
#       lee perfectamente. El daño se veía en Laravel: la APP_KEY salía vacía,
#       se regeneraba en cada despliegue —invalidando sesiones y todo lo
#       cifrado— y los avisos de APP_DEBUG y de la cola callaban a la vez.
#
# Un .env no es un script de bash y no hay que tratarlo como tal. Se lee la
# última asignación de la clave y se le quitan las comillas exteriores, que es
# lo que hace phpdotenv.
# La variable se llama 'val' y no 'v' por shellcheck: hay otras tres funciones
# del fichero que usan 'v' como array, y su análisis se cuela entre funciones —
# con 'local v' aquí saca un SC2178 por línea sobre código correcto.
_env_read() { # _env_read <fichero> <clave>
  local val="" line
  # La última definición gana, que es lo que hacía el 'tail -1' de antes y lo
  # que hace quien carga el fichero. La comparación es literal: ver
  # _env_line_matches.
  if [[ -r "$1" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      _env_line_matches "$line" "$2" || continue
      val="${line#*"$2"=}"
    done < "$1"
  fi
  # Los comentarios de final de línea sólo cuentan fuera de comillas; phpdotenv
  # hace lo mismo. Se quitan antes que las comillas para no comerse un '#' que
  # forme parte del valor.
  [[ "$val" != [\"\']* ]] && val="${val%%[[:space:]]#*}"
  val="${val%\"}"; val="${val#\"}"; val="${val%\'}"; val="${val#\'}"
  printf '%s' "$val"
}

_env_write() { # _env_write <fichero> <clave> [valor]   (sin valor, la borra)
  local f="$1" key="$2" val="${3-}" tmp line done_it="no"
  tmp="$(mktemp)"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?"$key"= ]]; then
      # Se sustituye en su sitio para no descolocar los comentarios que el
      # usuario haya puesto alrededor.
      [[ $# -ge 3 ]] && { printf '%s=%s\n' "$key" "$(_q "$val")" >> "$tmp"; done_it="yes"; }
      continue
    fi
    printf '%s\n' "$line" >> "$tmp"
  done < "$f"
  [[ $# -ge 3 && "$done_it" == "no" ]] && printf '%s=%s\n' "$key" "$(_q "$val")" >> "$tmp"
  cat "$tmp" > "$f"     # se conserva el inodo: el symlink de la release sigue valiendo
  rm -f "$tmp"
  # Y con el inodo se conserva el dueño, así que aquí no hay que tocarlo. Había
  # un 'chown "$(app_user)"', y app_user() lee las GLOBALES: quien llega sin
  # load_app —'orbit db create <app>' es el caso real— obtenía 'deploy' y le
  # robaba el .env al usuario de una app aislada. Se veía entero en un servidor:
  # 'orbit db create' sobre un Laravel aislado dejaba el .env en deploy:deploy y
  # el build siguiente moría con EACCES leyendo su propio fichero. El arreglo
  # del PR #10 estaba en la llamada; esta línea lo deshacía tres más abajo.
  # Quien crea el fichero es quien le pone dueño, y todos los que llaman aquí lo
  # crean antes con el suyo.
  chmod 0640 "$f"
}

# Valor para una variable declarada con "generate".
#
# Los formatos son deliberadamente pocos. Cada uno que se añade es otro que hay
# que documentar y otro con el que alguien puede equivocarse; con tres se cubre
# lo que aparece de verdad: un token de URL, un secreto binario y un id.
_env_generate() { # _env_generate <spec>   p.ej. hex:24, base64:32, uuid
  # En un solo `local a=… b="$a"` la expansión de $a ocurre antes de que la
  # local exista, y con `set -u` eso no es una cadena vacía: aborta. Es la
  # misma trampa que documenta _read_descriptor, y caí en ella igual.
  local spec="${1:-hex:32}"
  local kind="${spec%%:*}" n="${spec##*:}"
  [[ "$n" =~ ^[0-9]+$ ]] || n=32
  (( n > 0 && n <= 256 )) || n=32
  case "$kind" in
    hex)    openssl rand -hex "$n" 2>/dev/null || head -c "$n" /dev/urandom | od -An -tx1 | tr -d ' \n' ;;
    base64) openssl rand -base64 "$n" 2>/dev/null | tr -d '\n' | tr '+/' '-_' ;;
    uuid)   cat /proc/sys/kernel/random/uuid 2>/dev/null || openssl rand -hex 16 ;;
    *)      return 1 ;;
  esac
}

# Rellena el .env declarado en orbit.json con lo que falte.
#
# Lo que se puede generar se genera y no se dice más que una línea. Lo que hay
# que preguntar se pregunta UNA vez, y si nadie puede contestar —autodeploy,
# CI, --yes— se avisa con el comando exacto para hacerlo después, en vez de
# dejar el despliegue colgado esperando a un teclado que no existe.
_provision_env() { # _provision_env <app> <shared>
  local name="$1" shared="$2"
  [[ -n "$A_ENV_SPEC" ]] || return 0

  local rel="${A_ENV_FILE:-.env}"
  # La misma validación que el resto de rutas del descriptor: además de '..' y
  # las absolutas, descarta los nombres raros y el guion inicial.
  _safe_relpath "$rel" || { warn "env: '%s' no es una ruta dentro de la app; me la salto." "$rel"; return 0; }
  local f="$shared/$rel"
  install -d -o "$(app_user)" -g "$(app_user)" "$(dirname "$f")"

  # Un enlace simbólico aquí no se sigue: se aborta.
  #
  # `shared/` es del usuario de despliegue a propósito —la app escribe ahí—,
  # así que una app comprometida puede sustituir su .env por un enlace a
  # cualquier fichero del sistema. Todo lo de abajo corre como root: `_env_write`
  # hace `cat > "$f"` y luego `chown`, y siguiendo el enlace eso reescribiría y
  # cambiaría el dueño de, por ejemplo, /etc/shadow. Escalada de privilegios
  # completa, y encima automática: pasa sola en el siguiente despliegue.
  #
  # Se comprueba el fichero y también cada directorio del camino, porque un
  # enlace a mitad de ruta consigue exactamente lo mismo.
  local probe="$shared" part
  while IFS= read -r part; do
    [[ -n "$part" ]] || continue
    probe="$probe/$part"
    if [[ -L "$probe" ]]; then
      warn "env: '%s' pasa por un enlace simbólico (%s); no escribo ahí." "$rel" "$probe"
      return 0
    fi
  done < <(printf '%s\n' "${rel//\//$'\n'}")

  [[ -e "$f" ]] || install -o "$(app_user)" -g "$(app_user)" -m 0640 /dev/null "$f"
  if [[ ! -f "$f" ]]; then
    warn "env: '%s' existe y no es un fichero normal; no lo toco." "$rel"
    return 0
  fi

  local key mode arg secret desc val made=0 asked=0 pend=""
  while IFS=$'\t' read -r key mode arg secret desc; do
    [[ -n "$key" ]] || continue
    _env_key_ok "$key" || { warn "env: '%s' no es un nombre de variable válido; me la salto." "$key"; continue; }
    # Ya está declarada: no se toca. Basta con que EXISTA, aunque esté vacía:
    # `orbit env set app CLAVE ''` es la forma documentada de desactivar algo
    # opcional, y volver a generarle un valor sería deshacer una decisión
    # deliberada en cada despliegue. La regla es «lo puesto a mano manda», no
    # «lo puesto a mano y además no vacío».
    _env_has "$f" "$key" && continue

    case "$mode" in
      generate)
        val="$(_env_generate "$arg")" || { warn "env: no sé generar '%s' para %s" "$arg" "$key"; continue; }
        _env_write "$f" "$key" "$val"
        made=$((made+1))
        ;;
      prompt)
        if [[ ! -t 0 || "$ASSUME_YES" == "yes" ]]; then
          pend="${pend}${pend:+ }$key"
          continue
        fi
        printf "\n  %s\n" "$(t "Falta un dato que solo tú puedes dar:")"
        [[ -n "$desc" ]] && printf "  ${D}%s${R}\n" "$desc"
        val=""
        if [[ "$secret" == "secret" ]]; then
          # Sin eco y sin quedar en el historial del shell.
          printf "  ${B}%s${R}: " "$arg"; read -rs val || true; printf "\n"
        else
          ask val "$arg" ""
        fi
        if [[ -z "$val" ]]; then pend="${pend}${pend:+ }$key"; continue; fi
        _env_write "$f" "$key" "$val"
        asked=$((asked+1))
        ;;
    esac
  done <<< "$A_ENV_SPEC"

  (( made > 0 ))  && ok "%s variable(s) generada(s) en %s" "$made" "${A_ENV_FILE:-.env}"
  (( asked > 0 )) && ok "%s variable(s) guardada(s) en %s" "$asked" "${A_ENV_FILE:-.env}"
  if [[ -n "$pend" ]]; then
    warn "Faltan por definir: %s" "$pend"
    local k
    for k in $pend; do info "  orbit env set %s %s '<valor>'" "$name" "$k"; done
  fi
  return 0
}

_env_reminder() { # _env_reminder <app>
  # Laravel es el único tipo sin servicio al que cambiar el .env no le llega
  # solo: 'config:cache' deja bootstrap/cache/config.php en la release, y
  # mientras ese fichero exista Laravel **no vuelve a leer el .env nunca**.
  # Medido: con APP_NAME cambiado en shared/.env, la web seguía sirviendo el
  # valor viejo hasta borrar la caché. Callarse aquí deja a alguien cambiando la
  # contraseña de la base de datos y viendo que no pasa nada.
  #
  # Y se manda a redesplegar, no a regenerar la caché sobre la release activa:
  # eso mutaría una release ya publicada, que es justo lo que el modelo promete
  # que no pasa.
  if [[ "$A_TYPE" == "laravel" ]]; then
    info "Se aplicará al volver a desplegar:  orbit deploy %s" "$1"
    return 0
  fi
  needs_svc "$A_TYPE" || return 0
  info "Se aplicará al reiniciar:  orbit restart %s" "$1"
}

cmd_env() {
  need_root env
  _subcmd env edit app "get set unset list edit" "$@"
  local sub="$SUBCMD"; set -- "${SUBCMD_ARGS[@]}"
  # 'get' ya imprime el valor pelado y los demás no devuelven datos, así que
  # el único que tiene algo que serializar es 'list'.
  [[ "$JSON" == "yes" && "$sub" != "list" ]] && die "--json sólo está en 'orbit env list <app>'"
  local name="${1:-}"; shift || true
  if [[ -z "$name" && "$JSON" == "yes" ]]; then
    die "uso: orbit env list <app> --json"
  fi
  [[ -n "$name" ]] || name="$(pick_app 'App')" || return 0
  load_app "$name"
  local f; f="$(_env_path "$name")"

  case "$sub" in
    edit)
      "${EDITOR:-nano}" "$f"
      chown "$(app_user):$(app_user)" "$f"; chmod 0640 "$f"
      ok "Guardado. Recuerda: los cambios se aplican al reiniciar."
      if needs_svc "$A_TYPE" && confirm "¿Reiniciar '%s' ahora?" y "$name"; then
        systemctl restart "$(svc_name "$name")"; ok "Reiniciada"
      fi ;;
    get)
      local key="${1:-}"
      [[ -n "$key" ]] || die "uso: orbit env get <app> <CLAVE>"
      # Se valida igual que en 'set': una clave con metacaracteres no puede
      # existir en un .env, así que pedirla es siempre un error de quien
      # escribe — y antes contestaba con el valor de OTRA variable.
      _env_key_ok "$key" || die "'%s' no es un nombre válido. Solo letras, números y '_', sin empezar por número." "$key"
      _env_has "$f" "$key" || die "'%s' no está definida en el .env de %s" "$key" "$name"
      # Sin adornos y por stdout: VALOR=\$(orbit env get app CLAVE) debe funcionar.
      printf '%s\n' "$(_env_read "$f" "$key")" ;;
    set)
      local key="${1:-}" val="${2-}" restart="no" a
      for a in "${@:3}"; do
        case "$a" in
          --restart|--reiniciar) restart="yes" ;;
          *) die "Opción desconocida: %s" "$a" ;;
        esac
      done
      [[ -n "$key" && $# -ge 2 ]] || die "uso: orbit env set <app> <CLAVE> <valor> [--restart]"
      _env_key_ok "$key" || die "'%s' no es un nombre válido. Solo letras, números y '_', sin empezar por número." "$key"
      # bash escapa la comilla simple como '\'' y systemd no entiende ese
      # escape: el mismo valor se leería distinto según lo lance el servicio o
      # 'orbit exec'. Mejor rechazarlo que guardar algo ambiguo.
      [[ "$val" == *\'* ]] && die "El valor lleva una comilla simple, y systemd y bash no la escapan igual. Edítalo con 'orbit env %s' y comprueba con 'orbit exec %s env'." "$name" "$name"
      local had="no"; _env_has "$f" "$key" && had="si"
      _env_write "$f" "$key" "$val"
      [[ "$had" == "si" ]] && ok "%s actualizada en %s" "$key" "$name" || ok "%s añadida a %s" "$key" "$name"
      if [[ "$restart" == "yes" ]] && needs_svc "$A_TYPE"; then
        systemctl restart "$(svc_name "$name")"; ok "«%s» reiniciada" "$name"
      else
        _env_reminder "$name"
      fi
      logline "env set $name $key" ;;
    unset)
      local key="${1:-}"
      [[ -n "$key" ]] || die "uso: orbit env unset <app> <CLAVE>"
      # Igual que en 'get', y aquí importa más: sin esto, 'unset' anunciaba
      # «eliminada» sobre una clave que no había tocado.
      _env_key_ok "$key" || die "'%s' no es un nombre válido. Solo letras, números y '_', sin empezar por número." "$key"
      if ! _env_has "$f" "$key"; then
        info "'%s' no estaba definida en %s" "$key" "$name"
        return 0
      fi
      _env_write "$f" "$key"
      ok "%s eliminada de %s" "$key" "$name"
      _env_reminder "$name"
      logline "env unset $name $key" ;;
    list)
      # Solo los nombres: los valores son secretos y están a un 'env get' de
      # distancia, sin acabar en el historial ni en una captura de pantalla.
      # Eso vale también para el JSON: un panel que enseñe el .env entero es un
      # panel que filtra la contraseña de la base de datos en una captura.
      # El '|| true' no es adorno: con pipefail, un .env vacío hace que grep
      # devuelva 1, la asignación herede ese 1 y errexit se lleve el comando
      # por delante sin decir nada. La rama de abajo que anuncia que está
      # vacío era, hasta esta línea, inalcanzable.
      local keys
      keys="$(grep -oE '^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' "$f" 2>/dev/null \
              | sed 's/^[[:space:]]*//; s/^export[[:space:]]*//; s/=$//' || true)"
      if [[ "$JSON" == "yes" ]]; then
        local -a ks=(); [[ -n "$keys" ]] && mapfile -t ks <<<"$keys"
        printf '{"schema":%s,"app":%s,"keys":%s}\n' \
          "$JSON_SCHEMA" "$(_j_str "$name")" "$(_j_list "${ks[@]}")"
      elif [[ -z "$keys" ]]; then
        info "El .env de %s está vacío." "$name"
      else
        printf '%s\n' "$keys"
      fi ;;
  esac
}

cmd_domain() {
  need_root domain
  local name="${1:-}"
  [[ -n "$name" ]] || name="$(pick_app 'App')" || return 0
  load_app "$name"
  ask A_DOMAIN "Dominio principal" "$A_DOMAIN"
  ask A_ALIASES "Dominios extra" "$A_ALIASES"
  save_app
  render_nginx "$name" && ok "Dominios actualizados"
  confirm "¿Emitir/renovar el certificado para %s?" y "$A_DOMAIN" && cmd_ssl "$name"
}

# Dos confirmaciones distintas porque son dos daños distintos: quitar la app de
# nginx y de systemd se deshace volviéndola a crear, pero borrar /srv/apps/<app>
# se lleva las releases, el .env y las subidas de los usuarios. Por eso --yes
# hace lo primero y hace falta --purge para lo segundo.
cmd_remove() {
  need_root remove
  local name="" yes="no" purge="no" a
  for a in "$@"; do
    case "$a" in
      -y|--yes|--si)          yes="yes" ;;
      --purge|--borrar-todo)  purge="yes" ;;
      -h|--help|help|ayuda)
        printf '%b' "$(t "  uso: orbit remove <app> [-y] [--purge]\n\
       -y        no preguntar\n\
       --purge   borrar también %s/<app> (releases, .env y subidas)\n" "$APPS_DIR")"
        return 0 ;;
      -*) die "orbit remove: no entiendo «%s»." "$a" ;;
      *)  [[ -n "$name" ]] && die "orbit remove: sobra «%s»." "$a"; name="$a" ;;
    esac
  done
  if [[ -z "$name" ]]; then
    [[ "$yes" == "yes" ]] && die "uso: orbit remove <app> [-y] [--purge]"
    name="$(pick_app 'App a eliminar')" || return 0
  fi
  load_app "$name"
  warn "Se eliminará la app '%s', su configuración de nginx y sus ficheros." "$A_NAME"
  if [[ "$yes" != "yes" ]]; then
    local typed; ask typed "Escribe el nombre para confirmar" ""
    [[ "$typed" == "$A_NAME" ]] || { info "Cancelado"; return 0; }
  fi
  if needs_svc "$A_TYPE"; then
    systemctl disable --now "$(svc_name "$name")" >/dev/null 2>&1 || true
    # El puente del reinicio sin corte no debería existir fuera de un
    # despliegue, pero un despliegue muerto a mitad lo deja atrás.
    systemctl stop "$(svc_next_name "$name")" >/dev/null 2>&1 || true
    rm -f "$(svc_unit "$name")" "$(svc_next_unit "$name")"
    systemctl daemon-reload
  fi
  # El pool se va siempre que exista: un pool huérfano apuntando a un usuario
  # que ya no está deja a php-fpm negándose a arrancar, y con él TODAS las
  # apps PHP del servidor.
  if [[ -f "$(php_pool_file "$name")" ]]; then
    _php_pool_remove "$name"
    _php_fpm_reload || true
  fi
  rm -f "$(nginx_link "$name")" "$(nginx_file "$name")"
  nginx -t >/dev/null 2>&1 && systemctl reload nginx
  # Sin --purge no se borran los datos aunque venga --yes: «no preguntes» no
  # puede significar «y además llévate el .env y las subidas».
  if [[ "$purge" == "yes" ]] || { [[ "$yes" != "yes" ]] && confirm "¿Borrar también %s (código y releases)?" n "$(app_dir "$name")"; }; then
    rm -rf "$(app_dir "$name")"
    purge="yes"
  else
    info "Los ficheros siguen en %s. Bórralos con 'rm -rf' o repite con --purge." "$(app_dir "$name")"
  fi
  rm -f "$(app_conf "$name")"
  # El usuario del aislamiento es de esta app y de nadie más, así que se va
  # con ella — pero SOLO con ella: sin --purge las releases y el .env se
  # quedan, y borrar a su único dueño los dejaría huérfanos bajo un UID
  # numérico, con el 0640 inaccesible (revisión del PR #10). La guarda contra
  # DEPLOY_USER no es decorativa: una conf editada a mano con A_USER='deploy'
  # no puede acabar en un userdel del usuario que despliega todo el servidor.
  if [[ -n "$A_USER" && "$A_USER" != "$DEPLOY_USER" ]]; then
    if [[ "$purge" == "yes" ]]; then
      userdel "$A_USER" >/dev/null 2>&1 \
        && ok "Usuario de sistema '%s' eliminado" "$A_USER" \
        || warn "No he podido eliminar el usuario '%s'; bórralo con:  userdel %s" "$A_USER" "$A_USER"
    else
      info "El usuario '%s' se queda: es el dueño de lo que hay en %s." "$A_USER" "$(app_dir "$name")"
    fi
  fi
  ok "App '%s' eliminada" "$name"
  logline "remove $name purge=$purge"
}

# ═══════════════════════════════════════════════════ aislamiento ══════════
# Migra una app existente al aislamiento por usuario. Las nuevas ya nacen así;
# esto es para las anteriores a la v1.0.3, y por eso reinicia por el camino
# clásico: es una migración que se hace una vez, no un despliegue.
cmd_isolate() { # orbit isolate <app>
  need_root isolate
  local name="${1:-}"
  [[ "$name" == "-h" || "$name" == "--help" || "$name" == "help" ]] && {
    printf '%b' "$(t "  uso: orbit isolate <app>\n\
       Crea un usuario de sistema propio para la app y le pasa sus ficheros.\n\
       Sólo apps con proceso; las nuevas ya nacen aisladas.\n")"
    return 0
  }
  if [[ -z "$name" ]]; then
    name="$(pick_app 'App a aislar')" || return 0
  fi
  load_app "$name"
  needs_svc "$A_TYPE" || _serves_php \
    || die "Una web estática no ejecuta nada: no hay proceso al que darle un usuario propio."
  if [[ -n "$A_USER" && "$A_USER" != "$DEPLOY_USER" ]]; then
    ok "'%s' ya está aislada: su proceso corre como %s" "$name" "$A_USER"
    return 0
  fi
  local u; u="$(_app_username "$name")"
  local creado="no"; id -u "$u" >/dev/null 2>&1 || creado="si"
  _ensure_app_user "$u" "$name"
  # El pool, ANTES de tocar un solo fichero. Si php-fpm no lo carga no hay
  # aislamiento posible, y enterarse después de haber cambiado el dueño de
  # todo deja la app rota entre dos sillas: sus ficheros ya no los lee el pool
  # compartido y el suyo no existe. Es el principio 4 aplicado aquí.
  if _serves_php && ! _php_pool_apply "$name" "$u"; then
    _php_pool_remove "$name"; _php_fpm_reload || true
    [[ "$creado" == "si" ]] && { userdel "$u" >/dev/null 2>&1 || true; }
    err "php-fpm no ha cargado el pool de '%s'." "$name"
    info "Mira qué dice:  journalctl -u php%s-fpm -n 30" "$PHP_VER"
    die "No he cambiado nada: la app sigue exactamente como estaba."
  fi
  # La caché de git no se toca: es del fetcher, que la escribe en cada fetch.
  local d
  for d in "$APPS_DIR/$name/releases" "$(app_shared "$name")"; do
    [[ -d "$d" ]] && chown -R "$u:$u" "$d"
  done
  [[ -L "$(app_current "$name")" ]] && chown -h "$u:$u" "$(app_current "$name")"
  # El .env es el único fichero 0640 de shared/, y por eso el único que puede
  # quedarse sin lector durante el relevo. Con PHP, quien sirve hasta la línea
  # de abajo sigue siendo el pool COMPARTIDO —corre como deploy—, y el chown de
  # arriba acaba de quitarle el .env: hasta que nginx mueva el tráfico, la app
  # contesta sin su configuración. Medido en un VPS: un segundo largo.
  #
  # No hay orden que lo evite —invertirlo deja al pool nuevo sirviendo mientras
  # el .env es todavía de deploy, y falla igual—, así que durante el relevo lo
  # leen los dos: dueño el usuario nuevo, grupo el viejo. No abre nada que no
  # estuviera abierto, porque antes de migrar el .env ERA de deploy.
  local envf; envf="$(app_shared "$name")/.env"
  local relevo="no"
  if _serves_php && [[ -f "$envf" ]]; then
    chown "$u:$DEPLOY_USER" "$envf"; relevo="si"
  fi
  A_USER="$u"; save_app
  render_systemd "$name"
  # El pool ya está cargado y comprobado más arriba: aquí sólo se mueve el
  # tráfico, que es lo último que se toca.
  if _serves_php; then
    render_nginx "$name" \
      || warn "nginx ha rechazado el vhost nuevo. Revísalo con:  orbit nginx-rebuild %s" "$name"
    # Y el drenaje, por lo mismo que en el despliegue (§5.2): 'systemctl reload'
    # vuelve al entregar la señal, así que los workers viejos siguen hablándole
    # al socket compartido un instante más. Cerrar el grupo antes de que
    # terminen reabre el hueco que este código acaba de cerrar.
    nginx_drain
  fi
  # El tráfico ya está en el socket propio: se cierra el grupo y el .env vuelve
  # a ser legible sólo por su dueño, que es el punto de todo esto.
  [[ "$relevo" == "si" ]] && chgrp "$u" "$envf"
  if systemctl is-active --quiet "$(svc_name "$name")" 2>/dev/null; then
    systemctl restart "$(svc_name "$name")"
    health_wait "$A_PORT" 30 \
      || warn "La app no responde todavía. Mira 'orbit logs %s'." "$name"
  fi
  ok "'%s' aislada: su proceso corre como %s" "$name" "$u"
  logline "isolate $name user=$u"
}

# Los servicios del sistema que Orbit da por supuestos. Una lista y no dos: la
# miran la tabla de 'status' y su JSON.
_base_services() { printf '%s\n' nginx postgresql "php${PHP_VER}-fpm" fail2ban ufw; }

# ¿Está funcionando este servicio? Para casi todos, preguntárselo a systemd es
# la respuesta entera. 'ufw' no.
#
# 'ufw enable' hace dos cosas: carga las reglas en el kernel **en ese momento**
# y deja la unidad habilitada para el arranque siguiente. Lo que no hace es
# arrancar la unidad, así que hasta el primer reinicio 'systemctl is-active ufw'
# contesta 'inactive' con el cortafuegos filtrando de verdad — comprobado en la
# máquina recién instalada: 'ExecMainStartTimestamp' vacío y las reglas de 2222,
# 80 y 443 puestas en la cadena ufw-user-input.
#
# O sea que 'orbit status' anunciaba el cortafuegos apagado justo después de
# instalar, que es cuando más se mira. Es el «instalar un paquete no es tener un
# servicio funcionando» de §23.3 del revés: aquí la unidad no ha corrido y la
# cosa sí está en pie. A quien hay que preguntarle es a ufw.
#
# Con LC_ALL=C porque ufw traduce su salida, y esta comparación es contra el
# texto: sin fijar el idioma, un servidor en otra lengua diría que no.
_service_activo() { # _service_activo <servicio>
  if [[ "$1" == "ufw" ]]; then
    local st; st="$(LC_ALL=C ufw status 2>/dev/null | head -1)" || true
    [[ "$st" == *"Status: active"* ]]
    return $?
  fi
  systemctl is-active --quiet "$1" 2>/dev/null
}

# El JSON del estado da valores crudos —kilobytes, segundos, porcentajes— y no
# los '1,9Gi' de la tabla: quien pinta una barra de disco necesita el número,
# no la abreviatura, y volver de la abreviatura al número es imposible.
_status_json() {
  local s sep="" total used avail dtotal dused dpct
  read -r total used avail < <(free -k | awk '/^Mem:/{print $2,$3,$7}')
  read -r dtotal dused dpct < <(df -k --output=size,used,pcent / | tail -1 | tr -d '%')
  printf '{"schema":%s,"host":{"hostname":%s,"ip":%s,"uptime_seconds":%s,"load":[%s],' \
    "$JSON_SCHEMA" \
    "$(_j_str "$(hostname -f 2>/dev/null || hostname)")" \
    "$(_j_str "$(hostname -I | awk '{print $1}')")" \
    "$(_j_num "$(cut -d. -f1 /proc/uptime)")" \
    "$(cut -d' ' -f1-3 /proc/loadavg | tr ' ' ',')"
  printf '"memory_kb":{"total":%s,"used":%s,"available":%s},' \
    "$(_j_num "$total")" "$(_j_num "$used")" "$(_j_num "$avail")"
  printf '"disk_kb":{"mount":"/","total":%s,"used":%s,"use_percent":%s}},"services":[' \
    "$(_j_num "$dtotal")" "$(_j_num "$dused")" "$(_j_num "$dpct")"
  while read -r s; do
    printf '%s{"name":%s,"active":%s}' "$sep" "$(_j_str "$s")" \
      "$(_service_activo "$s" && printf 'true' || printf 'false')"
    sep=","
  done < <(_base_services)
  printf '],"apps":%s}\n' "$(_apps_json)"
}

cmd_status() {
  [[ "$JSON" == "yes" ]] && { _status_json; return 0; }
  title "Estado del servidor"
  printf "%s\n" "$(t "  Host        %s (%s)" "$(hostname -f 2>/dev/null || hostname)" "$(hostname -I | awk '{print $1}')")"
  printf "%s\n" "$(t "  Uptime      %s" "$(uptime -p 2>/dev/null | sed 's/up //')")"
  printf "%s\n" "$(t "  Carga       %s" "$(cut -d' ' -f1-3 /proc/loadavg)")"
  # El «usados de» iba dentro del awk, donde ningún catálogo lo alcanza.
  printf "%s\n" "$(t "  Memoria     %s usados de %s" "$(free -h | awk '/^Mem:/{print $3}')" "$(free -h | awk '/^Mem:/{print $2}')")"
  printf "%s\n" "$(t "  Disco       %s usados de %s (%s)" "$(df -h / | awk 'NR==2{print $3}')" "$(df -h / | awk 'NR==2{print $2}')" "$(df -h / | awk 'NR==2{print $5}')")"
  echo
  local s
  # El '< <(_base_services)' no es opcional: sin él este 'while read' se queda
  # leyendo la **entrada estándar**. Dejaba la lista de servicios vacía —una
  # sección que no dice nada y nadie echa de menos— y además se comía lo que
  # viniera por stdin: desde el menú, las teclas que pulsabas después.
  while read -r s; do
    if _service_activo "$s"; then
      printf "  ${GRN}%s${R} %s\n" "$G_ON" "$s"
    else
      printf "  ${RED}%s${R} %s ${D}%s${R}\n" "$G_OFF" "$s" "$(t "(inactivo)")"
    fi
  done < <(_base_services)
  echo
  local n
  for n in $(app_names); do
    load_app "$n"
    if needs_svc "$A_TYPE"; then
      if systemctl is-active --quiet "$(svc_name "$n")" 2>/dev/null; then
        printf "  ${GRN}%s${R} %-18s %s\n" "$G_ON" "$n" "$A_DOMAIN"
      else
        printf "  ${RED}%s${R} %-18s %s ${D}%s${R}\n" "$G_OFF" "$n" "$A_DOMAIN" "$(t "(parada)")"
      fi
    else
      printf "  ${BLU}%s${R} %-18s %s ${D}%s${R}\n" "$G_ON" "$n" "$A_DOMAIN" "$(t "(estática)")"
    fi
  done
  echo
}

# El diagnóstico se recoge primero y se pinta después. Antes cada comprobación
# imprimía su línea sobre la marcha, y eso hacía imposible dar la misma
# respuesta en JSON sin escribir las comprobaciones dos veces: dos copias que
# se separan a la primera, y la que se quede atrás miente por omisión.
#
# Niveles: ok, info, warn, error. 'info' es un dato que acompaña a otro —los
# días que le quedan a un certificado— y no un problema.
# El quinto campo, DOC_ACT, es lo que separa «sé cuál es el arreglo» de
# «puedo aplicarlo»: una orden que Orbit puede ejecutar por su cuenta. Está
# vacío en la mayoría de comprobaciones, y eso es lo normal, no una carencia.
#
# Para que un arreglo entre aquí tiene que cumplir las cuatro:
#
#   1. **No decide nada por ti.** Arrancar un servicio parado es reponer lo
#      que ya se quería; elegir qué borrar de un disco lleno, no.
#   2. **No hace falta hablar con nadie.** Nada interactivo y nada que dependa
#      de una contraseña, un navegador o un token que sólo tú tienes.
#   3. **Se deshace.** Reasignar un puerto se revierte con otro 'orbit port';
#      instalar paquetes en el servidor, no del todo.
#   4. **No toca producción a ciegas.** Un vhost se valida con 'nginx -t'
#      antes de recargar, igual que en el resto de Orbit.
#
# Lo que queda fuera por estas reglas, y a propósito: instalar pnpm o hugo
# (regla 3 — instalar cosas en el servidor de alguien no es un diagnóstico),
# conectar GitHub o Cloudflare (regla 2), liberar disco (regla 1), emitir o
# renovar certificados (hay límites de peticiones y se renuevan solos), y
# regenerar la unidad de una app, que necesita un despliegue entero para que
# la caché de corepack quede sembrada — ver §5.1.
declare -a DOC_LEVEL=() DOC_ID=() DOC_MSG=() DOC_FIX=() DOC_ACT=()
# ¿Está 'dig'? En una función y no incrustado donde se usa, para que una prueba
# pueda decidirlo. Manipular el PATH para simular que falta depende de dónde
# esté instalado en la máquina que ejecuta las pruebas: aquí no estaba y en el
# runner de CI sí, así que la misma prueba pasaba en un sitio y fallaba en el
# otro sin que nada hubiera cambiado.
_have_dig() { command -v dig >/dev/null 2>&1; }

_doc() { # _doc <ok|info|warn|error> <id> <mensaje> [cómo se arregla] [orden]
  DOC_LEVEL+=("$1"); DOC_ID+=("$2"); DOC_MSG+=("$3"); DOC_FIX+=("${4:-}")
  DOC_ACT+=("${5:-}")
}

# ── los arreglos, uno por función ────────────────────────────────────────
# En funciones y no en cadenas sueltas para que se puedan leer, probar y
# encontrar. Cada una devuelve 0 si ha arreglado lo suyo.

_fix_service() { # _fix_service <unidad>
  systemctl start "$1" 2>/dev/null || return 1
  # Arrancar no es estar vivo: una unidad puede aceptar el 'start' y morirse
  # acto seguido. Se comprueba lo segundo, que es lo que se prometía.
  sleep 1
  systemctl is-active --quiet "$1" 2>/dev/null
}

# El vhost de una app que sigue registrada. No carga la app aquí porque
# 'nginx_vhost' ya hace su propio 'load_app' —lo cual importa, porque los
# arreglos corren DESPUÉS del recorrido de las apps y las A_* traen las de la
# última que se miró—. Lo comprueba doctorfix_test escribiendo el vhost con
# otra app cargada a propósito.
#
# Y se comprueba el resultado en vez de fiarse del código de salida: render
# devuelve 0 con el fichero escrito aunque la recarga de nginx no salga, que
# está bien para desplegar pero aquí lo que se prometía es que el vhost esté.
_fix_vhost() { # _fix_vhost <app>
  render_nginx "$1" || return 1
  [[ -f "$(nginx_file "$1")" && -L "$(nginx_link "$1")" ]]
}

_fix_default_server() {
  nginx_default_write || true
  nginx -t >/dev/null 2>&1 || return 1
  systemctl reload nginx 2>/dev/null || return 1
  return 0
}

# Dos apps con el mismo puerto: la que pierde la carrera muere con EADDRINUSE
# cada tres segundos, para siempre. Se mueven todas menos una.
#
# **Cuál se queda con el puerto importa.** La que esté viva es la que está
# sirviendo ahora mismo, así que moverla cortaría un servicio que funciona para
# arreglar otro que no. Se queda esa; si ninguna está viva, la primera, que es
# una elección tan buena como cualquier otra y al menos es reproducible.
#
# Sin número: cmd_port mira si el puerto choca y sólo entonces mueve la app,
# así que no se mueve nada porque sí.
_fix_ports() {
  local p n movidas=0
  local -a dups=() duenos=() resto=()
  mapfile -t dups < <(used_ports | sort | uniq -d)
  for p in "${dups[@]}"; do
    [[ -n "$p" ]] || continue
    duenos=()
    for n in $(app_names); do
      [[ "$(app_port "$n")" == "$p" ]] && duenos+=("$n")
    done
    (( ${#duenos[@]} > 1 )) || continue
    # Quién se queda: la primera que esté activa.
    local quedan="" i
    for i in "${!duenos[@]}"; do
      if systemctl is-active --quiet "$(svc_name "${duenos[i]}")" 2>/dev/null; then
        quedan="${duenos[i]}"; break
      fi
    done
    [[ -n "$quedan" ]] || quedan="${duenos[0]}"
    resto=()
    for n in "${duenos[@]}"; do [[ "$n" == "$quedan" ]] || resto+=("$n"); done
    for n in "${resto[@]}"; do
      cmd_port "$n" >/dev/null 2>&1 && movidas=$((movidas + 1))
    done
  done
  (( movidas > 0 ))
}

_doctor_collect() {
  DOC_LEVEL=(); DOC_ID=(); DOC_MSG=(); DOC_FIX=(); DOC_ACT=()

  if nginx -t >/dev/null 2>&1; then _doc ok    nginx "$(t "nginx: configuración válida")"
  else                              _doc error nginx "$(t "nginx: configuración inválida (nginx -t)")"; fi

  if systemctl is-active --quiet postgresql; then _doc ok   postgresql "$(t "PostgreSQL activo")"
  else _doc warn postgresql "$(t "PostgreSQL parado")" \
         "$(t "arráncalo con:  sudo systemctl start postgresql")" "_fix_service postgresql"; fi

  if command -v pnpm >/dev/null; then _doc ok    pnpm "pnpm $(pnpm -v)"
  else                                _doc error pnpm "$(t "pnpm no encontrado")"; fi

  if sudo -u "$DEPLOY_USER" -H gh auth status >/dev/null 2>&1; then
    _doc ok   github "$(t "GitHub conectado")"
  else
    _doc warn github "$(t "GitHub sin conectar (orbit github)")"
  fi

  if [[ -f "$ETC_DIR/cloudflare.ini" ]]; then _doc ok   cloudflare-token "$(t "Token de Cloudflare presente")"
  else                                        _doc warn cloudflare-token "$(t "Sin token de Cloudflare (orbit cf-token)")"; fi

  # Un servidor por defecto sin bloque para el 443 hace que una petición HTTPS
  # con un nombre desconocido —o con el de una app a la que aún no se le ha
  # emitido el certificado— acabe en el primer vhost con certificado, que le
  # enseña a un desconocido la web de otro. Los servidores instalados antes de
  # que existiera ese bloque siguen así hasta que se regeneran.
  if [[ ! -f "$NGINX_DEFAULT_CONF" ]]; then
    _doc error default-server "$(t "No hay servidor por defecto: un nombre desconocido lo atiende cualquier app")" \
      "$(t "créalo con:  sudo orbit nginx-rebuild")" "_fix_default_server"
  elif ! grep -q 'listen 443 ssl default_server' "$NGINX_DEFAULT_CONF"; then
    _doc error default-server "$(t "El servidor por defecto no cubre el 443: una petición HTTPS con un nombre desconocido enseña la web de otra app")" \
      "$(t "arréglalo con:  sudo orbit nginx-rebuild")" "_fix_default_server"
  else
    _doc ok default-server "$(t "Servidor por defecto cubriendo 80 y 443")"
  fi

  local free; free=$(df --output=pcent / | tail -1 | tr -dc '0-9')
  if (( free < 85 )); then _doc ok   disk "$(t "Disco al %s%%" "$free")"
  else                     _doc warn disk "$(t "Disco al %s%% — conviene limpiar" "$free")"; fi

  # Dos apps con el mismo puerto interno: la segunda unidad muere con
  # EADDRINUSE en bucle y nginx sirve a la que ganó la carrera.
  local dup; dup="$(used_ports | sort | uniq -d | tr '\n' ' ')"
  if [[ -n "${dup// /}" ]]; then
    _doc error ports "$(t "Puertos internos duplicados: %s" "${dup% }")" \
      "$(t "arréglalo con 'orbit port <app>' en una de las apps afectadas")" "_fix_ports"
  else
    _doc ok ports "$(t "Sin puertos internos duplicados")"
  fi

  # Una app en automático cuyo remoto lleva horas sin contestar no se está
  # actualizando, y eso no se nota mirando la web: sigue sirviendo lo viejo.
  _watch_state_load
  local subj fix
  for subj in "${!WS_STATE[@]}"; do
    [[ "$subj" == remoto:* ]] || continue
    fix="$(t "compruébalo con:  orbit deploy %s" "${subj#remoto:}")"
    case "${WS_STATE[$subj]}" in
      sin-contacto) _doc error "remote:${subj#remoto:}" \
        "$(t "No consigo consultar el repositorio de «%s»: no se despliega sola" "${subj#remoto:}")" "$fix" ;;
      sin-rama)     _doc error "remote:${subj#remoto:}" \
        "$(t "La rama configurada de «%s» ya no existe en el remoto" "${subj#remoto:}")" "$fix" ;;
    esac
  done

  # Unidades escritas antes de que la unidad declarara su propio HOME. Con
  # ProtectHome=true el HOME que systemd deduce de User= (/home/deploy) está
  # tapado por un tmpfs en modo 000, así que corepack no puede leer el gestor de
  # paquetes que fija el repositorio y la app reinicia en bucle:
  #
  #   EACCES: permission denied, opendir '/home/deploy/.cache/node/corepack/…'
  #
  # No se arregla desde aquí porque regenerar la unidad sin rehacer el build
  # dejaría la caché vacía: quien lo arregla de verdad es el despliegue.
  local n ip days edad conn usa_php="" usa_hugo="" usa_go="" usa_bun="" usa_deno="" viejas=""
  for n in $(app_names); do
    load_app "$n"
    [[ "$A_TYPE" == "php" || "$A_TYPE" == "laravel" || "$A_PHP" == "yes" ]] \
      && usa_php="${usa_php:+$usa_php }$n"
    # 'php artisan down' deja su bandera en storage/framework/maintenance.php, y
    # ese storage/ es compartido: sobrevive a los despliegues y la hereda
    # cualquier release futura, incluido el despliegue que iba a arreglar el
    # problema. Y 'orbit maintenance status' diría que está apagado, porque mira
    # otro fichero. Una web caída que ninguna herramienta reconoce como caída.
    # Una app con proceso que no está corriendo es una web devolviendo 502, y
    # doctor no lo miraba: con la unidad parada salía sin una palabra del tema
    # —nginx válido, PostgreSQL activo, disco bien— mientras 'orbit list' sí
    # decía 'stopped'. El dato existía y no estaba donde se pregunta «¿qué va
    # mal?». Salió comprobando el arranque en frío de un servidor.
    #
    # 'svc_state' distingue las tres cosas que hay que distinguir: corriendo,
    # parada, y «esta clase de app no tiene servicio» —una web estática no está
    # parada, es que no hay nada que arrancar—.
    #
    # Sin acción de --fix a propósito, por lo mismo que el mantenimiento de
    # aquí abajo: una app puede estar parada porque alguien la paró, y levantar
    # lo que otro bajó a propósito es peor que dejarlo. Y si se está muriendo en
    # bucle, arrancarla no arregla nada — apaga la señal y deja el fuego.
    if [[ "$(svc_state "$n" "$A_TYPE")" == "stopped" ]]; then
      _doc error "service-$n" \
        "$(t "'%s' no está corriendo: su web devuelve 502" "$n")" \
        "$(t "mira por qué con 'orbit logs %s' y arráncala con:  sudo systemctl start %s" "$n" "$(svc_name "$n")")"
    fi
    # Y el vhost, que es lo que separa «esta app existe» de «esta app se puede
    # visitar». Un descriptor sin vhost es una app registrada, con su release
    # compilada, su pool de php-fpm escrito y su unidad en verde, cuyo dominio
    # no atiende nadie: lo recoge el servidor por defecto y el visitante recibe
    # una conexión cerrada —ni 404 ni 502, curl dice 000—.
    #
    # Ninguna pregunta llegaba al dato. 'nginx -t' pasa, porque lo que falta no
    # es sintaxis sino un fichero; 'orbit list' pintaba 'php-fpm', que es una
    # constante escrita para las apps PHP y no puede decir nunca que algo va
    # mal; y doctor salía entero en verde. Salió comprobando un arranque en
    # frío, con una app que llevaba una hora invisible y nada que la acusara.
    #
    # Se miran las dos piezas: el fichero y el enlace. Con el fichero presente
    # y el enlace ausente nginx no lo carga, que es el mismo agujero por la
    # otra mitad.
    #
    # Y este SÍ lleva acción, al revés que el mantenimiento o la unidad parada:
    # aquellos pueden ser una decisión de alguien, y deshacerla sin preguntar
    # es peor que dejarla. Un vhost que falta no lo decide nadie — el vhost se
    # genera del descriptor, así que rehacerlo no inventa nada.
    if [[ ! -f "$(nginx_file "$n")" || ! -L "$(nginx_link "$n")" ]]; then
      _doc error "vhost-$n" \
        "$(t "'%s' está registrada pero nginx no la sirve: le falta el vhost" "$n")" \
        "$(t "regenéralo con:  sudo orbit doctor --fix")" \
        "_fix_vhost $(printf '%q' "$n")"
    fi
    [[ "$A_TYPE" == "laravel" && -f "$(app_shared "$n")/storage/framework/maintenance.php" ]] \
      && _doc warn "artisan-down-$n" \
           "$(t "'%s' está en mantenimiento por Laravel ('php artisan down')" "$n")" \
           "$(t "levántala con:  orbit exec %s '%s'" "$n" "$(_app_cd 'php artisan up')")"
    # Y el mantenimiento propio, que es el mismo agujero por el otro lado y
    # faltaba: Orbit contaba el de Laravel y se callaba el suyo. La bandera
    # vive en shared/, así que sobrevive a los despliegues **y al arranque de
    # la máquina** — en el arranque no corre nada de Orbit (§5.5), luego nadie
    # la retira. Un despliegue muerto de mala manera (SIGKILL, corte de luz;
    # con SIGTERM la trampa de salida sí la quita) deja una web devolviendo
    # 503 a todo el mundo, y ahí se queda.
    #
    # Sin umbral, a diferencia del vigilante, y a propósito: el vigilante corre
    # cada minuto y **notifica**, así que un mantenimiento puesto hace dos
    # minutos sería una alarma falsa y por eso espera WATCH_MAINT_MAX. Aquí lo
    # pregunta una persona ahora mismo, y «esta web responde 503» nunca es
    # ruido cuando lo que se está preguntando es qué va mal.
    #
    # Sin acción, como el autodespliegue en rojo: un mantenimiento se pone a
    # mano y con motivo, y quitarlo sin preguntar es publicar una web que
    # alguien había bajado a propósito.
    if _maint_is_on "$n"; then
      edad=$(( ( $(date +%s) - $(stat -c %Y "$(maint_flag "$n")" 2>/dev/null || date +%s) ) / 60 ))
      _doc warn "maint-$n" \
        "$(t "'%s' está en mantenimiento y responde 503 desde hace %s min" "$n" "$edad")" \
        "$(t "quítalo con:  orbit maintenance off %s" "$n")"
    fi
    # Una cola sin nadie que la ejecute: los trabajos se apilan, la web sigue
    # contestando 200 y no hay error en ninguna parte (medido, §18.9). El aviso
    # del despliegue sólo lo ve quien despliega; aquí lo ve quien pregunta qué
    # va mal, que es cuando alguien echa de menos un correo.
    if [[ "$A_TYPE" == "laravel" && "$A_QUEUE" != "yes" ]]; then
      conn="$(_queue_connection "$n")"
      [[ -n "$conn" && "$conn" != "sync" && "$conn" != "null" ]] \
        && _doc warn "queue-$n" \
             "$(t "'%s' encola trabajos (QUEUE_CONNECTION=%s) y nadie los ejecuta" "$n" "$conn")" \
             "$(t "enciéndelo con:  orbit queue enable %s" "$n")"
    fi
    [[ "$A_BUILD" == *hugo* ]] && usa_hugo="${usa_hugo:+$usa_hugo }$n"
    [[ "$A_TYPE" == "go" ]] && usa_go="${usa_go:+$usa_go }$n"
    # Bun cuenta también cuando sólo es el gestor de paquetes: el build lo llama
    # igual, y sin binario el despliegue muere en el 'bun install'.
    [[ "$A_TYPE" == "bun"  || "$A_PKG" == "bun"  ]] && usa_bun="${usa_bun:+$usa_bun }$n"
    [[ "$A_TYPE" == "deno" || "$A_PKG" == "deno" ]] && usa_deno="${usa_deno:+$usa_deno }$n"
    if needs_svc "$A_TYPE" && [[ -f "$(svc_unit "$n")" ]] \
       && ! grep -q '^Environment=COREPACK_HOME=' "$(svc_unit "$n")"; then
      viejas="${viejas:+$viejas }$n"
    fi
  done
  if [[ -n "$viejas" ]]; then
    _doc warn service-home \
      "$(t "Unidad anterior al HOME propio, y su app puede no arrancar: %s" "$viejas")" \
      "$(t "vuelve a desplegarlas:  orbit deploy <app>")"
  fi
  if [[ -n "$usa_hugo" ]]; then
    if command -v hugo >/dev/null; then
      _doc ok hugo "$(t "hugo %s (lo usan: %s)" "$(hugo version 2>/dev/null | grep -oE 'v[0-9.]+' | head -1)" "$usa_hugo")"
    else
      _doc error hugo "$(t "hugo no está instalado, y lo necesitan: %s" "$usa_hugo")" \
        "$(t "instálalo con:  sudo apt-get install -y hugo")"
    fi
  fi
  if [[ -n "$usa_go" ]]; then
    # 'command -v' no basta: la instalación que recomienda go.dev deja el
    # binario en /usr/local/go/bin, que no está en el secure_path de sudo con el
    # que corre esto. Sin el segundo brazo, el diagnóstico diría que falta Go en
    # un servidor donde Go está instalado y los despliegues funcionan — y eso es
    # peor que no comprobarlo, porque manda a arreglar lo que no está roto.
    local gobin=""
    if command -v go >/dev/null; then gobin="$(command -v go)"
    elif [[ -x /usr/local/go/bin/go ]]; then gobin="/usr/local/go/bin/go"; fi
    if [[ -n "$gobin" ]]; then
      _doc ok go "$(t "%s (lo usan: %s)" "$("$gobin" version 2>/dev/null | grep -oE 'go[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)" "$usa_go")"
    else
      _doc error go "$(t "Go no está instalado, y lo necesitan: %s" "$usa_go")" \
        "$(t "instálalo desde go.dev/dl y añade /usr/local/go/bin al PATH")"
    fi
  fi
  # Bun y Deno se instalan con un script que los deja en $HOME/.bun o
  # $HOME/.deno. Quien lo ejecuta suele ser root, y luego enlaza el binario en
  # /usr/local/bin — con lo que 'command -v bun' funciona **para root**, que es
  # quien corre esto, y falla para el usuario de despliegue, que es quien
  # compila. El resultado era un diagnóstico en verde y todos los despliegues
  # muriendo con 'bun: command not found'. Por eso se pregunta como él.
  local rt
  for rt in bun deno; do
    local usa=""; [[ "$rt" == "bun" ]] && usa="$usa_bun" || usa="$usa_deno"
    [[ -n "$usa" ]] || continue
    if _deploy_tiene "$rt" && _unidad_tiene "$rt"; then
      _doc ok "$rt" "$(t "%s %s (lo usan: %s)" "$rt" "$(_deploy_version "$rt")" "$usa")"
    elif _deploy_tiene "$rt"; then
      # Compila pero no arranca: el binario está en el HOME del usuario de
      # despliegue y el PATH sale de su perfil de login, que la unidad de
      # systemd no lee. El build va bien y el servicio muere con 127.
      _doc error "$rt" \
        "$(t "%s compila pero no arrancará: no está en el PATH del servicio (lo usan: %s)" "$rt" "$usa")" \
        "$(t "cópialo a /usr/local/bin, que es donde mira la unidad")"
    elif command -v "$rt" >/dev/null; then
      # Está, pero no para quien compila: el caso del enlace a /root.
      _doc error "$rt" \
        "$(t "%s existe, pero el usuario %s no lo alcanza, y lo necesitan: %s" "$rt" "$DEPLOY_USER" "$usa")" \
        "$(t "instálalo donde todos lo vean, no en el HOME de root")"
    else
      local como=""
      [[ "$rt" == "bun" ]] \
        && como="$(t "instálalo con:  curl -fsSL https://bun.sh/install | bash, y copia el binario a /usr/local/bin")" \
        || como="$(t "instálalo con:  curl -fsSL https://deno.land/install.sh | sh, y copia el binario a /usr/local/bin")"
      _doc error "$rt" "$(t "%s no está instalado, y lo necesitan: %s" "$rt" "$usa")" "$como"
    fi
  done
  if [[ -n "$usa_php" ]]; then
    if systemctl is-active --quiet "php${PHP_VER}-fpm" 2>/dev/null; then
      _doc ok php-fpm "$(t "php%s-fpm activo (lo usan: %s)" "$PHP_VER" "$usa_php")"
    else
      _doc error php-fpm "$(t "php%s-fpm parado, y lo necesitan: %s" "$PHP_VER" "$usa_php")" \
        "$(t "arráncalo con:  sudo systemctl start php%s-fpm" "$PHP_VER")" \
        "_fix_service php${PHP_VER}-fpm"
    fi
  fi

  # Una pasada fallida del automático deja la unidad en 'failed', y eso es
  # deliberado: es el aviso de que el autodespliegue no está funcionando, y la
  # pasada siguiente la pone en verde sola. Lo que faltaba es que alguien lo
  # contara. En cuanto hay una unidad en 'failed', 'systemctl is-system-running'
  # pasa a decir «degraded» —lo que mira la monitorización de medio mundo— y el
  # sitio donde uno va a preguntar qué pasa es justo este. Salió en un servidor
  # de verdad, después de romper un build a propósito.
  #
  # Sin acción a propósito: un 'reset-failed' automático borraría la única señal
  # de que los despliegues automáticos están fallando. Apagar la alarma no es
  # apagar el fuego. Quien retira el temporizador sí la limpia, porque entonces
  # ya no hay pasada siguiente que pueda ponerla en verde (ver cmd_autodeploy).
  if systemctl is-failed --quiet orbit-autodeploy.service 2>/dev/null; then
    _doc warn autodeploy "$(t "El autodespliegue falló en su última pasada y la unidad sigue en rojo")" \
      "$(t "mira qué pasó:  journalctl -u orbit-autodeploy -n 30")"
  fi

  # Lo mismo para la cola, y por el mismo motivo: un ciclo fallido deja la
  # unidad en rojo a propósito, el ciclo siguiente la pone en verde sola, y
  # mientras tanto los trabajos se apilan sin dar ningún error — que es
  # exactamente el fallo silencioso contra el que existe 'orbit queue'.
  if systemctl is-failed --quiet orbit-queue.service 2>/dev/null; then
    _doc warn queue "$(t "La cola falló en su último ciclo y la unidad sigue en rojo")" \
      "$(t "mira qué pasó:  journalctl -u orbit-queue -n 30")"
  fi
  # Y el caso contrario: apps que lo tienen puesto y un temporizador parado.
  # Se lee peor que un fallo, porque no hay nada rojo en ninguna parte.
  if [[ -n "$(_queue_enabled_apps)" ]] \
     && ! systemctl is-active --quiet orbit-queue.timer 2>/dev/null; then
    _doc warn queue "$(t "Hay apps con cola pero el temporizador está parado")" \
      "$(t "vuelve a activarlo:  orbit queue enable <app>")"
  fi

  # 'dig' viene de dnsutils, que instala install.sh. Si falta —un servidor donde
  # alguien limpió paquetes, un contenedor— el diagnóstico no puede morirse: con
  # errexit, un 'command not found' dentro de una asignación mataba a doctor a
  # media recogida, y como se imprime al final, no salía **ningún** diagnóstico.
  # Justo la herramienta que se ejecuta cuando algo va mal.
  local hay_dig="yes"; _have_dig || hay_dig="no"
  [[ "$hay_dig" == "no" ]] && _doc warn dns \
    "$(t "Sin 'dig' no puedo comprobar a dónde apuntan tus dominios")" \
    "$(t "instálalo con:  sudo apt-get install -y dnsutils")"

  for n in $(app_names); do
    load_app "$n"
    ip=""
    # El '|| true' no es de adorno: dig también sale distinto de 0 cuando el
    # servidor de nombres no contesta, y eso es un aviso, no el fin del informe.
    [[ "$hay_dig" == "yes" ]] && ip=$(dig +short "$A_DOMAIN" A 2>/dev/null | head -1 || true)
    if [[ "$hay_dig" == "no" ]]; then
      : # ya se ha dicho arriba una sola vez, y no una por app
    elif [[ -z "$ip" ]]; then
      _doc warn "dns:$A_DOMAIN" "$(t "%s no resuelve en DNS" "$A_DOMAIN")"
    else
      _doc ok "dns:$A_DOMAIN" "$(t "%s → %s (con el proxy de Cloudflare verás una IP suya, es normal)" "$A_DOMAIN" "$ip")"
    fi
    days="$(cert_days_left "$A_DOMAIN")"
    if [[ -n "$days" ]]; then
      if (( days < WATCH_CERT_DAYS )); then
        _doc warn "cert:$A_DOMAIN" "$(t "El certificado de %s caduca en %s días" "$A_DOMAIN" "$days")" \
          "$(t "renuévalo con:  orbit ssl %s" "$n")"
      else
        _doc info "cert:$A_DOMAIN" "$(t "Certificado de %s válido %s días más" "$A_DOMAIN" "$days")"
      fi
    fi
  done
}

_doctor_render() {
  local i lvl
  for i in "${!DOC_ID[@]}"; do
    lvl="${DOC_LEVEL[$i]}"
    case "$lvl" in
      ok)    ok   "%s" "${DOC_MSG[$i]}" ;;
      info)  info "%s" "${DOC_MSG[$i]}" ;;
      warn)  warn "%s" "${DOC_MSG[$i]}" ;;
      error) err  "%s" "${DOC_MSG[$i]}" ;;
    esac
    [[ -n "${DOC_FIX[$i]}" ]] && info "  %s" "${DOC_FIX[$i]}"
  done
  return 0
}

_doctor_json() {
  # n_ok y no ok: 'ok' es además el nombre de la función que pinta un acierto y
  # leerlo como contador confunde, aunque bash los guarde en sitios distintos.
  local i sep="" lvl n_ok=0 n_warn=0 n_error=0
  printf '{"schema":%s,"checks":[' "$JSON_SCHEMA"
  for i in "${!DOC_ID[@]}"; do
    lvl="${DOC_LEVEL[$i]}"
    case "$lvl" in ok|info) n_ok=$((n_ok + 1)) ;; warn) n_warn=$((n_warn + 1)) ;; error) n_error=$((n_error + 1)) ;; esac
    # 'fixable' dice si 'doctor --fix' se encargaría de esto. Un cliente lo
    # necesita para poder ofrecer el botón sólo cuando hace algo.
    local fixable="false"
    # ':-' porque quien rellene los arrays a mano puede no traer este campo,
    # y un diagnóstico no puede morirse por un campo opcional que falta.
    [[ -n "${DOC_ACT[$i]:-}" && ( "$lvl" == "warn" || "$lvl" == "error" ) ]] && fixable="true"
    printf '%s{"id":%s,"level":%s,"message":%s,"fix":%s,"fixable":%s}' "$sep" \
      "$(_j_str "${DOC_ID[$i]}")" "$(_j_str "$lvl")" "$(_j_str "${DOC_MSG[$i]}")" \
      "$([[ -n "${DOC_FIX[$i]}" ]] && _j_str "${DOC_FIX[$i]}" || printf 'null')" "$fixable"
    sep=","
  done
  printf '],"summary":{"ok":%s,"warn":%s,"error":%s}}\n' "$n_ok" "$n_warn" "$n_error"
}

# Lo primero que preguntará cualquier cliente antes de fiarse del resto: con
# qué versión habla y qué versión tiene el contrato. Van separadas a propósito,
# porque Orbit puede subir de versión sin que el contrato cambie.
cmd_version() {
  if [[ "$JSON" == "yes" ]]; then
    printf '{"schema":%s,"version":%s,"contract":%s}\n' \
      "$JSON_SCHEMA" "$(_j_str "${ORBIT_VERSION}")" "$JSON_SCHEMA"
    return 0
  fi
  echo "orbit ${ORBIT_VERSION}"
}

# ═══════════════════════════════════════════════════════ idioma ═══════════
cmd_lang() {
  local want="${1:-}"
  if [[ -z "$want" ]]; then
    title "Idioma"
    info "Ahora mismo:  %s%s%s" "${B}" "$ORBIT_LANG_CODE" "${R}"
    info "Orbit habla:  %s" "$ORBIT_LANGS"
    echo
    info "Para siempre en este servidor:  orbit lang <código>"
    info "Sólo para una orden:            orbit --lang <código> <comando>"
    info "Sólo para esta sesión:          export ORBIT_LANG=<código>"
    echo
    info "Sin nada de eso, Orbit usa el idioma del sistema."
    return 0
  fi
  local code; code="$(_lang_norm "$want")"
  _lang_supported "$code" || die "No hablo «%s». Los idiomas de Orbit son: %s." "$want" "$ORBIT_LANGS"
  _conf_set ORBIT_LANG "$code"
  # Se recarga en el acto para que el «hecho» salga ya en el idioma nuevo: un
  # cambio de idioma que se anuncia en el idioma viejo parece que no ha hecho
  # nada.
  ORBIT_LANG_FLAG="$code"; _lang_resolve; _i18n_load
  ok "Orbit hablará en «%s» a partir de ahora." "$code"
}

# Aplica los arreglos que el diagnóstico sabe hacer solo. Espera a que
# _doctor_collect ya haya corrido. Devuelve cuántos ha aplicado por REPLY.
_doctor_fix() {
  local i n=0 fallos=0
  REPLY=0
  for i in "${!DOC_ID[@]}"; do
    [[ -n "${DOC_ACT[$i]}" ]] || continue
    # Un 'ok' con acción no existe hoy, pero si algún día existiera, arreglar
    # lo que no está roto sería lo peor que podría hacer este comando.
    [[ "${DOC_LEVEL[$i]}" == "warn" || "${DOC_LEVEL[$i]}" == "error" ]] || continue
    # errexit fuera del subshell y a mano: dentro de un 'if' bash lo apaga, y
    # entonces un arreglo que falla a mitad diría que ha ido bien.
    local rc=0
    set +e
    ( set -Eeuo pipefail; eval "${DOC_ACT[$i]}" )
    rc=$?
    set -e
    if (( rc == 0 )); then
      ok "Arreglado: %s" "${DOC_MSG[$i]}"; n=$((n + 1))
    else
      err "No he podido arreglar: %s" "${DOC_MSG[$i]}"
      [[ -n "${DOC_FIX[$i]}" ]] && info "  Hazlo a mano: %s" "${DOC_FIX[$i]}"
      fallos=$((fallos + 1))
    fi
  done
  REPLY=$n
  (( fallos == 0 ))
}

cmd_doctor() {
  local fix="no" a
  for a in "$@"; do
    case "$a" in
      --fix) fix="yes" ;;
      # '--yes' se reconoce aquí y en ningún sitio más, a propósito. La guarda
      # de más abajo lo exige para 'doctor --fix --json' —sin terminal no se
      # puede preguntar— y hasta ahora no había forma de dárselo: no es una
      # bandera global (el bucle de 'main' sólo conoce --json, --eva y --lang) y
      # 'ASSUME_YES' sólo se asignaba dentro de 'cmd_new', sobre una copia local.
      # O sea que el camino estaba documentado en USAGE y muerto por las dos
      # ramas.
      #
      # Hacerla global habría sido más corto y es lo que no se hace: hoy hay
      # cuatro comandos que la reconocen cada uno por su cuenta con su propio
      # significado —'new', 'remove', 'restore', 'migrate'— y uno de ellos borra
      # cosas. Cambiarles el comportamiento a los cuatro para arreglar 'doctor'
      # es pagar un riesgo que no hace falta.
      -y|--yes|--si) ASSUME_YES="yes" ;;
      *) die "orbit doctor: no sé qué es «%s». Sólo acepta --fix, --yes y --json." "$a" ;;
    esac
  done

  _doctor_collect

  if [[ "$fix" != "yes" ]]; then
    if [[ "$JSON" == "yes" ]]; then _doctor_json; return 0; fi
    title "Diagnóstico"
    _doctor_render
    echo
    # Sale con 0 aunque encuentre problemas, a propósito: 'orbit doctor' se pega
    # en los issues y en scripts que ya existen, y cambiarle el código de salida
    # rompería a quien lo tenga encadenado con &&. Quien quiera decidir con el
    # resultado tiene el resumen en 'orbit doctor --json'.
    return 0
  fi

  need_root doctor

  # Qué se puede arreglar solo, contado antes de prometer nada.
  local i; local -a puedo=()
  for i in "${!DOC_ID[@]}"; do
    [[ -n "${DOC_ACT[$i]}" ]] || continue
    [[ "${DOC_LEVEL[$i]}" == "warn" || "${DOC_LEVEL[$i]}" == "error" ]] || continue
    puedo+=("$i")
  done

  # Con --json no se puede preguntar: 'confirm' escribe por stdout y ahí sólo
  # va el JSON. Se exige --yes, que es decir que sí de antemano, en vez de
  # decidir por nuestra cuenta que quien automatiza ya lo ha aceptado.
  if [[ "$JSON" == "yes" && "$ASSUME_YES" != "yes" ]]; then
    err "'doctor --fix --json' necesita también --yes: sin terminal no puedo preguntar." >&2
    return 1
  fi

  if (( ${#puedo[@]} == 0 )); then
    if [[ "$JSON" == "yes" ]]; then _doctor_json; return 0; fi
    title "Diagnóstico"
    _doctor_render
    echo
    info "No hay nada que pueda arreglar yo solo."
    # Que no haya arreglo automático no significa que no haya problemas: lo
    # peor que podría hacer aquí es dejar la sensación de que está todo bien.
    local pendientes=0
    for i in "${!DOC_ID[@]}"; do
      [[ "${DOC_LEVEL[$i]}" == "warn" || "${DOC_LEVEL[$i]}" == "error" ]] && pendientes=$((pendientes + 1))
    done
    (( pendientes )) && warn "Quedan %s que necesitan que decidas tú (arriba, con el comando)." "$pendientes"
    return 0
  fi

  if [[ "$JSON" != "yes" ]]; then
    title "Diagnóstico"
    _doctor_render
    echo
    printf "  ${B}%s${R}\n" "$(t "Puedo arreglar %s de estos, y ninguno decide nada por ti:" "${#puedo[@]}")"
    for i in "${puedo[@]}"; do printf "    ${CYA}·${R} %s\n" "${DOC_MSG[$i]}"; done
    echo
    confirm "¿Los aplico?" y || { info "No he tocado nada."; return 0; }
    echo
  fi

  local todo_ok="yes"
  _doctor_fix || todo_ok="no"
  local aplicados="$REPLY"
  logline "doctor --fix aplicados=$aplicados"

  # Se vuelve a diagnosticar: lo que cuenta es cómo queda el servidor, no lo
  # que dijeron los comandos. Un arreglo que devuelve 0 y no arregla nada
  # tiene que verse aquí.
  _doctor_collect
  if [[ "$JSON" == "yes" ]]; then _doctor_json; [[ "$todo_ok" == "yes" ]] || return 1; return 0; fi
  echo
  title "Cómo queda"
  _doctor_render
  echo
  [[ "$todo_ok" == "yes" ]] || return 1
  return 0
}

cmd_firewall() {
  need_root firewall
  _subcmd firewall status noapp "lock unlock status" "$@"
  local sub="$SUBCMD"; set -- "${SUBCMD_ARGS[@]}"
  case "$sub" in
    lock)
      info "Restringiendo 80/443 sólo a las IPs de Cloudflare…"
      ufw delete allow 80/tcp >/dev/null 2>&1 || true
      ufw delete allow 443/tcp >/dev/null 2>&1 || true
      local ip
      for ip in $(curl -fsS https://www.cloudflare.com/ips-v4) $(curl -fsS https://www.cloudflare.com/ips-v6); do
        ufw allow from "$ip" to any port 80,443 proto tcp comment 'Cloudflare' >/dev/null
      done
      ufw reload >/dev/null
      ok "Sólo Cloudflare puede llegar a los puertos web (más seguro)"
      warn "Si algún dominio está en 'DNS only' dejará de funcionar: usa 'orbit firewall unlock'." ;;
    unlock)
      ufw status numbered | grep -i cloudflare | grep -oP '^\[\s*\K[0-9]+' | sort -rn | while read -r i; do
        yes | ufw delete "$i" >/dev/null 2>&1 || true
      done
      ufw allow 80/tcp >/dev/null; ufw allow 443/tcp >/dev/null; ufw reload >/dev/null
      ok "Puertos 80/443 abiertos al mundo" ;;
    status) ufw status verbose | sed 's/^/  /' ;;
  esac
}

cmd_cf_update() {
  need_root cf-update
  local f=/etc/nginx/snippets/orbit-cloudflare.conf
  {
    echo "# Actualizado $(date -Iseconds)"
    curl -fsS https://www.cloudflare.com/ips-v4 | sed 's/^/set_real_ip_from /; s/$/;/'
    curl -fsS https://www.cloudflare.com/ips-v6 | sed 's/^/set_real_ip_from /; s/$/;/'
    echo "real_ip_header CF-Connecting-IP;"
    echo "real_ip_recursive on;"
  } > "$f.new"
  if grep -qc set_real_ip_from "$f.new"; then mv "$f.new" "$f"; nginx -t >/dev/null && systemctl reload nginx; ok "Rangos de Cloudflare actualizados"; else rm -f "$f.new"; err "No pude descargarlos"; fi
}

# El formato de log vive en la configuración base, que escribe el instalador y
# no se regenera junto a los vhosts. Un servidor instalado antes de que llevara
# la marca de tiempo se queda sin poder filtrar por fecha, así que se corrige
# aquí —una línea, con copia y validación— en vez de pedir una reinstalación.
_nginx_base_upgrade() {
  [[ -w "$NGINX_BASE_CONF" ]] || return 0
  grep -q "log_format orbit" "$NGINX_BASE_CONF" || return 0
  grep -q 'log_format orbit .*\$time_local' "$NGINX_BASE_CONF" && return 0
  cp "$NGINX_BASE_CONF" "$NGINX_BASE_CONF.bak"
  sed -i "s|log_format orbit '|log_format orbit '[\$time_local] |" "$NGINX_BASE_CONF"
  if nginx -t >/dev/null 2>&1; then
    rm -f "$NGINX_BASE_CONF.bak"
    ok "Los logs de nginx ya llevan la fecha: 'orbit logs --since' puede filtrarlos"
  else
    mv "$NGINX_BASE_CONF.bak" "$NGINX_BASE_CONF"
    warn "No he podido añadir la fecha al formato de log; lo he dejado como estaba."
  fi
}

cmd_self_update() {
  need_root nginx-rebuild
  _nginx_base_upgrade
  # El servidor por defecto se regenera aquí, y por eso 'orbit nginx-rebuild'
  # es lo que arregla un servidor instalado antes de que existiera el bloque
  # de 443: el fichero se reescribe solo si ha cambiado.
  nginx_default_write && ok "Servidor por defecto actualizado (80 y 443)"
  local n
  for n in $(app_names); do render_nginx "$n" && ok "nginx regenerado: %s" "$n"; done
  nginx -t >/dev/null 2>&1 && systemctl reload nginx 2>/dev/null || true
  return 0
}

# ═══════════════════════════════════════════════════════ menú ═════════════
# Un comando que aborta llama a die(), y die() hace 'exit'. Desde el menú eso
# tira al usuario a la shell en mitad de una sesión: el mensaje de error pasa
# volando, se pierde el sitio, y parece que Orbit se ha caído. El '|| true' que
# había no servía de nada — un 'exit' no lo cazas con eso, hay que contenerlo.
#
# El subshell es lo que lo contiene: el 'exit' se queda dentro, el error ya se
# ha impreso, y aquí sólo hay que esperar a que se lea y volver al menú.
_menu_err() {
  printf "\n  ${RED}%s${R}\n" "$(t "El comando ha terminado con un error.")"
  printf "  ${D}%s${R}\n" "$(t "Nada de lo que estabas haciendo se pierde: vuelves al menú.")"
}

# Pero el subshell **no puede ir a la izquierda de un '||'**. Bash apaga errexit
# dentro de cualquier comando que forme parte de una lista '&&' o '||', y eso lo
# hereda el subshell: volver a hacer 'set -Eeuo pipefail' dentro no lo reactiva
# —comprobado—. Con errexit apagado, un comando que falla a mitad sigue adelante
# y acaba anunciando un éxito que no ha ocurrido: 'orbit github' llegó a decir
# «GitHub conectado» después de que 'gh' fallara dos veces por no estar instalado.
#
# Así que el subshell va suelto, con el errexit del padre apagado a mano
# alrededor —para que su fallo no mate al menú— y encendido a propósito dentro.
# Ojo: esto no se puede envolver en una función auxiliar a la que se llame con
# '||', porque la supresión se hereda también a través de la llamada. El
# subshell tiene que quedar suelto, y por eso las dos formas repiten las cuatro
# líneas en vez de compartirlas.
_menu_run() { # _menu_run <comando> [args…]   — pausa siempre
  local rc=0
  set +e
  ( set -Eeuo pipefail; "$@" )
  rc=$?
  set -e
  (( rc == 0 )) || _menu_err
  pause
}

_menu_live() { # _menu_live <comando> [args…] — a pantalla completa; pausa sólo si falla
  local rc=0
  set +e
  ( set -Eeuo pipefail; "$@" )
  rc=$?
  set -e
  (( rc == 0 )) || { _menu_err; pause; }
}

# Un encabezado de sección: el nombre y una raya que llega hasta el borde.
#
# La raya se calcula con ${#s}, que cuenta caracteres, y no con '%-*s', que
# cuenta bytes: 'GESTIÓN' e 'INFRAESTRUCTURA' llevan acento, y con printf la
# raya de esas dos salía dos columnas más larga que las demás. Es la trampa que
# documenta ARCHITECTURE §10, y aquí se ve a simple vista.
_menu_sec() { # _menu_sec <título>
  local LC_ALL=C.UTF-8
  local t="$1" n pad
  n=$(( UI_WIDTH - ${#t} - 5 ))   # 5 = los dos espacios, el marcador y los dos huecos
  (( n < 0 )) && n=0
  printf -v pad '%*s' "$n" ''
  printf "  ${CYA}%s${R} ${B}%s${R} ${GRY}%s${R}" "$G_SEC" "$t" "${pad// /$G_HR}"
}

