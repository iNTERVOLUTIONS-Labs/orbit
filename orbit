menu() {
  # Sólo la primera vuelta se anima. Volver del comando 15 al menú por décima
  # vez y tener que esperar otra vez al satélite convierte un detalle simpático
  # en un peaje.
  local primera="yes"
  while true; do
    clear
    if [[ "$primera" == "yes" ]]; then banner --anim; primera="no"; else banner; fi
    # El cuerpo del menú va entero por idioma y no frase a frase. Es una
    # pantalla con columnas alineadas a mano: traducida trozo a trozo, cada
    # rótulo cambiaría de largo y la alineación se perdería. Escrita entera,
    # quien traduce la vuelve a alinear y ve el resultado de una vez.
    case "$ORBIT_LANG_CODE" in
      en) _menu_body_en ;;
      *)  _menu_body_es ;;
    esac
    local opt; ask opt "Opción" "0"
    case "$opt" in
      1)  _menu_run cmd_new ;;
      2)  _menu_run cmd_deploy ;;
      3)  _menu_run cmd_rollback ;;
      4)  _menu_run cmd_list ;;
      5)  _menu_live cmd_logs ;;
      6)  _menu_run cmd_service restart ;;
      7)  _menu_run cmd_env ;;
      8)  _menu_run cmd_domain ;;
      9)  _menu_run cmd_remove ;;
      10) _menu_run cmd_ssl ;;
      11) _menu_run cmd_db list ;;
      12) _menu_run cmd_github ;;
      13) _menu_run cmd_cf_token ;;
      14) _menu_run cmd_status ;;
      # Con --fix: enseña el diagnóstico igual y, si hay algo que sepa
      # arreglar solo, lo ofrece. Si no hay nada, se comporta como antes.
      15) _menu_run cmd_doctor --fix ;;
      16) _menu_run cmd_firewall status ;;
      17) _menu_live cmd_top ;;
      18) _menu_run cmd_backup ;;
      19) _menu_run cmd_deploy --pick ;;
      0|q|salir) clear; exit 0 ;;
      *) ;;
    esac
  done
}

